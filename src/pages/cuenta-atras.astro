---
// Solo la cuenta atrás del Drop 001. Cuando llega la hora de apertura,
// la página se convierte sola en la preventa (/preventa).
// Prueba: /cuenta-atras?t=15  → cuenta atrás de 15 segundos (sin redirigir de verdad con ?t, para ver la animación final)
import Layout from '../layouts/Layout.astro';
import { PRESALE } from '../data/isolation-drop';
---

<Layout
  title="ISO - Drop 001 - Isolation"
  description="Unidades limitadas. 14 de diciembre. Envío gratis en Santander."
>
  <script is:inline define:vars={{ open: PRESALE.open }}>
    // Si ya ha abierto, directo a la preventa (antes de pintar nada)
    if (!/[?&]t=/.test(location.search) && Date.now() >= Date.parse(open)) location.replace('/preventa' + location.search);
  </script>

  <main class="ca" data-open={PRESALE.open}>
    <div class="ca-bg" aria-hidden="true">
      <div class="ca-glow"></div>
      <svg class="ca-ball" viewBox="0 0 200 200">
        <circle cx="100" cy="100" r="96" />
        <path d="M100 4 V196 M4 100 H196" />
        <path d="M30 30 Q100 100 30 170" />
        <path d="M170 30 Q100 100 170 170" />
      </svg>
      <svg class="ca-court" viewBox="0 0 1000 600" preserveAspectRatio="xMidYMid slice">
        <path pathLength="1" d="M500 0 V600" />
        <circle pathLength="1" cx="500" cy="300" r="90" />
        <circle pathLength="1" cx="500" cy="300" r="22" />
        <path pathLength="1" d="M0 120 H170 V480 H0" />
        <path pathLength="1" d="M1000 120 H830 V480 H1000" />
        <path pathLength="1" d="M0 30 H60 A270 270 0 0 1 60 570 H0" />
        <path pathLength="1" d="M1000 30 H940 A270 270 0 0 0 940 570 H1000" />
      </svg>
      <div class="ca-grain"></div>
      <div class="ca-vignette"></div>
    </div>

    <a href="/" class="ca-logo" aria-label="ISO"><img src="/logo-white-nav.png" alt="ISO" width="150" height="36" /></a>

    <section class="ca-center">
      <p class="ca-kicker"><span class="ca-dot"></span>Drop 001 · Isolation</p>

      <div class="ca-clock" role="timer" aria-live="off">
        <div class="ca-unit" style="--i:0"><div class="ca-digits" data-u="d"></div><small>Días</small></div>
        <i class="ca-sep" aria-hidden="true">:</i>
        <div class="ca-unit" style="--i:1"><div class="ca-digits" data-u="h"></div><small>Horas</small></div>
        <i class="ca-sep" aria-hidden="true">:</i>
        <div class="ca-unit" style="--i:2"><div class="ca-digits" data-u="m"></div><small>Min</small></div>
        <i class="ca-sep" aria-hidden="true">:</i>
        <div class="ca-unit ca-sec" style="--i:3"><div class="ca-digits" data-u="s"></div><small>Seg</small></div>
      </div>

      <p class="ca-date">14.12 · 00:00</p>
    </section>

    <div class="ca-tick" aria-hidden="true"><span></span></div>
    <div class="ca-flash" aria-hidden="true"></div>
  </main>
</Layout>

<style is:global>
  .ca {
    position: relative; min-height: 100vh; min-height: 100dvh; overflow: hidden;
    display: grid; place-items: center; padding: 5rem var(--pad) 4rem;
    background: #050505; color: var(--white); isolation: isolate;
  }

  /* ---------- Fondo ---------- */
  .ca-bg { position: absolute; inset: 0; z-index: -1; pointer-events: none; }
  .ca-glow {
    position: absolute; left: 50%; top: 50%; width: 120vmax; height: 120vmax; translate: -50% -50%;
    background: radial-gradient(circle, rgba(126, 200, 227, 0.22) 0%, rgba(126, 200, 227, 0.06) 28%, transparent 55%);
    animation: ca-breathe 4s ease-in-out infinite;
  }
  .ca.beat .ca-glow { animation: ca-beat 1s ease-out, ca-breathe 4s ease-in-out infinite; }
  .ca-ball {
    position: absolute; left: 50%; top: 50%; width: min(92vmin, 760px); translate: -50% -50%;
    fill: none; stroke: rgba(126, 200, 227, 0.09); stroke-width: 1.2;
    animation: ca-spin 60s linear infinite;
  }
  .ca-court {
    position: absolute; inset: 0; width: 100%; height: 100%;
    fill: none; stroke: rgba(242, 237, 229, 0.08); stroke-width: 1.5;
  }
  .ca-court > * { stroke-dasharray: 1; stroke-dashoffset: 1; animation: ca-draw 2.6s cubic-bezier(0.6, 0, 0.2, 1) forwards; }
  .ca-court > :nth-child(2) { animation-delay: 0.2s; } .ca-court > :nth-child(3) { animation-delay: 0.35s; }
  .ca-court > :nth-child(4), .ca-court > :nth-child(5) { animation-delay: 0.5s; }
  .ca-court > :nth-child(6), .ca-court > :nth-child(7) { animation-delay: 0.75s; }
  .ca-grain {
    position: absolute; inset: -50%; opacity: 0.07; animation: ca-grain 0.9s steps(4) infinite;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
  }
  .ca-vignette { position: absolute; inset: 0; background: radial-gradient(ellipse at center, transparent 40%, rgba(0, 0, 0, 0.75) 100%); }

  /* ---------- Logo y textos ---------- */
  .ca-logo { position: absolute; top: clamp(1.4rem, 4vw, 2.4rem); left: 50%; translate: -50% 0; opacity: 0; animation: ca-in 0.8s 0.2s ease forwards; }
  .ca-logo img { display: block; width: clamp(96px, 12vw, 150px); height: auto; }
  .ca-center { display: grid; justify-items: center; text-align: center; }
  .ca-kicker {
    display: flex; align-items: center; gap: 0.6rem; margin-bottom: clamp(1rem, 3vw, 2rem);
    font-family: var(--font-display); font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.32em; font-size: clamp(0.75rem, 1.6vw, 1rem); color: var(--accent);
    opacity: 0; animation: ca-in 0.8s 0.5s ease forwards;
  }
  .ca-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 12px var(--accent); animation: ca-blink 1s steps(2) infinite; }
  .ca-date {
    margin-top: clamp(1.4rem, 4vw, 2.6rem);
    font-family: var(--font-display); font-weight: 900; font-style: italic; text-transform: uppercase;
    font-size: clamp(1.1rem, 2.6vw, 1.7rem); letter-spacing: 0.18em; color: transparent;
    -webkit-text-stroke: 1px rgba(242, 237, 229, 0.55);
    opacity: 0; animation: ca-in 0.8s 1.4s ease forwards;
  }

  /* ---------- Reloj ---------- */
  .ca-clock { display: flex; align-items: flex-start; gap: clamp(0.3rem, 1.4vw, 1.2rem); }
  .ca-unit {
    display: grid; justify-items: center; gap: 0.6rem;
    opacity: 0; translate: 0 40px; filter: blur(12px);
    animation: ca-unit 1s calc(0.7s + var(--i) * 0.12s) cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  .ca-unit small {
    font-family: var(--font-body); font-weight: 600; font-size: clamp(0.6rem, 1.3vw, 0.8rem);
    letter-spacing: 0.3em; text-transform: uppercase; color: var(--muted-light);
  }
  .ca-digits { display: flex; }
  .ca-slot {
    position: relative; display: block; line-height: 1;
    /* corta por arriba y por abajo (para la animación) pero deja respirar la cursiva por los lados */
    clip-path: inset(0 -40% 0 -40%);
    font-family: var(--font-display); font-weight: 900; font-style: italic; font-variant-numeric: tabular-nums;
    font-size: clamp(3.6rem, 15vw, 11.5rem); letter-spacing: -0.01em;
  }
  .ca-slot i { visibility: hidden; font-style: inherit; } /* da el ancho del número con la fuente real */
  .ca-slot b { position: absolute; inset: 0; display: grid; place-items: center; font-weight: inherit; }
  .ca-slot b.in { animation: ca-digit-in 0.55s cubic-bezier(0.2, 1.3, 0.4, 1) both; }
  .ca-slot b.out { animation: ca-digit-out 0.45s cubic-bezier(0.6, 0, 0.8, 0.4) both; }
  .ca-sec .ca-slot { color: var(--accent); }
  .ca-sec .ca-digits { filter: drop-shadow(0 0 28px rgba(126, 200, 227, 0.4)); }
  .ca-sep {
    font-style: normal; font-family: var(--font-display); font-weight: 900;
    font-size: clamp(2.6rem, 10vw, 8rem); line-height: 1.1; color: rgba(242, 237, 229, 0.25);
    animation: ca-blink 1s steps(2) infinite;
  }

  /* Barra que se llena cada segundo */
  .ca-tick { position: absolute; left: 0; right: 0; bottom: 0; height: 3px; background: rgba(126, 200, 227, 0.1); }
  .ca-tick span { display: block; height: 100%; width: 100%; background: var(--accent); transform-origin: left; transform: scaleX(0); box-shadow: 0 0 14px var(--accent); }
  .ca.beat .ca-tick span { animation: ca-fill 1s linear; }

  /* Último minuto: todo más tenso */
  .ca.final .ca-sec .ca-slot { color: #fff; }
  .ca.final .ca-sec .ca-digits { filter: drop-shadow(0 0 18px var(--accent)) drop-shadow(0 0 50px var(--accent)); }
  .ca.final .ca-glow { background: radial-gradient(circle, rgba(126, 200, 227, 0.4) 0%, rgba(126, 200, 227, 0.1) 30%, transparent 58%); }
  .ca.final.beat .ca-clock { animation: ca-shake 0.35s ease; }

  /* Hora cero */
  .ca-flash { position: absolute; inset: 0; background: #fff; opacity: 0; pointer-events: none; z-index: 5; }
  .ca.go .ca-flash { animation: ca-flash 1.2s ease forwards; }
  .ca.go .ca-clock { animation: ca-zoom 1.2s cubic-bezier(0.7, 0, 0.84, 0) forwards; }

  @keyframes ca-in { from { opacity: 0; translate: 0 12px; } to { opacity: 1; translate: 0 0; } }
  @keyframes ca-unit { to { opacity: 1; translate: 0 0; filter: blur(0); } }
  @keyframes ca-digit-in { from { transform: translateY(70%) scale(0.9); opacity: 0; filter: blur(6px); } to { transform: none; opacity: 1; filter: blur(0); } }
  @keyframes ca-digit-out { to { transform: translateY(-80%) scale(0.95); opacity: 0; filter: blur(6px); } }
  @keyframes ca-draw { to { stroke-dashoffset: 0; } }
  @keyframes ca-spin { to { rotate: 360deg; } }
  @keyframes ca-breathe { 0%, 100% { scale: 1; opacity: 0.85; } 50% { scale: 1.08; opacity: 1; } }
  @keyframes ca-beat { 0% { filter: brightness(1.6); } 100% { filter: brightness(1); } }
  @keyframes ca-blink { 50% { opacity: 0.25; } }
  @keyframes ca-grain { 0% { translate: 0 0; } 25% { translate: -4% 3%; } 50% { translate: 3% -5%; } 75% { translate: -2% 4%; } }
  @keyframes ca-fill { from { transform: scaleX(0); } to { transform: scaleX(1); } }
  @keyframes ca-shake { 25% { translate: -4px 0; } 50% { translate: 4px 0; } 75% { translate: -2px 0; } }
  @keyframes ca-flash { 0% { opacity: 0; } 35% { opacity: 1; } 100% { opacity: 1; } }
  @keyframes ca-zoom { to { scale: 2.4; opacity: 0; filter: blur(10px); } }

  @media (max-width: 560px) {
    .ca-clock { gap: 0.15rem; }
    .ca-slot { font-size: clamp(2.8rem, 15vw, 4.4rem); }
    .ca-sep { font-size: clamp(1.8rem, 9vw, 3rem); }
    .ca-unit small { letter-spacing: 0.18em; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ca *, .ca *::before { animation-duration: 0.01ms !important; animation-iteration-count: 1 !important; }
    .ca-unit, .ca-logo, .ca-kicker, .ca-date { opacity: 1; translate: none; filter: none; }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('.ca')!;
  const qs = new URLSearchParams(location.search);
  const test = Number(qs.get('t'));
  const target = test > 0 ? Date.now() + test * 1000 : Date.parse(root.dataset.open!);
  const units = { d: '', h: '', m: '', s: '' } as Record<string, string>;
  const boxes = Object.fromEntries(['d', 'h', 'm', 's'].map((u) => [u, root.querySelector<HTMLElement>(`[data-u="${u}"]`)!]));

  // Cada número son dos cajitas; al cambiar, el viejo sale hacia arriba y el nuevo entra desde abajo
  function setUnit(u: string, value: string, animate: boolean) {
    const box = boxes[u];
    if (units[u] === value) return;
    if (box.children.length !== value.length) {
      box.innerHTML = value.split('').map((c) => `<span class="ca-slot"><i aria-hidden="true">0</i><b>${c}</b></span>`).join('');
      units[u] = value;
      return;
    }
    value.split('').forEach((c, i) => {
      if (units[u][i] === c) return;
      const slot = box.children[i] as HTMLElement;
      const old = slot.querySelector('b:not(.out)');
      if (old && animate) { old.classList.add('out'); setTimeout(() => old.remove(), 460); } else old?.remove();
      const b = document.createElement('b');
      b.textContent = c;
      if (animate) b.className = 'in';
      slot.appendChild(b);
    });
    units[u] = value;
  }

  const pad = (n: number) => String(n).padStart(2, '0');
  let done = false;
  function tick(first = false) {
    const left = Math.max(0, target - Date.now());
    const s = Math.floor(left / 1000);
    setUnit('d', pad(Math.floor(s / 86400)), !first);
    setUnit('h', pad(Math.floor(s / 3600) % 24), !first);
    setUnit('m', pad(Math.floor(s / 60) % 60), !first);
    setUnit('s', pad(s % 60), !first);
    root.classList.toggle('final', s < 60);
    root.classList.remove('beat'); void root.offsetWidth; root.classList.add('beat');
    if (left <= 0 && !done) {
      done = true;
      root.classList.add('go');
      // Hora cero: se convierte en la preventa
      setTimeout(() => { if (!(test > 0)) location.replace('/preventa'); }, 1100);
    }
  }
  tick(true);
  // Sincronizado con el cambio de segundo
  setTimeout(() => { tick(); setInterval(tick, 1000); }, (target - Date.now()) % 1000 + 5);
</script>
