---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { ISOLATION_DROP, PRESALE } from '../data/isolation-drop';
import { existsSync } from 'node:fs';
import PresaleReact from '../components/PresaleReact.tsx';

const hasPhoto = (url: string) => existsSync(`public${url}`);

// Orden y número de cada pieza
const NUM: Record<string, string> = {
  'isolation-isolate-yourself': '01',
  'isolation-drip-hoodie': '02',
  'isolation-out-of-my-way': '03',
  'isolation-if-you-miss-her': '04',
};
const items = [...ISOLATION_DROP]
  .sort((a, b) => (NUM[a.id] ?? '9').localeCompare(NUM[b.id] ?? '9'))
  .map((p) => ({
    id: p.id,
    num: NUM[p.id] ?? '',
    name: p.name,
    category: p.category.replace(' · Isolation drop', ''),
    price_cents: p.price_cents,
    sizes: p.sizes,
    description: p.description,
    front: hasPhoto(p.image_url) ? p.image_url : null,
    back: p.image_back_url && hasPhoto(p.image_back_url) ? p.image_back_url : null,
    cover: (p.id === 'isolation-if-you-miss-her' ? 'front' : 'back') as 'front' | 'back',
  }));
const ticker = ['Call for an ISO', 'Out of my waaay', 'Isolate yourself', 'If you miss her', 'Drop 001', 'Clear the side'];
---

<Layout
  title="ISO — Preventa Isolation · Drop 001"
  description="Isolation, el Drop 001 de ISO: 3 camisetas y una sudadera. Preventa de una semana desde el 13 de diciembre o hasta agotar existencias. Envío gratis en Santander."
>
  <Navbar />
  <main class="pv" data-open={PRESALE.open} data-close={PRESALE.close}>
    <!-- ============ HERO ============ -->
    <section class="pv-hero">
      <!-- Media pista: capa tenue + capa iluminada por el cursor (como en la home) -->
      <div class="pv-court" aria-hidden="true">
        {[0, 1].map((layer) => (
          <svg class={`pvc ${layer ? "pvc-lit" : "pvc-base"}`} viewBox="0 0 1500 1410" preserveAspectRatio="xMidYMid slice">
            <g fill="none" stroke-width={layer ? 3 : 2}>
              <path pathLength="1" d="M0 1400 H1500" />
              <path pathLength="1" d="M570 1400 V820 H930 V1400" />
              <path pathLength="1" d="M630 1400 V820 M870 1400 V820" />
              <path pathLength="1" d="M570 820 A180 180 0 0 1 930 820" />
              <path class="dash" d="M570 820 A180 180 0 0 0 930 820" stroke-dasharray="14 14" />
              <path pathLength="1" d="M90 1400 V1120 A660 660 0 0 1 1410 1120 V1400" />
              <path pathLength="1" d="M690 1250 A60 60 0 0 1 810 1250" />
              <path pathLength="1" d="M0 0 H1500" />
              <path pathLength="1" d="M570 0 A180 180 0 0 0 930 0" />
            </g>
          </svg>
        ))}
      </div>
      <div class="pv-grain" aria-hidden="true"></div>

      <div class="pv-hero-inner">
        <p class="pv-eyebrow"><span class="pv-dot" aria-hidden="true"></span>Drop 001 · Preventa</p>
        <h1 class="pv-title">
          <span class="pv-outline">Iso</span><span class="pv-fill">lation.</span>
        </h1>
        <p class="pv-def">
          <b>iso</b> <i>/ˈaɪ.soʊ/</i> <em>abrev. de isolation</em> — jugada en la que el equipo despeja un lado
          de la pista para que un jugador ataque a su defensor <strong>uno contra uno</strong>.
        </p>

        <div class="pv-clock" data-clock>
          <p class="pv-clock-label" data-clock-label>La preventa abre en</p>
          <div class="pv-clock-nums">
            <span><b data-d>--</b>días</span>
            <span><b data-h>--</b>horas</span>
            <span><b data-m>--</b>min</span>
            <span><b data-s>--</b>seg</span>
          </div>
        </div>

        <ul class="pv-facts">
          <li><b>1 semana</b><span>Solo {PRESALE.unitsPerItem} unidades de cada modelo</span></li>
          <li><b>Envío gratis</b><span>En Santander</span></li>
        </ul>
      </div>
    </section>

    <!-- ============ CINTA ============ -->
    <div class="pv-ticker" aria-hidden="true">
      <div class="pv-ticker-track">
        {[0, 1].map(() => (
          <span class="pv-ticker-set">
            {ticker.map((t) => (<><span>{t}</span><img src="/hero/iso-ball.webp" alt="" width="632" height="369" /></>))}
          </span>
        ))}
      </div>
    </div>

    <!-- ============ LAS PIEZAS ============ -->
    <section class="pv-list" aria-label="Prendas del drop">
      <PresaleReact client:load items={items} opensAt={PRESALE.open} closesAt={PRESALE.close} bizumPhone={PRESALE.bizumPhone} shippingCents={PRESALE.shippingCents} unitsPerItem={PRESALE.unitsPerItem} />
    </section>

    <!-- ============ LA JUGADA ============ -->
    <section class="pv-play" data-reveal>
      <figure class="pv-board" aria-label="Pizarra: jugada de aislamiento">
        <svg viewBox="-10 -10 520 330" role="img" aria-labelledby="pv-board-t" data-play>
          <title id="pv-board-t">Jugada de aislamiento: el 3 y el 5 se abren al lado débil y el 1 ataca el aro</title>
          <defs>
            <marker id="pv-arr" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
              <path d="M0 0 L10 5 L0 10 z" fill="currentColor" />
            </marker>
            <marker id="pv-arr-b" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse">
              <path d="M0 0 L10 5 L0 10 z" fill="#7ec8e3" />
            </marker>
            <radialGradient id="pv-spot">
              <stop offset="0" stop-color="#7ec8e3" stop-opacity="0.35" />
              <stop offset="1" stop-color="#7ec8e3" stop-opacity="0" />
            </radialGradient>
            <filter id="pv-glow" x="-50%" y="-50%" width="200%" height="200%">
              <feGaussianBlur stdDeviation="3" result="b" />
              <feMerge><feMergeNode in="b" /><feMergeNode in="SourceGraphic" /></feMerge>
            </filter>
          </defs>

          <!-- pista -->
          <g class="pv-lines" fill="none" stroke="currentColor" stroke-width="1.5">
            <path pathLength="1" d="M0 0 H500" />
            <path pathLength="1" d="M220 40 H280" />
            <path pathLength="1" d="M170 0 V190 H330 V0" />
            <path pathLength="1" d="M190 190 A60 60 0 0 0 310 190" />
            <path pathLength="1" d="M30 0 V141.5 A237.5 237.5 0 0 0 470 141.5 V0" />
          </g>
          <circle class="pv-rim" cx="250" cy="52" r="9" fill="none" stroke="currentColor" stroke-width="1.5" />

          <!-- rastros de la jugada -->
          <g fill="none" stroke-linecap="round">
            <path class="pv-trail" data-trail="5" marker-end="url(#pv-arr)" stroke="currentColor" stroke-width="2" d="M300 170 C255 192 205 182 170 158" />
            <path class="pv-trail" data-trail="3" marker-end="url(#pv-arr)" stroke="currentColor" stroke-width="2" d="M452 40 C360 16 190 16 100 90" />
            <path class="pv-trail" data-trail="2" marker-end="url(#pv-arr)" stroke="currentColor" stroke-width="2" d="M85 250 C75 232 68 215 64 196" />
            <path class="pv-trail drive" data-trail="1" marker-end="url(#pv-arr-b)" stroke="#7ec8e3" stroke-width="3" stroke-linejoin="round"
              d="M410 268 L394 250 L412 238 L396 222 L414 210 L398 194 C370 160 330 122 302 106" />
            <path class="pv-trail shot" data-trail="shot" marker-end="url(#pv-arr-b)" stroke="#7ec8e3" stroke-width="1.6" stroke-dasharray="3 6" d="M302 106 Q 285 30 250 52" />
          </g>

          <!-- jugadores -->
          <g class="pv-o" font-family="var(--font-display)" font-weight="900" font-style="italic" font-size="22" text-anchor="middle">
            <g class="p" data-p="2" transform="translate(85 250)"><circle r="15" /><text y="8">2</text></g>
            <g class="p" data-p="3" transform="translate(452 40)"><circle r="15" /><text y="8">3</text></g>
            <g class="p" data-p="4" transform="translate(45 55)"><circle r="15" /><text y="8">4</text></g>
            <g class="p" data-p="5" transform="translate(300 170)"><circle r="15" /><text y="8">5</text></g>
            <g class="p one" data-p="1" transform="translate(410 268)"><circle r="15" /><text y="8">1</text></g>
          </g>
        </svg>
        <figcaption><span>Isolation</span> 4 se abren al lado débil · el 1 se la juega</figcaption>
      </figure>
    </section>

    <!-- ============ CIERRE ============ -->
    <section class="pv-end">
      <span class="pv-logo" aria-hidden="true">
        <img class="pv-letters" src="/hero/iso-letters.webp" alt="" width="1600" height="369" loading="lazy" />
        <img class="pv-ball" src="/hero/iso-ball.webp" alt="" width="632" height="369" loading="lazy" />
      </span>
      <p class="pv-end-sub">Preventa de 1 semana · Diseñado en Santander</p>
      <a href="/" class="pv-back">← Volver a ISO</a>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  const root = document.querySelector<HTMLElement>('.pv');
  if (root) {
    // ?demo → se ve como si la preventa estuviera abierta (una semana desde ahora)
    const demo = new URLSearchParams(location.search).has('demo');
    const open = demo ? Date.now() - 1000 : Date.parse(root.dataset.open || '');
    const close = demo ? open + 7 * 86400000 : Date.parse(root.dataset.close || '');
    const clock = root.querySelector<HTMLElement>('[data-clock]');
    const label = root.querySelector<HTMLElement>('[data-clock-label]');
    const q = (k: string) => root.querySelector<HTMLElement>(`[data-${k}]`);
    const D = q('d'), H = q('h'), M = q('m'), S = q('s');
    const pad = (n: number) => String(n).padStart(2, '0');
    const tick = () => {
      if (!clock || !label) return;
      const now = Date.now();
      let target = open;
      if (now >= open && now < close) {
        target = close;
        label.textContent = 'Preventa abierta · cierra en';
        clock.classList.add('is-open');
      } else if (now >= close) {
        label.textContent = 'La preventa ha terminado';
        clock.querySelector('.pv-clock-nums')?.remove();
        return;
      }
      const t = Math.max(0, Math.floor((target - now) / 1000));
      if (D) D.textContent = pad(Math.floor(t / 86400));
      if (H) H.textContent = pad(Math.floor((t % 86400) / 3600));
      if (M) M.textContent = pad(Math.floor((t % 3600) / 60));
      if (S) S.textContent = pad(t % 60);
    };
    tick();
    setInterval(tick, 1000);

    // Aparecen al entrar en pantalla (la pizarra se dibuja)
    const els = root.querySelectorAll<HTMLElement>('[data-reveal]');
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add('is-in');
            io.unobserve(e.target);
          }
        });
      }, { threshold: 0.25 });
      els.forEach((el) => io.observe(el));
    } else {
      els.forEach((el) => el.classList.add('is-in'));
    }
  }
</script>




<script>
  // Foco sobre la pista del título (cursor en ordenador, dedo / recorrido automático en móvil)
  import { courtLight } from '../lib/courtLight';
  const hero = document.querySelector<HTMLElement>('.pv-hero');
  if (hero) courtLight(hero);
</script>

<style>
