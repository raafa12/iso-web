  .pvc path:nth-child(3n) { animation-delay: 0.3s; }
  .pvc-base g { stroke: var(--white); opacity: 0.07; }
  .pvc-lit g { stroke: var(--accent); }
  .pvc-lit {
    opacity: 0;
    transition: opacity 0.4s;
    -webkit-mask-image: radial-gradient(circle 280px at var(--mx) var(--my), #000 0%, transparent 70%);
