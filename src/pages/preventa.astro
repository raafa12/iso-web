  .pv-court { position: absolute; inset: 0; z-index: -2; pointer-events: none; }
  .pvc { position: absolute; inset: 0; width: 100%; height: 100%; }
  .pvc path { stroke-dasharray: 1 1; stroke-dashoffset: 1; animation: pv-draw 2.4s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
  .pvc path.dash { stroke-dasharray: 14 14; stroke-dashoffset: 0; animation: pv-fadein 1s 1.2s both; }
