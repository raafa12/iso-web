---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { ISOLATION_DROP, PRESALE } from '../data/isolation-drop';
import { existsSync } from 'node:fs';
import PresaleReact from '../components/PresaleReact.tsx';

const hasPhoto = (url: string) => existsSync(`public${url}`);

// Orden y número de cada pieza
const NUM: Record<string, string> = {
  'isolation-isolate-yourself': '01',
  'isolation-drip-hoodie': '02',
  'isolation-out-of-my-way': '03',
  'isolation-if-you-miss-her': '04',
};
const items = [...ISOLATION_DROP]
  .sort((a, b) => (NUM[a.id] ?? '9').localeCompare(NUM[b.id] ?? '9'))
  .map((p) => ({
    id: p.id,
    num: NUM[p.id] ?? '',
    name: p.name,
    category: p.category.replace(' · Isolation drop', ''),
    price_cents: p.price_cents,
    sizes: p.sizes,
    description: p.description,
    front: hasPhoto(p.image_url) ? p.image_url : null,
    back: p.image_back_url && hasPhoto(p.image_back_url) ? p.image_back_url : null,
    cover: (p.id === 'isolation-if-you-miss-her' ? 'front' : 'back') as 'front' | 'back',
  }));
const ticker = ['Call for an ISO', 'Out of my waaay', 'Isolate yourself', 'If you miss her', 'Drop 001', 'Clear the side'];
---

<Layout
  title="ISO — Preventa Isolation · Drop 001"
  description="Isolation, el Drop 001 de ISO: 3 camisetas y una sudadera. Preventa de una semana desde el 13 de diciembre o hasta agotar existencias. Envío gratis en Santander."
>
  <Navbar />
  <main class="pv" data-open={PRESALE.open} data-close={PRESALE.close}>
    <!-- ============ HERO ============ -->
    <section class="pv-hero">
      <!-- Media pista: capa tenue + capa iluminada por el cursor (como en la home) -->
      <div class="pv-court" aria-hidden="true">
        {[0, 1].map((layer) => (
          <svg class={`pvc ${layer ? "pvc-lit" : "pvc-base"}`} viewBox="0 0 1500 1410" preserveAspectRatio="xMidYMid slice">
            <g fill="none" stroke-width={layer ? 3 : 2}>
              <path pathLength="1" d="M0 1400 H1500" />
              <path pathLength="1" d="M570 1400 V820 H930 V1400" />
              <path pathLength="1" d="M630 1400 V820 M870 1400 V820" />
              <path pathLength="1" d="M570 820 A180 180 0 0 1 930 820" />
              <path class="dash" d="M570 820 A180 180 0 0 0 930 820" stroke-dasharray="14 14" />
              <path pathLength="1" d="M90 1400 V1120 A660 660 0 0 1 1410 1120 V1400" />
              <path pathLength="1" d="M690 1250 A60 60 0 0 1 810 1250" />
              <path pathLength="1" d="M0 0 H1500" />
              <path pathLength="1" d="M570 0 A180 180 0 0 0 930 0" />
            </g>
          </svg>
        ))}
      </div>
      <div class="pv-grain" aria-hidden="true"></div>

      <div class="pv-hero-inner">
        <p class="pv-eyebrow"><span class="pv-dot" aria-hidden="true"></span>Drop 001 · Preventa</p>
        <h1 class="pv-title">
          <span class="pv-outline">Iso</span><span class="pv-fill">lation.</span>
        </h1>
        <p class="pv-def">
          <b>iso</b> <i>/ˈaɪ.soʊ/</i> <em>abrev. de isolation</em> — jugada en la que el equipo despeja un lado
          de la pista para que un jugador ataque a su defensor <strong>uno contra uno</strong>.
        </p>

        <div class="pv-clock" data-clock>
          <p class="pv-clock-label" data-clock-label>La preventa abre en</p>
          <div class="pv-clock-nums">
            <span><b data-d>--</b>días</span>
            <span><b data-h>--</b>horas</span>
            <span><b data-m>--</b>min</span>
            <span><b data-s>--</b>seg</span>
          </div>
        </div>

        <ul class="pv-facts">
          <li><b>1 semana</b><span>O hasta agotar existencias</span></li>
          <li><b>Envío gratis</b><span>En Santander</span></li>
          <li><b>S · M · L · XL</b><span>Corte oversize</span></li>
        </ul>
      </div>
    </section>

    <!-- ============ CINTA ============ -->
    <div class="pv-ticker" aria-hidden="true">
      <div class="pv-ticker-track">
        {[0, 1].map(() => (
          <span class="pv-ticker-set">
            {ticker.map((t) => (<><span>{t}</span><img src="/hero/iso-ball.webp" alt="" width="632" height="369" /></>))}
          </span>
        ))}
      </div>
    </div>

    <!-- ============ LAS PIEZAS ============ -->
    <section class="pv-list" aria-label="Prendas del drop">
      <PresaleReact client:load items={items} opensAt={PRESALE.open} closesAt={PRESALE.close} />
    </section>

    <!-- ============ LA JUGADA ============ -->
    <section class="pv-play" data-reveal>
      <figure class="pv-board" aria-label="Pizarra: jugada de aislamiento">
        <svg viewBox="-10 -10 520 330" role="img" aria-labelledby="pv-board-t" data-play>
          <title id="pv-board-t">Jugada de aislamiento: el 3 y el 5 se abren al lado débil y el 1 ataca el aro</title>
          <defs>
            <marker id="pv-arr" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
              <path d="M0 0 L10 5 L0 10 z" fill="currentColor" />
            </marker>
            <marker id="pv-arr-b" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse">
              <path d="M0 0 L10 5 L0 10 z" fill="#7ec8e3" />
            </marker>
            <radialGradient id="pv-spot">
              <stop offset="0" stop-color="#7ec8e3" stop-opacity="0.35" />
              <stop offset="1" stop-color="#7ec8e3" stop-opacity="0" />
            </radialGradient>
            <filter id="pv-glow" x="-50%" y="-50%" width="200%" height="200%">
              <feGaussianBlur stdDeviation="3" result="b" />
              <feMerge><feMergeNode in="b" /><feMergeNode in="SourceGraphic" /></feMerge>
            </filter>
          </defs>

          <!-- pista -->
          <g class="pv-lines" fill="none" stroke="currentColor" stroke-width="1.5">
            <path pathLength="1" d="M0 0 H500" />
            <path pathLength="1" d="M220 40 H280" />
            <path pathLength="1" d="M170 0 V190 H330 V0" />
            <path pathLength="1" d="M190 190 A60 60 0 0 0 310 190" />
            <path pathLength="1" d="M30 0 V141.5 A237.5 237.5 0 0 0 470 141.5 V0" />
          </g>
          <circle class="pv-rim" cx="250" cy="52" r="9" fill="none" stroke="currentColor" stroke-width="1.5" />

          <!-- foco que sigue al 1 -->
          <circle class="pv-spot" data-spot r="70" fill="url(#pv-spot)" cx="410" cy="268" />

          <!-- rastros de la jugada -->
          <g fill="none" stroke-linecap="round">
            <path class="pv-trail" data-trail="5" stroke="currentColor" stroke-width="2" d="M300 170 C255 192 205 182 170 158" />
            <path class="pv-trail" data-trail="3" stroke="currentColor" stroke-width="2" d="M452 40 C360 16 190 16 100 90" />
            <path class="pv-trail" data-trail="2" stroke="currentColor" stroke-width="2" d="M85 250 C75 232 68 215 64 196" />
            <path class="pv-trail drive" data-trail="1" stroke="#7ec8e3" stroke-width="3" stroke-linejoin="round"
              d="M410 268 L394 250 L412 238 L396 222 L414 210 L398 194 C370 160 330 122 302 106" />
            <path class="pv-trail shot" data-trail="shot" stroke="#7ec8e3" stroke-width="1.6" stroke-dasharray="3 6" d="M302 106 Q 285 30 250 52" />
          </g>

          <!-- aro: destello al anotar -->
          <circle class="pv-flash" data-flash cx="250" cy="52" r="9" fill="none" stroke="#7ec8e3" stroke-width="3" />

          <!-- jugadores -->
          <g class="pv-o" font-family="var(--font-display)" font-weight="900" font-style="italic" font-size="22" text-anchor="middle">
            <g class="p" data-p="2" transform="translate(85 250)"><circle r="15" /><text y="8">2</text></g>
            <g class="p" data-p="3" transform="translate(452 40)"><circle r="15" /><text y="8">3</text></g>
            <g class="p" data-p="4" transform="translate(45 55)"><circle r="15" /><text y="8">4</text></g>
            <g class="p" data-p="5" transform="translate(300 170)"><circle r="15" /><text y="8">5</text></g>
            <g class="p one" data-p="1" transform="translate(410 268)"><circle r="15" /><text y="8">1</text></g>
          </g>

          <!-- balón -->
          <g class="pv-ballg" data-ball transform="translate(424 280)">
            <circle class="pv-ball-shadow" data-ball-shadow r="6" cy="3" fill="#000" opacity="0.5" />
            <g data-ball-body filter="url(#pv-glow)">
              <circle r="6.5" fill="#7ec8e3" />
              <path d="M-6.5 0 H6.5 M0 -6.5 V6.5 M-4.6 -4.6 Q0 0 -4.6 4.6 M4.6 -4.6 Q0 0 4.6 4.6" stroke="#071820" stroke-width="1" fill="none" />
            </g>
          </g>

          <text class="pv-onev" data-onev x="436" y="232" font-family="var(--font-display)" font-weight="900" font-style="italic" font-size="26" fill="#7ec8e3">ISO</text>
        </svg>
        <figcaption><span>Isolation</span> 4 se abren al lado débil · el 1 se la juega</figcaption>
      </figure>
    </section>

    <!-- ============ CIERRE ============ -->
    <section class="pv-end">
      <span class="pv-logo" aria-hidden="true">
        <img class="pv-letters" src="/hero/iso-letters.webp" alt="" width="1600" height="369" loading="lazy" />
        <img class="pv-ball" src="/hero/iso-ball.webp" alt="" width="632" height="369" loading="lazy" />
      </span>
      <p class="pv-end-sub">Preventa de 1 semana · Diseñado en Santander</p>
      <a href="/" class="pv-back">← Volver a ISO</a>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  const root = document.querySelector<HTMLElement>('.pv');
  if (root) {
    const open = Date.parse(root.dataset.open || '');
    const close = Date.parse(root.dataset.close || '');
    const clock = root.querySelector<HTMLElement>('[data-clock]');
    const label = root.querySelector<HTMLElement>('[data-clock-label]');
    const q = (k: string) => root.querySelector<HTMLElement>(`[data-${k}]`);
    const D = q('d'), H = q('h'), M = q('m'), S = q('s');
    const pad = (n: number) => String(n).padStart(2, '0');
    const tick = () => {
      if (!clock || !label) return;
      const now = Date.now();
      let target = open;
      if (now >= open && now < close) {
        target = close;
        label.textContent = 'Preventa abierta · cierra en';
        clock.classList.add('is-open');
      } else if (now >= close) {
        label.textContent = 'La preventa ha terminado';
        clock.querySelector('.pv-clock-nums')?.remove();
        return;
      }
      const t = Math.max(0, Math.floor((target - now) / 1000));
      if (D) D.textContent = pad(Math.floor(t / 86400));
      if (H) H.textContent = pad(Math.floor((t % 86400) / 3600));
      if (M) M.textContent = pad(Math.floor((t % 3600) / 60));
      if (S) S.textContent = pad(t % 60);
    };
    tick();
    setInterval(tick, 1000);

    // Aparecen al entrar en pantalla (la pizarra se dibuja)
    const els = root.querySelectorAll<HTMLElement>('[data-reveal]');
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add('is-in');
            io.unobserve(e.target);
          }
        });
      }, { threshold: 0.25 });
      els.forEach((el) => io.observe(el));
    } else {
      els.forEach((el) => el.classList.add('is-in'));
    }
  }
</script>


<script>
  // ---------- Pizarra: la jugada se juega sola, en bucle, mientras está en pantalla ----------
  const svg = document.querySelector<SVGSVGElement>('[data-play]');
  if (svg) {
    const $ = <T extends Element>(sel: string) => svg.querySelector<T>(sel)!;
    const P: Record<string, SVGGElement> = {};
    svg.querySelectorAll<SVGGElement>('[data-p]').forEach((g) => (P[g.dataset.p!] = g));
    const T: Record<string, SVGPathElement> = {};
    svg.querySelectorAll<SVGPathElement>('[data-trail]').forEach((p) => (T[p.dataset.trail!] = p));
    const ball = $<SVGGElement>('[data-ball]');
    const body = $<SVGGElement>('[data-ball-body]');
    const shadow = $<SVGCircleElement>('[data-ball-shadow]');
    const spot = $<SVGCircleElement>('[data-spot]');
    const flash = $<SVGCircleElement>('[data-flash]');
    const onev = $<SVGTextElement>('[data-onev]');
    const len: Record<string, number> = {};
    for (const k in T) {
      len[k] = T[k].getTotalLength();
      T[k].style.strokeDasharray = k === 'shot' ? '' : `${len[k]} ${len[k]}`;
    }

    const clamp = (v: number) => Math.min(1, Math.max(0, v));
    const seg = (t: number, a: number, b: number) => clamp((t - a) / (b - a));
    const io3 = (x: number) => (x < 0.5 ? 4 * x * x * x : 1 - Math.pow(-2 * x + 2, 3) / 2);
    const out3 = (x: number) => 1 - Math.pow(1 - x, 3);
    const outBack = (x: number) => 1 + 2.7 * Math.pow(x - 1, 3) + 1.7 * Math.pow(x - 1, 2);
    const at = (k: string, p: number) => T[k].getPointAtLength(len[k] * clamp(p));
    const place = (el: SVGGraphicsElement, x: number, y: number, sc = 1) =>
      el.setAttribute('transform', `translate(${x.toFixed(1)} ${y.toFixed(1)}) scale(${sc.toFixed(3)})`);
    const show = (el: Element, o: number) => ((el as SVGElement).style.opacity = String(o));
    const draw = (k: string, p: number) => {
      T[k].style.strokeDashoffset = String(len[k] * (1 - clamp(p)));
      show(T[k], p > 0 ? (k === '1' ? 1 : 0.7) : 0);
      if (k !== 'shot') T[k].setAttribute('marker-end', p > 0.96 ? (k === '1' ? 'url(#pv-arr-b)' : 'url(#pv-arr)') : '');
    };

    // Línea de tiempo (ms)
    const DUR = 7600;
    function frame(t: number) {
      const fade = 1 - seg(t, 7000, 7500); // fundido al final del bucle
      // entran los jugadores
      ['2', '3', '4', '5', '1'].forEach((k, i) => {
        const e = outBack(seg(t, i * 90, i * 90 + 420));
        show(P[k], clamp(e) * fade);
      });

      // el 3, el 5 y el 2 se abren (con rastro)
      const c = io3(seg(t, 900, 2200));
      for (const k of ['3', '5']) {
        const pt = at(k, c);
        const t0 = k === '3' ? 90 : 270;
        place(P[k], pt.x, pt.y, outBack(seg(t, t0, t0 + 420)) || 0.001);
        draw(k, c);
        T[k].style.opacity = String(Number(T[k].style.opacity) * fade);
      }
      const c2 = io3(seg(t, 1200, 2200));
      const p2 = at('2', c2);
      place(P['2'], p2.x, p2.y, outBack(seg(t, 0, 420)) || 0.001);
      draw('2', c2 * 0.999);
      T['2'].setAttribute('marker-end', '');
      T['2'].style.opacity = String(c2 > 0 ? 0.45 * fade : 0);
      place(P['4'], 45, 55, outBack(seg(t, 180, 600)) || 0.001);

      // cara a cara: amago del 1 y del balón
      const jab = seg(t, 2300, 2900);
      const jabX = Math.sin(jab * Math.PI * 2) * 6 * (1 - jab);
      const d = io3(seg(t, 3000, 4300)); // penetración
      const p1 = d > 0 ? at('1', d) : { x: 410 + jabX, y: 268 };
      place(P['1'], p1.x, p1.y, outBack(seg(t, 360, 780)) || 0.001);
      draw('1', d);
      T['1'].style.opacity = String(d > 0 ? fade : 0);
      show(onev, clamp(outBack(seg(t, 2300, 2650))) * (1 - seg(t, 3400, 3700)) * fade);
      onev.setAttribute('transform', `translate(${(1 - outBack(seg(t, 2300, 2650))) * 10} 0)`);

      // balón: bota al lado del 1, cruza en los zigzags, tiro en parábola
      const shot = seg(t, 4350, 5000);
      const dribble = Math.abs(Math.sin(t / 95));
      if (shot === 0) {
        const side = d > 0 && d < 0.55 ? Math.sign(Math.sin(d * Math.PI * 5.2)) || 1 : 1;
        const bx = p1.x + 14 * side;
        const by = p1.y + 10;
        place(ball, bx, by, 0.85 + dribble * 0.25);
        body.setAttribute('transform', `translate(0 ${(-dribble * 5).toFixed(1)})`);
        shadow.setAttribute('r', String(4 + dribble * 2));
      } else {
        const sp = at('shot', out3(shot));
        const h = Math.sin(shot * Math.PI);
        place(ball, sp.x, sp.y, 1 + h * 0.9);
        body.setAttribute('transform', 'translate(0 0)');
        shadow.setAttribute('r', String(6 - h * 3));
      }
      show(ball, seg(t, 500, 800) * (1 - seg(t, 5000, 5150)) * fade);
      T['shot'].style.opacity = String(shot > 0 ? 0.8 * (1 - seg(t, 5600, 6200)) * fade : 0);

      // canasta
      const hit = seg(t, 4980, 5700);
      flash.setAttribute('r', String(9 + out3(hit) * 34));
      show(flash, hit > 0 ? (1 - hit) * fade : 0);

      // foco sobre el 1
      place(spot as unknown as SVGGraphicsElement, p1.x, p1.y, 1);
      spot.removeAttribute('cx');
      spot.removeAttribute('cy');
      show(spot, seg(t, 2200, 2700) * (1 - seg(t, 5200, 5800)) * fade);
    }

    let start = 0, raf = 0, running = false;
    const loop = (now: number) => {
      if (!start) start = now;
      frame((now - start) % DUR);
      raf = requestAnimationFrame(loop);
    };
    const io = new IntersectionObserver(([e]) => {
      if (e.isIntersecting && !running) {
        running = true;
        start = 0;
        raf = requestAnimationFrame(loop);
      } else if (!e.isIntersecting && running) {
        running = false;
        cancelAnimationFrame(raf);
      }
    }, { threshold: 0.3 });
    io.observe(svg);
    frame(0);
  }
</script>


<script>
  // Foco del cursor sobre la pista del título (igual que en la home)
  const hero = document.querySelector<HTMLElement>('.pv-hero');
  if (hero && window.matchMedia('(pointer: fine)').matches) {
    let raf = 0, tx = 0, ty = 0;
    hero.addEventListener('pointermove', (e) => {
      const r = hero.getBoundingClientRect();
      tx = e.clientX - r.left;
      ty = e.clientY - r.top;
      if (!raf) raf = requestAnimationFrame(() => {
        hero.style.setProperty('--mx', `${tx}px`);
        hero.style.setProperty('--my', `${ty}px`);
        hero.classList.add('is-lit');
        raf = 0;
      });
    });
    hero.addEventListener('pointerleave', () => hero.classList.remove('is-lit'));
  }
</script>

<style>
  .pv { padding-top: var(--nav-h); }


  .pv-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.78rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 1rem;
  }
  .pv-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    animation: pv-pulse 2s infinite;
  }
  .pv-title {
    font-family: var(--font-display);
    font-weight: 900;
    font-style: italic;
    text-transform: uppercase;
    font-size: clamp(3rem, 14vw, 12rem);
    line-height: 0.86;
    letter-spacing: -0.02em;
  }
  .pv-outline { color: transparent; -webkit-text-stroke: 1.5px var(--white); }
  .pv-fill { color: var(--white); }
  .pv-sub {
    margin-top: 1.2rem;
    max-width: 34rem;
    font-size: clamp(1rem, 1.6vw, 1.15rem);
    color: var(--white-dim);
  }

  .pv-clock { margin-top: 2.2rem; }
  .pv-clock-label {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.75rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--white-dim);
    margin-bottom: 0.6rem;
  }
  .pv-clock.is-open .pv-clock-label { color: var(--accent); }
  .pv-clock-nums { display: flex; gap: clamp(1rem, 3vw, 2rem); }
  .pv-clock-nums span {
    display: flex;
    flex-direction: column;
    font-family: var(--font-display);
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--white-dim);
  }
  .pv-clock-nums b {
    font-weight: 900;
    font-style: italic;
    font-size: clamp(2.2rem, 5vw, 3.4rem);
    line-height: 1;
    color: var(--white);
    font-variant-numeric: tabular-nums;
  }

  .pv-facts {
    list-style: none;
    padding: 0;
    margin: 2.6rem 0 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid rgba(242, 237, 229, 0.12);
  }
  .pv-facts li {
    padding: 1.1rem 1rem 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .pv-facts b {
    font-family: var(--font-display);
    font-weight: 900;
    font-style: italic;
    text-transform: uppercase;
    font-size: clamp(1.1rem, 2.2vw, 1.5rem);
  }
  .pv-facts span { font-size: 0.85rem; color: var(--white-dim); }

  .pv-list {
    max-width: var(--max-w);
    margin: 0 auto;
    padding: clamp(3rem, 7vw, 5rem) var(--pad) clamp(4rem, 8vw, 6rem);
  }
  .pv-h2 {
    font-family: var(--font-display);
    font-weight: 900;
    font-style: italic;
    text-transform: uppercase;
    font-size: clamp(2rem, 5vw, 3.4rem);
    line-height: 0.9;
    margin-bottom: 1.8rem;
  }

  @keyframes pv-pulse {
    0% { box-shadow: 0 0 0 0 rgba(126, 200, 227, 0.6); }
    70% { box-shadow: 0 0 0 10px rgba(126, 200, 227, 0); }
    100% { box-shadow: 0 0 0 0 rgba(126, 200, 227, 0); }
  }

  @media (max-width: 760px) {
    .pv-facts { grid-template-columns: 1fr; }
    .pv-facts li { padding: 0.9rem 0; border-bottom: 1px solid rgba(242, 237, 229, 0.08); }
  }
  @media (prefers-reduced-motion: reduce) {
