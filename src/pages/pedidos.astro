---
import Layout from '../layouts/Layout.astro';
---

<Layout title="ISO — Pedidos" description="Panel de pedidos" noindex={true}>
  <main class="pd">
    <header class="pd-top">
      <a href="/" class="pd-logo"><img src="/logocami-nav.png" alt="ISO" width="80" /></a>
      <h1>Pedidos</h1>
      <div class="pd-top-actions" hidden data-when-in>
        <button type="button" class="pd-icon" data-refresh title="Actualizar">↻</button>
        <button type="button" class="pd-icon" data-logout title="Salir">Salir</button>
      </div>
    </header>

    <!-- PIN -->
    <form class="pd-login" data-login>
      <label for="pd-pin">PIN de staff</label>
      <input id="pd-pin" type="password" autocomplete="current-password" required />
      <button type="submit" class="pd-btn">Entrar</button>
      <p class="pd-err" data-login-err hidden></p>
    </form>

    <section data-app hidden>
      <p class="pd-hello" data-hello></p>
      <p class="pd-kpis" data-kpis></p>

      <nav class="pd-tabs" data-tabs></nav>

      <div data-view></div>
    </section>

    <div class="pd-toast" data-toast hidden></div>
  </main>
</Layout>

<style is:global>
  .pd { --c-charge: #f0b35a; --c-wait: #8a857d; --c-ship: var(--accent); --c-sent: #9be39b; --c-done: #6f6b65; --c-cancel: #ff7a7a;
    min-height: 100vh; background: var(--bg); color: var(--white); padding: 0 var(--pad) 5rem; max-width: 760px; margin: 0 auto; font-family: var(--font-body); }
  .pd [hidden] { display: none !important; }
  .pd-top { display: flex; align-items: center; gap: 0.9rem; padding: 1rem 0 0.9rem; }
  .pd-logo img { display: block; height: auto; }
  .pd-top h1 { font-family: var(--font-display); font-weight: 900; font-style: italic; text-transform: uppercase; font-size: 1.5rem; letter-spacing: 0.02em; flex: 1; }
  .pd-top-actions { display: flex; gap: 0.5rem; }
  .pd-icon { background: none; border: 1px solid var(--border-light); color: var(--white-dim); padding: 0.45rem 0.8rem; font: 600 0.85rem var(--font-body); cursor: pointer; }
  .pd-icon:hover { color: var(--white); border-color: var(--white-dim); }

  .pd-login { max-width: 320px; margin: 18vh auto 0; display: grid; gap: 0.75rem; }
  .pd-login label { font-family: var(--font-display); font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; font-size: 0.8rem; color: var(--white-dim); }
  .pd-login input, .pd-search { background: var(--surface2); border: 1px solid var(--border-light); color: var(--white); padding: 0.8rem 1rem; font: 500 1rem var(--font-body); width: 100%; }
  .pd-err { color: #ff7a7a; font-size: 0.9rem; }

  .pd-btn { display: inline-flex; align-items: center; justify-content: center; gap: 0.4rem; background: var(--accent); color: #071820; border: 0; padding: 0.85rem 1.1rem; font: 900 italic 0.88rem var(--font-display); letter-spacing: 0.1em; text-transform: uppercase; cursor: pointer; text-decoration: none; }
  .pd-btn:disabled { opacity: 0.5; cursor: wait; }
  .pd-btn.big { width: 100%; padding: 1rem; font-size: 1rem; }
  .pd-btn.ghost { background: none; color: var(--white-dim); border: 1px solid var(--border-light); }
  .pd-btn.ghost:hover { color: var(--white); border-color: var(--white-dim); }
  .pd-btn.wa { background: #25d366; color: #062b14; }
  .pd-btn.danger { background: none; color: #ff7a7a; border: 1px solid #4a2222; }
  .pd-link { background: none; border: 0; padding: 0.3rem 0; color: var(--muted-light); font: 500 0.82rem var(--font-body); text-decoration: underline; cursor: pointer; }
  .pd-link:hover { color: var(--white); }
  .pd-link.red { color: #c76363; }

  .dot { display: inline-block; width: 0.55rem; height: 0.55rem; border-radius: 50%; background: var(--c); flex: none; }
  .charge { --c: var(--c-charge); } .wait { --c: var(--c-wait); } .ship { --c: var(--c-ship); }
  .sent { --c: var(--c-sent); } .done { --c: var(--c-done); } .cancel { --c: var(--c-cancel); }

  /* Frase de arriba */
  .pd-hello { font-family: var(--font-display); font-weight: 900; font-style: italic; text-transform: uppercase; font-size: clamp(1.6rem, 6vw, 2.2rem); line-height: 1.02; letter-spacing: -0.01em; margin: 0.6rem 0 1.1rem; }
  .pd-hello em { font-style: italic; color: var(--accent); }
  .pd-hello .y { color: var(--c-charge); }
  .pd-kpis { display: flex; flex-wrap: wrap; gap: 0.3rem 1.1rem; margin: -0.4rem 0 1.1rem; color: var(--muted-light); font-size: 0.85rem; }
  .pd-kpis b { color: var(--white); font-weight: 800; }

  /* Pestañas */
  .pd-tabs { position: sticky; top: 0; z-index: 5; background: var(--bg); display: grid; grid-template-columns: repeat(4, 1fr); border-bottom: 1px solid var(--border-light); margin: 0 calc(var(--pad) * -1) 1.25rem; padding: 0 var(--pad); }
  .pd-tab { background: none; border: 0; border-bottom: 3px solid transparent; color: var(--muted-light); padding: 0.9rem 0.25rem 0.75rem; font: 800 italic 0.85rem var(--font-display); letter-spacing: 0.08em; text-transform: uppercase; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 0.4rem; }
  .pd-tab[aria-selected="true"] { color: var(--white); border-bottom-color: var(--white); }
  .pd-tab .n { font-style: normal; font-family: var(--font-body); font-size: 0.72rem; font-weight: 800; min-width: 1.35rem; padding: 0.12rem 0.35rem; border-radius: 99px; background: var(--surface2); color: var(--white-dim); }
  .pd-tab .n.on { background: var(--c); color: #111; }

  .pd-intro { color: var(--muted-light); font-size: 0.9rem; margin-bottom: 1rem; line-height: 1.5; }
  .pd-empty { text-align: center; padding: 3rem 1rem; color: var(--muted-light); }
  .pd-empty b { display: block; font-family: var(--font-display); font-style: italic; font-weight: 900; text-transform: uppercase; font-size: 1.6rem; color: var(--white); margin-bottom: 0.4rem; }

  /* Tarjetas de tarea (Cobrar / Enviar) */
  .pd-task { background: var(--surface2); border: 1px solid var(--border); border-top: 3px solid var(--c); padding: 1rem 1rem 1.1rem; margin-bottom: 0.9rem; }
  .pd-task-head { display: flex; align-items: baseline; gap: 0.6rem; }
  .pd-task-name { font-weight: 800; font-size: 1.15rem; flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .pd-task-total { font-family: var(--font-display); font-weight: 900; font-style: italic; font-size: 1.5rem; }
  .pd-task-meta { color: var(--muted-light); font-size: 0.8rem; margin: 0.15rem 0 0.8rem; }
  .pd-task-meta b { color: var(--c-charge); }
  .pd-new { background: var(--accent); color: #071820; font-size: 0.6rem; font-weight: 800; letter-spacing: 0.1em; padding: 0.15rem 0.4rem; vertical-align: 0.2em; margin-right: 0.35rem; }
  .pd-check { background: var(--surface); border: 1px dashed var(--border-light); padding: 0.75rem 0.9rem; margin-bottom: 0.9rem; font-size: 0.9rem; color: var(--white-dim); line-height: 1.5; }
  .pd-check b { color: var(--white); }
  .pd-check code { font: 800 1rem var(--font-body); color: var(--white); letter-spacing: 0.04em; }
  .pd-copy { background: none; border: 1px solid var(--border-light); color: var(--white-dim); font: 600 0.72rem var(--font-body); padding: 0.15rem 0.45rem; margin-left: 0.35rem; cursor: pointer; }
  .pd-copy:hover { color: var(--white); }
  .pd-garments { list-style: none; display: grid; gap: 0.35rem; margin-bottom: 0.9rem; }
  .pd-garments li { display: flex; align-items: center; gap: 0.6rem; font-size: 1rem; }
  .pd-size { flex: none; min-width: 2.3rem; text-align: center; background: var(--white); color: var(--bg); font: 900 0.9rem var(--font-display); padding: 0.3rem 0.4rem; }
  .pd-garments em { font-style: normal; color: var(--muted-light); }
  .pd-addr { background: var(--surface); padding: 0.75rem 0.9rem; margin-bottom: 0.9rem; font-size: 0.92rem; line-height: 1.5; color: var(--white-dim); position: relative; }
  .pd-addr b { color: var(--white); }
  .pd-addr .pd-copy { position: absolute; top: 0.6rem; right: 0.6rem; }
  .pd-tagline { display: inline-block; font-size: 0.68rem; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; padding: 0.15rem 0.45rem; margin-bottom: 0.35rem; background: var(--border); color: var(--white-dim); }
  .pd-tagline.hand { background: rgba(126, 200, 227, 0.15); color: var(--accent); }
  .pd-note { margin-bottom: 0.9rem; padding: 0.6rem 0.8rem; border-left: 3px solid var(--c-charge); background: rgba(240, 179, 90, 0.08); color: var(--white); font-size: 0.92rem; }
  .pd-task-actions { display: grid; grid-template-columns: 1fr auto; gap: 0.5rem; }
  .pd-task-more { display: flex; gap: 1rem; margin-top: 0.6rem; flex-wrap: wrap; }

  /* Lista para preparar */
  .pd-pick { background: var(--surface); border: 1px solid var(--border); padding: 0.9rem 1rem; margin-bottom: 1.25rem; }
  .pd-pick h3, .pd-block h3 { font-size: 0.72rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted-light); margin-bottom: 0.6rem; font-weight: 800; }
  .pd-pick ul { list-style: none; display: grid; gap: 0.45rem; }
  .pd-pick li { display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; font-size: 0.95rem; }
  .pd-pick li > span:first-child { flex: 1 1 10rem; }
  .pd-pick .sz { background: var(--surface2); border: 1px solid var(--border-light); padding: 0.15rem 0.45rem; font-size: 0.82rem; font-weight: 700; }
  .pd-pick .sz i { font-style: normal; color: var(--accent); }

  /* Todos: lista compacta */
  .pd-bar { display: grid; gap: 0.6rem; margin-bottom: 1rem; }
  .pd-chips { display: flex; gap: 0.4rem; overflow-x: auto; scrollbar-width: none; }
  .pd-chip { flex: none; background: none; border: 1px solid var(--border-light); color: var(--white-dim); padding: 0.45rem 0.8rem; font: 600 0.85rem var(--font-body); cursor: pointer; }
  .pd-chip[aria-pressed="true"] { background: var(--white); color: var(--bg); border-color: var(--white); }
  .pd-chip i { font-style: normal; opacity: 0.6; margin-left: 0.3rem; }
  .pd-day { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted-light); padding: 1rem 0 0.45rem; }
  .pd-day:first-child { padding-top: 0; }
  .pd-row { background: var(--surface2); border: 1px solid var(--border); border-left: 4px solid var(--c); margin-bottom: 0.45rem; }
  .pd-row.cancel:not([open]) { opacity: 0.55; }
  .pd-row > summary { list-style: none; cursor: pointer; display: grid; grid-template-columns: 1fr auto; gap: 0.15rem 0.8rem; padding: 0.8rem 0.95rem; }
  .pd-row > summary::-webkit-details-marker { display: none; }
  .pd-row-name { font-weight: 700; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .pd-row-amount { font-family: var(--font-display); font-weight: 900; font-style: italic; font-size: 1.1rem; text-align: right; }
  .pd-row-what { color: var(--muted-light); font-size: 0.82rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .pd-row-step { justify-self: end; display: flex; align-items: center; gap: 0.35rem; font-size: 0.75rem; font-weight: 700; color: var(--c); white-space: nowrap; }
  .pd-row-detail { padding: 0.2rem 0.95rem 1rem; border-top: 1px solid var(--border); font-size: 0.9rem; color: var(--white-dim); line-height: 1.6; }
  .pd-row-detail a { color: var(--accent); text-decoration: none; }
  .pd-row-detail .pd-task-more { margin-top: 0.5rem; }
  .pd-more { display: block; width: 100%; margin-top: 0.4rem; background: none; border: 1px dashed var(--border-light); color: var(--white-dim); padding: 0.8rem; font: 600 0.9rem var(--font-body); cursor: pointer; }

  /* Números */
  .pd-stats { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.6rem; margin-bottom: 1.25rem; }
  .pd-stat { background: var(--surface2); border: 1px solid var(--border); padding: 0.9rem 1rem; }
  .pd-stat span { font-size: 0.72rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted-light); }
  .pd-stat b { display: block; font-family: var(--font-display); font-weight: 900; font-style: italic; font-size: 2rem; line-height: 1.1; }
  .pd-stat small { display: block; color: var(--white-dim); font-size: 0.82rem; margin-top: 0.15rem; }
  .pd-stat.wide { grid-column: 1 / -1; }
  .pd-stat.wide b { color: var(--accent); font-size: 2.6rem; }
  .pd-block { background: var(--surface); border: 1px solid var(--border); padding: 0.9rem 1rem; margin-bottom: 1rem; }
  .pd-block table { width: 100%; border-collapse: collapse; font-variant-numeric: tabular-nums; }
  .pd-block th, .pd-block td { padding: 0.5rem 0.5rem; text-align: center; border-top: 1px solid var(--border); font-size: 0.88rem; }
  .pd-block th:first-child, .pd-block td:first-child { text-align: left; }
  .pd-block th { color: var(--muted-light); font-weight: 600; font-size: 0.7rem; letter-spacing: 0.08em; text-transform: uppercase; border-top: 0; }
  .pd-block td.tot { font-weight: 700; color: var(--accent); }
  .pd-block .zero { color: var(--muted); }
  .pd-block .wrap { overflow-x: auto; }
  .pd-block ul { list-style: none; display: grid; gap: 0.55rem; font-size: 0.9rem; color: var(--white-dim); line-height: 1.45; }
  .pd-block li { display: flex; gap: 0.6rem; align-items: baseline; }
  .pd-block li b { color: var(--white); }
  .pd-danger { border-color: #4a2222; }
  .pd-danger p { font-size: 0.88rem; color: var(--white-dim); line-height: 1.5; margin-bottom: 0.8rem; }
  .pd-danger p b { color: var(--white); }

  .pd-toast { position: fixed; left: 50%; bottom: 1.25rem; transform: translateX(-50%); background: var(--white); color: var(--bg); padding: 0.8rem 1.1rem; font-weight: 600; font-size: 0.9rem; z-index: 20; max-width: calc(100% - 2rem); box-shadow: 0 8px 30px rgba(0,0,0,.5); }
  .pd-toast.err { background: #ff7a7a; }

  @media (min-width: 700px) {
    .pd-stats { grid-template-columns: repeat(4, 1fr); }
    .pd-tab { font-size: 0.95rem; }
  }
  @media (max-width: 380px) {
    .pd-tab { font-size: 0.72rem; letter-spacing: 0.04em; gap: 0.25rem; }
  }
</style>

<script>
  type Item = { product_id: string; name: string; size: string; qty: number; price_cents: number; presale: boolean };
  type Order = {
    code: string; created_at: string; name: string; email: string; phone: string | null; address: string; city: string;
    postal_code: string; notes: string | null; payment: string; items: Item[]; has_presale: boolean; shipping_cents: number;
    total_cents: number; status: string; tracking?: string | null; paid_at?: string | null; shipped_at?: string | null;
    reminder_sent_at?: string | null; stripe_payment_intent?: string | null;
  };
  type Stock = { product_id: string; name: string; initial: number; stock: number };
  type Alert = { product_id: string; product_name: string | null; kind: string; notified_at: string | null };
  type Tab = 'cobrar' | 'enviar' | 'todos' | 'numeros';

  const API = '/api/admin/pedidos';
  const SIZES = ['S', 'M', 'L', 'XL'];
  const PAGE = 30;
  const BIZUM = '601105483';
  const PAY: Record<string, string> = { tarjeta: 'Tarjeta / Apple Pay', bizum: 'Bizum', paypal: 'PayPal', contrarreembolso: 'Contrarreembolso' };

  // Qué toca con cada pedido
  type K = 'charge' | 'wait' | 'ship' | 'sent' | 'done' | 'cancel';
  const LABEL: Record<K, string> = { charge: 'Por cobrar', wait: 'Pago sin terminar', ship: 'Por enviar', sent: 'Enviado', done: 'Entregado', cancel: 'Cancelado' };
  function kind(o: Order): K {
    if (o.status === 'cancelado') return 'cancel';
    if (o.status === 'entregado') return 'done';
    if (o.status === 'enviado') return 'sent';
    if (o.status === 'pagado' || o.payment === 'contrarreembolso') return 'ship';
    if (o.payment === 'tarjeta') return 'wait';
    return 'charge';
  }

  const FILTERS: [string, string, (o: Order) => boolean][] = [
    ['todos', 'Todos', () => true],
    ['enviados', 'Enviados', (o) => ['sent', 'done'].includes(kind(o))],
    ['sinpagar', 'Pago sin terminar', (o) => kind(o) === 'wait'],
    ['cancelados', 'Cancelados', (o) => kind(o) === 'cancel'],
  ];

  const $ = <T extends HTMLElement>(s: string) => document.querySelector(s) as T;
  const esc = (s: unknown) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
  const eur = (c: number) => (c / 100).toLocaleString('es-ES', { style: 'currency', currency: 'EUR', minimumFractionDigits: c % 100 ? 2 : 0 });
  const hour = (iso: string) => new Date(iso).toLocaleTimeString('es-ES', { hour: '2-digit', minute: '2-digit' });
  const when = (iso: string) => new Date(iso).toLocaleString('es-ES', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' });
  const ago = (iso: string) => {
    const m = (Date.now() - Date.parse(iso)) / 6e4;
    if (m < 60) return `hace ${Math.max(1, Math.round(m))} min`;
    if (m < 60 * 24) return `hace ${Math.round(m / 60)} h`;
    const d = Math.round(m / 1440);
    return `hace ${d} ${d === 1 ? 'día' : 'días'}`;
  };
  const dayKey = (iso: string) => new Date(iso).toDateString();
  const dayLabel = (iso: string) => {
    const d = new Date(iso);
    const diff = Math.round((new Date(new Date().toDateString()).getTime() - new Date(d.toDateString()).getTime()) / 864e5);
    if (diff === 0) return 'Hoy';
    if (diff === 1) return 'Ayer';
    return d.toLocaleDateString('es-ES', { weekday: 'long', day: 'numeric', month: 'long' });
  };
  const short = (n: string) => n.replace(/^ISO\s+/i, '');
  const first = (n: string) => String(n || '').trim().split(/\s+/)[0];
  const qtyOf = (o: Order) => o.items.reduce((a, i) => a + i.qty, 0);
  const isLate = (o: Order) => kind(o) === 'charge' && Date.now() - Date.parse(o.created_at) > 24 * 36e5;
  const isNew = (o: Order) => Date.parse(o.created_at) > lastSeen;
  const inSantander = (o: Order) => /^390(0[1-9]|1[0-2])$/.test(String(o.postal_code).trim());
  const wa = (o: Order, text: string) => o.phone
    ? `https://wa.me/${o.phone.replace(/\D/g, '').replace(/^(\d{9})$/, '34$1')}?text=${encodeURIComponent(text)}` : '';
  const addrText = (o: Order) => `${o.name}\n${o.address}\n${o.postal_code} ${o.city}${o.phone ? `\n${o.phone}` : ''}`;

  let pin = '';
  try { pin = sessionStorage.getItem('iso_staff_pin') || ''; } catch {}
  let lastSeen = Date.now();
  try { lastSeen = Number(localStorage.getItem('iso_pd_seen')) || 0; } catch {}
  let orders: Order[] = [];
  let stock: Stock[] = [];
  let alerts: Alert[] = [];
  let tab: Tab | null = null;
  let filter = 'todos';
  let query = '';
  let shown = PAGE;
  const open = new Set<string>();

  function toast(msg: string, err = false) {
    const t = $('[data-toast]');
    t.textContent = msg; t.classList.toggle('err', err); t.hidden = false;
    clearTimeout((t as any)._t); (t as any)._t = setTimeout(() => (t.hidden = true), 3500);
  }

  async function api(method: 'GET' | 'POST', body?: object) {
    const res = await fetch(API, {
      method,
      headers: { 'x-staff-passcode': pin, ...(body ? { 'Content-Type': 'application/json' } : {}) },
      body: body ? JSON.stringify(body) : undefined,
    });
    const data = await res.json().catch(() => ({}));
    if (res.status === 401) { logout(); throw new Error('PIN incorrecto'); }
    if (!res.ok) throw new Error(data.error || `Error ${res.status}`);
    return data;
  }

  async function load() {
    const data = await api('GET');
    orders = (data.orders as Order[]).sort((a, b) => Date.parse(b.created_at) - Date.parse(a.created_at));
    stock = data.stock;
    alerts = data.alerts || [];
    // Al entrar, se abre la pestaña donde hay trabajo
    if (!tab) tab = count('charge') ? 'cobrar' : count('ship') ? 'enviar' : 'todos';
    render();
  }

  function logout() {
    pin = '';
    try { sessionStorage.removeItem('iso_staff_pin'); } catch {}
    $('[data-app]').hidden = true; $('[data-when-in]').hidden = true; $('[data-login]').hidden = false;
  }

  const count = (k: K) => orders.filter((o) => kind(o) === k).length;

  // ---------- Arriba ----------
  function renderHello() {
    const c = count('charge'); const s = count('ship');
    const parts: string[] = [];
    if (c) parts.push(`<span class="y">${c} por cobrar</span>`);
    if (s) parts.push(`<em>${s} por enviar</em>`);
    $('[data-hello]').innerHTML = parts.length ? `Tienes ${parts.join(' y ')}.` : 'Todo al día ✓';
    const paid = orders.filter((o) => ['pagado', 'enviado', 'entregado'].includes(o.status));
    const sum = (l: Order[]) => eur(l.reduce((s, o) => s + o.total_cents, 0));
    const today = paid.filter((o) => dayKey(o.paid_at || o.created_at) === new Date().toDateString());
    const nuevos = orders.filter(isNew).length;
    $('[data-kpis]').innerHTML = [
      `Hoy <b>${sum(today)}</b>`,
      `Cobrado <b>${sum(paid)}</b>`,
      `<b>${paid.reduce((s, o) => s + qtyOf(o), 0)}</b> prendas vendidas`,
      nuevos ? `<b style="color:var(--accent)">${nuevos} ${nuevos === 1 ? 'pedido nuevo' : 'pedidos nuevos'}</b>` : '',
    ].filter(Boolean).map((x) => `<span>${x}</span>`).join('');
  }

  function renderTabs() {
    const c = count('charge'); const s = count('ship');
    const t = (id: Tab, label: string, n?: number, k?: K) =>
      `<button type="button" class="pd-tab" role="tab" data-tab="${id}" aria-selected="${tab === id}">${label}${n !== undefined ? `<span class="n${n ? ` on ${k}` : ''}">${n}</span>` : ''}</button>`;
    $('[data-tabs]').innerHTML = t('cobrar', 'Cobrar', c, 'charge') + t('enviar', 'Enviar', s, 'ship') + t('todos', 'Todos') + t('numeros', 'Números');
  }

  // ---------- Cobrar ----------
  function chargeCard(o: Order) {
    const late = isLate(o);
    const how = o.payment === 'bizum'
      ? `Mira en tu banco si ha llegado un <b>Bizum de ${eur(o.total_cents)}</b> al ${BIZUM} con el concepto <code>${esc(o.code)}</code><button type="button" class="pd-copy" data-copy="${esc(o.code)}">copiar</button>`
      : o.payment === 'paypal'
        ? `Mira en PayPal si ha llegado un <b>pago de ${eur(o.total_cents)}</b> con la nota <code>${esc(o.code)}</code><button type="button" class="pd-copy" data-copy="${esc(o.code)}">copiar</button>`
        : `Comprueba que te han pagado <b>${eur(o.total_cents)}</b>.`;
    const msg = `¡Hola ${first(o.name)}! Soy Rafa de ISO 🏀 Te escribo por tu pedido ${o.code} (${eur(o.total_cents)}). ` +
      (o.payment === 'bizum' ? `¿Me confirmas cuando hagas el Bizum al ${BIZUM}? Pon ${o.code} en el concepto 🙌` : '¿Me confirmas cuando hagas el pago? 🙌');
    const link = wa(o, msg);
    return `<article class="pd-task charge">
      <div class="pd-task-head">
        <span class="pd-task-name">${isNew(o) ? '<span class="pd-new">NUEVO</span>' : ''}${esc(o.name)}</span>
        <span class="pd-task-total">${eur(o.total_cents)}</span>
      </div>
      <p class="pd-task-meta">${PAY[o.payment] || esc(o.payment)} · ${ago(o.created_at)}${late ? ' · <b>lleva +24 h sin pagar</b>' : ''}${o.reminder_sent_at ? ' · recordatorio enviado' : ''}</p>
      <div class="pd-check">${how}</div>
      <ul class="pd-garments">${garments(o)}</ul>
      <div class="pd-task-actions">
        <button type="button" class="pd-btn big" data-act="pagado" data-code="${o.code}">✓ Ya ha pagado</button>
        ${link ? `<a class="pd-btn wa" href="${link}" target="_blank" rel="noopener">WhatsApp</a>` : ''}
      </div>
      <div class="pd-task-more">
        <button type="button" class="pd-link" data-act="recordatorio" data-code="${o.code}">Mandarle recordatorio por email</button>
        <button type="button" class="pd-link red" data-act="cancelado" data-code="${o.code}">Cancelar pedido</button>
      </div>
    </article>`;
  }

  const garments = (o: Order) => o.items.map((i) =>
    `<li><span class="pd-size">${esc(i.size)}</span><span>${i.qty > 1 ? `<b>${i.qty}×</b> ` : ''}${esc(short(i.name))}${i.presale ? ' <em>· preventa</em>' : ''}</span></li>`).join('');

  function viewCobrar() {
    const list = orders.filter((o) => kind(o) === 'charge').reverse(); // los más antiguos primero
    if (!list.length) return empty('Nada por cobrar', 'Cuando alguien pague por Bizum o PayPal, aparecerá aquí para que lo compruebes.');
    return `<p class="pd-intro">Comprueba que te ha llegado el dinero y dale a <b>Ya ha pagado</b>. Se le manda el correo de confirmación y pasa a <b>Enviar</b>. Los más antiguos van primero.</p>` +
      list.map(chargeCard).join('');
  }

  // ---------- Enviar ----------
  function shipCard(o: Order) {
    const hand = inSantander(o);
    const msg = `¡Hola ${first(o.name)}! Soy Rafa de ISO 🏀 Tu pedido ${o.code} ya está listo. ` +
      (hand ? '¿Cuándo te viene bien que te lo lleve?' : 'Te lo enviamos hoy, te paso el seguimiento en cuanto lo tenga.');
    const link = wa(o, msg);
    return `<article class="pd-task ship">
      <div class="pd-task-head">
        <span class="pd-task-name">${isNew(o) ? '<span class="pd-new">NUEVO</span>' : ''}${esc(o.name)}</span>
        <span class="pd-task-total">${qtyOf(o)} ${qtyOf(o) === 1 ? 'prenda' : 'prendas'}</span>
      </div>
      <p class="pd-task-meta">${esc(o.code)} · pagado ${o.paid_at ? ago(o.paid_at) : ago(o.created_at)} · ${PAY[o.payment] || esc(o.payment)} · ${eur(o.total_cents)}</p>
      <ul class="pd-garments">${garments(o)}</ul>
      ${o.notes ? `<div class="pd-note">“${esc(o.notes)}”</div>` : ''}
      <div class="pd-addr">
        <span class="pd-tagline${hand ? ' hand' : ''}">${hand ? 'Santander · envío gratis' : `Envío ${eur(o.shipping_cents)}`}</span><br>
        <b>${esc(o.name)}</b><br>${esc(o.address)}<br>${esc(o.postal_code)} ${esc(o.city)}${o.phone ? `<br>${esc(o.phone)}` : ''}
        <button type="button" class="pd-copy" data-copy="${esc(addrText(o))}">copiar</button>
      </div>
      <div class="pd-task-actions">
        <button type="button" class="pd-btn big" data-act="enviado" data-code="${o.code}">📦 Enviado</button>
        ${link ? `<a class="pd-btn wa" href="${link}" target="_blank" rel="noopener">WhatsApp</a>` : ''}
      </div>
      <div class="pd-task-more">
        <a class="pd-link" href="mailto:${esc(o.email)}">${esc(o.email)}</a>
        ${o.stripe_payment_intent ? `<a class="pd-link" href="https://dashboard.stripe.com/payments/${esc(o.stripe_payment_intent)}" target="_blank" rel="noopener">Ver pago en Stripe</a>` : ''}
        <button type="button" class="pd-link red" data-act="cancelado" data-code="${o.code}">Cancelar pedido</button>
      </div>
    </article>`;
  }

  function pickList(list: Order[]) {
    const m = new Map<string, Record<string, number>>();
    for (const o of list) for (const i of o.items) {
      const r = m.get(i.name) || {};
      r[i.size] = (r[i.size] || 0) + i.qty;
      m.set(i.name, r);
    }
    const total = list.reduce((s, o) => s + qtyOf(o), 0);
    const order = (z: string) => { const i = SIZES.indexOf(z); return i < 0 ? 99 : i; };
    return `<div class="pd-pick"><h3>Para preparar · ${total} ${total === 1 ? 'prenda' : 'prendas'}</h3><ul>${
      [...m.entries()].map(([name, sz]) => `<li><span>${esc(short(name))}</span>${
        Object.keys(sz).sort((a, b) => order(a) - order(b)).map((z) => `<span class="sz">${esc(z)} <i>×${sz[z]}</i></span>`).join('')}</li>`).join('')
    }</ul></div>`;
  }

  function viewEnviar() {
    const list = orders.filter((o) => kind(o) === 'ship').reverse();
    if (!list.length) return empty('Nada por enviar', 'Los pedidos pagados aparecerán aquí con la dirección y lo que hay que preparar.');
    return pickList(list) + list.map(shipCard).join('');
  }

  // ---------- Todos ----------
  function row(o: Order) {
    const k = kind(o);
    const what = o.items.map((i) => `${i.qty > 1 ? `${i.qty}× ` : ''}${short(i.name)} (${i.size})`).join(', ');
    const hist = [
      `Pedido ${when(o.created_at)}`,
      o.paid_at && `pagado ${when(o.paid_at)}`,
      o.shipped_at && `enviado ${when(o.shipped_at)}`,
    ].filter(Boolean).join(' · ');
    const acts: string[] = [];
    if (k === 'wait') acts.push(`<button type="button" class="pd-link" data-act="pagado" data-code="${o.code}">Marcar como pagado</button>`);
    if (k === 'sent') acts.push(`<button type="button" class="pd-btn" data-act="entregado" data-code="${o.code}">Entregado</button>`);
    if (o.stripe_payment_intent) acts.push(`<a class="pd-link" href="https://dashboard.stripe.com/payments/${esc(o.stripe_payment_intent)}" target="_blank" rel="noopener">Ver en Stripe</a>`);
    if (['wait', 'charge', 'ship'].includes(k)) acts.push(`<button type="button" class="pd-link red" data-act="cancelado" data-code="${o.code}">Cancelar</button>`);
    if (k === 'cancel') acts.push(`<button type="button" class="pd-link red" data-act="borrar" data-code="${o.code}">Borrar para siempre</button>`);
    return `<details class="pd-row ${k}" data-code="${o.code}"${open.has(o.code) ? ' open' : ''}>
      <summary>
        <span class="pd-row-name">${isNew(o) ? '<span class="pd-new">NUEVO</span>' : ''}${esc(o.name)}</span>
        <span class="pd-row-amount">${eur(o.total_cents)}</span>
        <span class="pd-row-what">${hour(o.created_at)} · ${esc(what)}</span>
        <span class="pd-row-step"><i class="dot"></i>${LABEL[k]}</span>
      </summary>
      <div class="pd-row-detail">
        ${esc(o.code)} · ${PAY[o.payment] || esc(o.payment)} · envío ${o.shipping_cents ? eur(o.shipping_cents) : 'gratis'}<br>
        ${esc(o.address)}, ${esc(o.postal_code)} ${esc(o.city)}<br>
        <a href="mailto:${esc(o.email)}">${esc(o.email)}</a>${o.phone ? ` · <a href="${wa(o, `¡Hola ${first(o.name)}! Soy Rafa de ISO 🏀`)}" target="_blank" rel="noopener">${esc(o.phone)}</a>` : ''}
        ${o.notes ? `<br>Nota: “${esc(o.notes)}”` : ''}
        ${o.tracking ? `<br>Seguimiento: ${esc(o.tracking)}` : ''}
        <br><span style="color:var(--muted-light);font-size:.8rem">${hist}</span>
        ${acts.length ? `<div class="pd-task-more">${acts.join('')}</div>` : ''}
      </div>
    </details>`;
  }

  function viewTodos() {
    const fn = FILTERS.find((f) => f[0] === filter)![2];
    const q = query.trim().toLowerCase();
    const list = orders.filter(fn).filter((o) => !q || [o.code, o.name, o.email, o.phone, o.city, o.postal_code].some((v) => String(v ?? '').toLowerCase().includes(q)));
    let rows = ''; let day = '';
    for (const o of list.slice(0, shown)) {
      const k = dayKey(o.created_at);
      if (k !== day) { day = k; rows += `<div class="pd-day">${dayLabel(o.created_at)}</div>`; }
      rows += row(o);
    }
    return `<div class="pd-bar">
        <input type="search" class="pd-search" placeholder="Buscar nombre, código, email, teléfono…" data-search value="${esc(query)}" />
        <div class="pd-chips">${FILTERS.map(([k, label, f]) => `<button type="button" class="pd-chip" data-filter="${k}" aria-pressed="${filter === k}">${label}<i>${orders.filter(f).length}</i></button>`).join('')}</div>
      </div>
      <div data-rows>${rows || `<p class="pd-empty">${orders.length ? 'No hay pedidos aquí.' : 'Todavía no hay pedidos.'}</p>`}</div>
      ${list.length > shown ? `<button type="button" class="pd-more" data-more>Ver más (${list.length - shown})</button>` : ''}`;
  }

  // ---------- Números ----------
  function viewNumeros() {
    const live = orders.filter((o) => o.status !== 'cancelado');
    const paid = live.filter((o) => ['pagado', 'enviado', 'entregado'].includes(o.status));
    const sum = (l: Order[]) => l.reduce((s, o) => s + o.total_cents, 0);
    const today = paid.filter((o) => dayKey(o.paid_at || o.created_at) === new Date().toDateString());
    const week = paid.filter((o) => Date.now() - Date.parse(o.paid_at || o.created_at) < 7 * 864e5);
    const pend = orders.filter((o) => kind(o) === 'charge');
    const tile = (label: string, n: string | number, sub = '', cls = '') =>
      `<div class="pd-stat ${cls}"><span>${label}</span><b>${n}</b>${sub ? `<small>${sub}</small>` : ''}</div>`;
    const stats = `<div class="pd-stats">
      ${tile('Cobrado en total', eur(sum(paid)), `${pl(paid.length, 'pedido', 'pedidos')} · ${pl(paid.reduce((s, o) => s + qtyOf(o), 0), 'prenda', 'prendas')}`, 'wide')}
      ${tile('Hoy', eur(sum(today)), pl(today.length, 'pedido', 'pedidos'))}
      ${tile('Últimos 7 días', eur(sum(week)), pl(week.length, 'pedido', 'pedidos'))}
      ${tile('Por cobrar', eur(sum(pend)), pl(pend.length, 'pedido', 'pedidos'))}
      ${tile('Ticket medio', paid.length ? eur(Math.round(sum(paid) / paid.length)) : '—')}
    </div>`;

    // Preventa: unidades por modelo y talla (para encargar la producción)
    const rows = new Map<string, { name: string; sizes: Record<string, number>; paid: number }>();
    for (const s of stock) rows.set(s.product_id, { name: s.name, sizes: {}, paid: 0 });
    for (const o of live) for (const it of o.items) {
      if (!it.presale) continue;
      const r = rows.get(it.product_id) ?? { name: it.name, sizes: {}, paid: 0 };
      r.sizes[it.size] = (r.sizes[it.size] || 0) + it.qty;
      if (o.status !== 'pendiente') r.paid += it.qty;
      rows.set(it.product_id, r);
    }
    const st = new Map(stock.map((s) => [s.product_id, s]));
    const totals: Record<string, number> = {};
    const body = [...rows.entries()].map(([id, r]) => {
      const tot = SIZES.reduce((a, z) => a + (r.sizes[z] || 0), 0);
      SIZES.forEach((z) => (totals[z] = (totals[z] || 0) + (r.sizes[z] || 0)));
      const s = st.get(id);
      return `<tr><td>${esc(short(r.name))}</td>${SIZES.map((z) => `<td class="${r.sizes[z] ? '' : 'zero'}">${r.sizes[z] || 0}</td>`).join('')}
        <td class="tot">${tot}</td><td>${r.paid}</td><td>${s ? s.stock : '—'}</td></tr>`;
    }).join('');
    const all = SIZES.reduce((a, z) => a + (totals[z] || 0), 0);
    const tally = rows.size ? `<div class="pd-block"><h3>Preventa · unidades por talla</h3><div class="wrap"><table>
      <thead><tr><th>Modelo</th>${SIZES.map((z) => `<th>${z}</th>`).join('')}<th>Total</th><th>Pagadas</th><th>Quedan</th></tr></thead>
      <tbody>${body}<tr><td><b>Total</b></td>${SIZES.map((z) => `<td>${totals[z] || 0}</td>`).join('')}<td class="tot">${all}</td><td></td><td></td></tr></tbody>
    </table></div></div>` : '';

    const legend = `<div class="pd-block"><h3>Cómo funciona</h3><ul>
      <li><i class="dot charge"></i><span><b>Por cobrar</b> · Bizum o PayPal. Compruebas el dinero y le das a <b>Ya ha pagado</b>.</span></li>
      <li><i class="dot ship"></i><span><b>Por enviar</b> · pagado. Lo preparas, lo entregas y le das a <b>Enviado</b>. Los de tarjeta y Apple Pay llegan aquí solos.</span></li>
      <li><i class="dot sent"></i><span><b>Enviado</b> · cuando lo tenga, márcalo como <b>Entregado</b> en Todos.</span></li>
      <li><i class="dot wait"></i><span><b>Pago sin terminar</b> · abrió el pago con tarjeta y no lo acabó. Se cancela solo a las 2 h.</span></li>
      <li><i class="dot cancel"></i><span><b>Cancelado</b> · el stock vuelve solo. Si estaba cobrado con tarjeta, devuélvelo en Stripe.</span></li>
    </ul></div>`;
    const reset = `<div class="pd-block pd-danger"><h3>Empezar de cero</h3>
      <p>Borra <b>todos</b> los pedidos (por ejemplo, los de prueba) y deja el stock de la preventa como al principio. No se puede deshacer.</p>
      <button type="button" class="pd-btn danger" data-wipe>Vaciar pedidos</button></div>`;
    // Avisos por prenda: interesados del drop y gente esperando stock de los clásicos
    const groups = new Map<string, { name: string; kind: string; waiting: number; done: number }>();
    for (const a of alerts) {
      const g = groups.get(a.product_id) ?? { name: a.product_name || a.product_id, kind: a.kind, waiting: 0, done: 0 };
      a.notified_at ? g.done++ : g.waiting++;
      groups.set(a.product_id, g);
    }
    const arow = ([id, g]: [string, { name: string; kind: string; waiting: number; done: number }]) =>
      `<tr><td>${esc(short(g.name))}</td><td class="tot">${g.waiting}</td><td>${
        g.kind === 'stock'
          ? (g.waiting ? `<button type="button" class="pd-btn" style="padding:.45rem .7rem;font-size:.72rem" data-alert="${esc(id)}">Ya hay stock · avisar</button>` : (g.done ? `${g.done} avisados` : ''))
          : 'Drop'
      }</td></tr>`;
    const list = [...groups.entries()].sort((a, b) => b[1].waiting - a[1].waiting);
    const avisos = `<div class="pd-block"><h3>Avisos por prenda</h3>${
      list.length
        ? `<div class="wrap"><table><thead><tr><th>Prenda</th><th>Esperando</th><th></th></tr></thead><tbody>${list.map(arow).join('')}</tbody></table></div>
           <p style="margin-top:.7rem;font-size:.82rem;color:var(--muted-light)">Drop: quién quiere cada prenda. Clásicos: cuando vuelvas a ponerlos a la venta, pulsa el botón y les llega el correo.</p>`
        : '<p style="font-size:.88rem;color:var(--muted-light)">Todavía nadie ha pedido aviso de una prenda.</p>'
    }</div>`;
    return stats + avisos + tally + legend + reset;
  }

  const pl = (n: number, one: string, many: string) => `${n} ${n === 1 ? one : many}`;
  const empty = (title: string, text: string) => `<div class="pd-empty"><b>${title}</b>${text}</div>`;

  function render() {
    renderHello(); renderTabs();
    const v = $('[data-view]');
    v.innerHTML = tab === 'cobrar' ? viewCobrar() : tab === 'enviar' ? viewEnviar() : tab === 'numeros' ? viewNumeros() : viewTodos();
  }

  // Al buscar solo se repinta la lista (para no perder el foco del buscador)
  function renderRows() {
    const tmp = document.createElement('div');
    tmp.innerHTML = viewTodos();
    $('[data-rows]').replaceWith(tmp.querySelector('[data-rows]')!);
    const more = $('[data-more]'); const nm = tmp.querySelector('[data-more]');
    if (more && nm) more.replaceWith(nm); else if (more) more.remove(); else if (nm) $('[data-rows]').after(nm);
  }

  async function act(code: string, status: string, btn: HTMLButtonElement) {
    const o = orders.find((x) => x.code === code)!;
    let tracking: string | undefined;
    if (status === 'pagado' && !confirm(`¿Te han llegado ${eur(o.total_cents)} de ${o.name}?\nSe le manda el correo de pago recibido.`)) return;
    if (status === 'cancelado' && !confirm(`¿Cancelar el pedido de ${o.name} (${code})?\nLas unidades vuelven al stock y se le manda un correo.${o.status === 'pagado' && o.payment === 'tarjeta' ? '\n\nOjo: ya está cobrado. Devuélvele el dinero en Stripe.' : ''}`)) return;
    if (status === 'recordatorio' && !confirm(`¿Mandar a ${o.email} un recordatorio de pago por email?`)) return;
    if (status === 'borrar' && !confirm(`¿Borrar para siempre el pedido de ${o.name} (${code})?\nNo se puede deshacer.`)) return;
    if (status === 'enviado') {
      const t = prompt(`Pedido de ${o.name} enviado.\n\nSi va por mensajería, pega el número o enlace de seguimiento. Si lo entregas en mano, déjalo vacío.`, o.tracking || '');
      if (t === null) return;
      tracking = t;
    }
    btn.disabled = true;
    try {
      if (status === 'borrar') {
        await api('POST', { code, action: 'borrar' });
        orders = orders.filter((x) => x.code !== code);
        render(); toast('Pedido borrado');
        return;
      }
      const r = await api('POST', { code, status, tracking });
      if (status === 'cancelado') await load();
      else { const i = orders.findIndex((x) => x.code === code); if (r.order) orders[i] = r.order; render(); }
      const done: Record<string, string> = { pagado: 'Cobrado · pasa a Enviar', enviado: 'Enviado', entregado: 'Entregado', cancelado: 'Cancelado', recordatorio: 'Recordatorio enviado' };
      toast(r.email === 'error' ? 'Hecho, pero el correo ha fallado' : `${done[status] || 'Hecho'}${r.email === 'enviado' && status !== 'recordatorio' ? ' · correo enviado' : ''}`, r.email === 'error');
    } catch (e) {
      btn.disabled = false;
      toast(e instanceof Error ? e.message : 'Error', true);
    }
  }

  async function sendAlerts(btn: HTMLButtonElement) {
    const id = btn.dataset.alert!;
    const n = alerts.filter((a) => a.product_id === id && !a.notified_at).length;
    if (!confirm(`¿Ya está a la venta otra vez?\nSe manda el correo "Ha vuelto" a ${n} ${n === 1 ? 'persona' : 'personas'}.`)) return;
    btn.disabled = true;
    try {
      const r = await api('POST', { action: 'avisar-stock', product_id: id });
      await load();
      toast(r.failed ? `Enviados ${r.sent}, fallaron ${r.failed}` : `Aviso enviado a ${r.sent}`, !!r.failed);
    } catch (e) {
      btn.disabled = false;
      toast(e instanceof Error ? e.message : 'Error', true);
    }
  }

  async function wipe(btn: HTMLButtonElement) {
    const t = prompt(`Vas a borrar los ${orders.length} pedidos para siempre.\n\nEscribe BORRAR para confirmar:`);
    if (t === null) return;
    if (t.trim().toUpperCase() !== 'BORRAR') { toast('No se ha borrado nada', true); return; }
    btn.disabled = true;
    try {
      await api('POST', { action: 'vaciar', confirm: 'BORRAR' });
      tab = 'todos';
      await load();
      toast('Pedidos borrados · empezamos de cero');
    } catch (e) {
      btn.disabled = false;
      toast(e instanceof Error ? e.message : 'Error', true);
    }
  }

  // ---------- eventos ----------
  $('[data-login]').addEventListener('submit', async (e) => {
    e.preventDefault();
    const err = $('[data-login-err]');
    pin = $<HTMLInputElement>('#pd-pin').value.trim();
    err.hidden = true;
    try {
      await load();
      try { sessionStorage.setItem('iso_staff_pin', pin); } catch {}
      enter();
    } catch (x) {
      err.textContent = x instanceof Error ? x.message : 'Error'; err.hidden = false;
    }
  });

  function enter() {
    $('[data-login]').hidden = true; $('[data-app]').hidden = false; $('[data-when-in]').hidden = false;
    // La próxima vez, "nuevo" = lo que llegue a partir de ahora
    try { localStorage.setItem('iso_pd_seen', String(Date.now())); } catch {}
  }

  $('[data-logout]').addEventListener('click', logout);
  $('[data-refresh]').addEventListener('click', () => load().then(() => toast('Actualizado')).catch((e) => toast(e.message, true)));
  document.addEventListener('input', (e) => {
    const t = e.target as HTMLInputElement;
    if (t.matches?.('[data-search]')) { query = t.value; shown = PAGE; renderRows(); }
  });
  document.addEventListener('toggle', (e) => {
    const d = e.target as HTMLDetailsElement;
    if (!d.classList?.contains('pd-row')) return;
    d.open ? open.add(d.dataset.code!) : open.delete(d.dataset.code!);
  }, true);
  document.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    const tb = t.closest<HTMLButtonElement>('[data-tab]');
    if (tb) { tab = tb.dataset.tab as Tab; render(); window.scrollTo({ top: 0 }); return; }
    const chip = t.closest<HTMLButtonElement>('[data-filter]');
    if (chip) { filter = chip.dataset.filter!; shown = PAGE; render(); return; }
    if (t.closest('[data-more]')) { shown += PAGE; renderRows(); return; }
    const al = t.closest<HTMLButtonElement>('[data-alert]');
    if (al) { sendAlerts(al); return; }
    const w = t.closest<HTMLButtonElement>('[data-wipe]');
    if (w) { wipe(w); return; }
    const a = t.closest<HTMLButtonElement>('[data-act]');
    if (a) { e.preventDefault(); act(a.dataset.code!, a.dataset.act!, a); return; }
    const c = t.closest<HTMLButtonElement>('[data-copy]');
    if (c) { e.preventDefault(); navigator.clipboard?.writeText(c.dataset.copy!).then(() => toast('Copiado')).catch(() => {}); }
  });

  if (pin) load().then(enter).catch(() => logout());
  // Se actualiza solo cada minuto (si no estás escribiendo en el buscador)
  setInterval(() => {
    if (pin && !document.hidden && document.activeElement?.matches?.('[data-search]') !== true) load().catch(() => {});
  }, 60000);
</script>
