---
import Layout from '../layouts/Layout.astro';
---

<Layout title="ISO — Pedidos" description="Panel de pedidos" noindex={true}>
  <main class="pd">
    <header class="pd-top">
      <a href="/" class="pd-logo"><img src="/logo-white-nav.png" alt="ISO" width="88" /></a>
      <h1>Pedidos</h1>
      <div class="pd-top-actions" hidden data-when-in>
        <button type="button" class="pd-icon" data-refresh title="Actualizar">↻</button>
        <button type="button" class="pd-icon" data-logout title="Salir">Salir</button>
      </div>
    </header>

    <!-- PIN -->
    <form class="pd-login" data-login>
      <label for="pd-pin">PIN de staff</label>
      <input id="pd-pin" type="password" autocomplete="current-password" required />
      <button type="submit" class="pd-btn">Entrar</button>
      <p class="pd-err" data-login-err hidden></p>
    </form>

    <section data-app hidden>
      <div class="pd-stats" data-stats></div>

      <details class="pd-tally" open>
        <summary>Preventa · unidades vendidas por talla</summary>
        <div data-tally></div>
      </details>

      <div class="pd-filters">
        <div class="pd-chips" data-chips></div>
        <input type="search" class="pd-search" placeholder="Buscar código, nombre, email…" data-search />
      </div>

      <div class="pd-list" data-list></div>
    </section>

    <div class="pd-toast" data-toast hidden></div>
  </main>
</Layout>

<style is:global>
  .pd { min-height: 100vh; background: var(--bg); color: var(--white); padding: 0 var(--pad) 4rem; max-width: 980px; margin: 0 auto; font-family: var(--font-body); }
  .pd [hidden] { display: none !important; }
  .pd-top { display: flex; align-items: center; gap: 1rem; padding: 1.25rem 0; border-bottom: 1px solid var(--border-light); margin-bottom: 1.5rem; position: sticky; top: 0; background: var(--bg); z-index: 5; }
  .pd-logo img { display: block; height: auto; }
  .pd-top h1 { font-family: var(--font-display); font-weight: 900; font-style: italic; text-transform: uppercase; font-size: 1.6rem; letter-spacing: 0.02em; flex: 1; }
  .pd-top-actions { display: flex; gap: 0.5rem; }
  .pd-icon { background: none; border: 1px solid var(--border-light); color: var(--white-dim); padding: 0.45rem 0.8rem; font: 600 0.85rem var(--font-body); cursor: pointer; }
  .pd-icon:hover { color: var(--white); border-color: var(--white-dim); }

  .pd-login { max-width: 320px; margin: 18vh auto 0; display: grid; gap: 0.75rem; }
  .pd-login label { font-family: var(--font-display); font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; font-size: 0.8rem; color: var(--white-dim); }
  .pd-login input, .pd-search { background: var(--surface2); border: 1px solid var(--border-light); color: var(--white); padding: 0.85rem 1rem; font: 500 1rem var(--font-body); width: 100%; }
  .pd-btn { background: var(--accent); color: #071820; border: 0; padding: 0.85rem 1.1rem; font: 900 italic 0.95rem var(--font-display); letter-spacing: 0.12em; text-transform: uppercase; cursor: pointer; }
  .pd-btn:disabled { opacity: 0.5; cursor: wait; }
  .pd-btn.ghost { background: none; color: var(--white-dim); border: 1px solid var(--border-light); }
  .pd-btn.ghost:hover { color: var(--white); border-color: var(--white-dim); }
  .pd-btn.danger { background: none; color: #ff7a7a; border: 1px solid #4a2222; }
  .pd-err { color: #ff7a7a; font-size: 0.9rem; }

  .pd-stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.6rem; margin-bottom: 1.25rem; }
  .pd-stat { background: var(--surface2); border: 1px solid var(--border); padding: 0.9rem 1rem; }
  .pd-stat b { display: block; font-family: var(--font-display); font-weight: 900; font-style: italic; font-size: 2rem; line-height: 1; }
  .pd-stat span { font-size: 0.75rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted-light); }
  .pd-stat small { display: block; color: var(--white-dim); font-size: 0.85rem; margin-top: 0.2rem; }
  .pd-stat.hot b { color: var(--accent); }

  .pd-tally { background: var(--surface); border: 1px solid var(--border); margin-bottom: 1.25rem; }
  .pd-tally summary { cursor: pointer; padding: 0.9rem 1rem; font-family: var(--font-display); font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; font-size: 0.85rem; color: var(--white-dim); }
  .pd-tally table { width: 100%; border-collapse: collapse; font-variant-numeric: tabular-nums; }
  .pd-tally th, .pd-tally td { padding: 0.55rem 0.8rem; text-align: center; border-top: 1px solid var(--border); font-size: 0.9rem; }
  .pd-tally th:first-child, .pd-tally td:first-child { text-align: left; }
  .pd-tally th { color: var(--muted-light); font-weight: 500; font-size: 0.75rem; letter-spacing: 0.1em; text-transform: uppercase; }
  .pd-tally td.tot { font-weight: 600; color: var(--accent); }
  .pd-tally .zero { color: var(--muted); }
  .pd-tally-wrap { overflow-x: auto; }

  .pd-filters { display: grid; gap: 0.6rem; margin-bottom: 1rem; }
  .pd-chips { display: flex; gap: 0.4rem; flex-wrap: wrap; }
  .pd-chip { background: none; border: 1px solid var(--border-light); color: var(--white-dim); padding: 0.5rem 0.85rem; font: 600 0.85rem var(--font-body); cursor: pointer; }
  .pd-chip[aria-pressed="true"] { background: var(--white); color: var(--bg); border-color: var(--white); }
  .pd-chip i { font-style: normal; opacity: 0.6; margin-left: 0.3rem; }

  .pd-list { display: grid; gap: 0.75rem; }
  .pd-empty { color: var(--muted-light); padding: 2rem 0; text-align: center; }
  .pd-card { background: var(--surface2); border: 1px solid var(--border); padding: 1rem 1.1rem 1.1rem; }
  .pd-card.late { border-color: #5a3a12; }
  .pd-card-head { display: flex; align-items: baseline; gap: 0.6rem; flex-wrap: wrap; margin-bottom: 0.7rem; }
  .pd-code { font-family: var(--font-display); font-weight: 900; font-style: italic; font-size: 1.5rem; letter-spacing: 0.02em; }
  .pd-total { margin-left: auto; font-family: var(--font-display); font-weight: 900; font-size: 1.35rem; }
  .pd-meta { color: var(--muted-light); font-size: 0.82rem; width: 100%; }
  .pd-badge { font-size: 0.7rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; padding: 0.25rem 0.5rem; border: 1px solid currentColor; }
  .pd-badge.pendiente { color: #f0b35a; } .pd-badge.pagado { color: var(--accent); } .pd-badge.enviado { color: #9be39b; }
  .pd-badge.entregado { color: var(--white-dim); } .pd-badge.cancelado { color: #ff7a7a; } .pd-badge.late { color: #ff9f43; }
  .pd-badge.pre { color: var(--white-dim); border-style: dashed; }
  .pd-cols { display: grid; grid-template-columns: 1.1fr 1fr; gap: 1rem; }
  .pd-items { list-style: none; display: grid; gap: 0.3rem; font-size: 0.95rem; }
  .pd-items em { font-style: normal; color: var(--muted-light); font-size: 0.85rem; }
  .pd-cust { font-size: 0.92rem; line-height: 1.5; color: var(--white-dim); }
  .pd-cust b { color: var(--white); }
  .pd-cust a { color: var(--accent); text-decoration: none; }
  .pd-cust .copy { background: none; border: 0; color: var(--muted-light); text-decoration: underline; cursor: pointer; font: inherit; font-size: 0.8rem; padding: 0; }
  .pd-notes { margin-top: 0.4rem; color: var(--white); font-size: 0.88rem; }
  .pd-actions { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1rem; padding-top: 0.9rem; border-top: 1px solid var(--border); }
  .pd-actions .pd-btn { font-size: 0.85rem; padding: 0.7rem 1rem; }
  .pd-track { font-size: 0.85rem; color: var(--white-dim); margin-top: 0.4rem; word-break: break-all; }

  .pd-toast { position: fixed; left: 50%; bottom: 1.25rem; transform: translateX(-50%); background: var(--white); color: var(--bg); padding: 0.8rem 1.1rem; font-weight: 600; font-size: 0.9rem; z-index: 20; max-width: calc(100% - 2rem); box-shadow: 0 8px 30px rgba(0,0,0,.5); }
  .pd-toast.err { background: #ff7a7a; }

  @media (max-width: 700px) {
    .pd-stats { grid-template-columns: repeat(2, 1fr); }
    .pd-cols { grid-template-columns: 1fr; }
    .pd-actions .pd-btn { flex: 1 1 auto; }
    .pd-tally th, .pd-tally td { padding: 0.5rem 0.35rem; font-size: 0.8rem; }
    .pd-tally th { font-size: 0.62rem; letter-spacing: 0.04em; }
    .pd-tally td:first-child { min-width: 7.5rem; }
  }
</style>

<script>
  type Item = { product_id: string; name: string; size: string; qty: number; price_cents: number; presale: boolean };
  type Order = {
    code: string; created_at: string; name: string; email: string; phone: string | null; address: string; city: string;
    postal_code: string; notes: string | null; payment: string; items: Item[]; has_presale: boolean; shipping_cents: number;
    total_cents: number; status: string; tracking?: string | null; paid_at?: string | null; shipped_at?: string | null; reminder_sent_at?: string | null;
  };
  type Stock = { product_id: string; name: string; initial: number; stock: number };

  const API = '/api/admin/pedidos';
  const SIZES = ['S', 'M', 'L', 'XL'];
  const PAY: Record<string, string> = { tarjeta: 'Tarjeta', bizum: 'Bizum', paypal: 'PayPal', contrarreembolso: 'Contrarreembolso' };
  const FILTERS: [string, string, (o: Order) => boolean][] = [
    ['cobrar', 'Por cobrar', (o) => o.status === 'pendiente' && o.payment !== 'contrarreembolso'],
    ['enviar', 'Por enviar', (o) => o.status === 'pagado' || (o.status === 'pendiente' && o.payment === 'contrarreembolso')],
    ['enviados', 'Enviados', (o) => o.status === 'enviado' || o.status === 'entregado'],
    ['todos', 'Todos', (o) => o.status !== 'cancelado'],
    ['cancelados', 'Cancelados', (o) => o.status === 'cancelado'],
  ];

  const $ = <T extends HTMLElement>(s: string) => document.querySelector(s) as T;
  const esc = (s: unknown) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
  const eur = (c: number) => (c / 100).toLocaleString('es-ES', { style: 'currency', currency: 'EUR' });
  const ago = (iso: string) => {
    const h = (Date.now() - Date.parse(iso)) / 36e5;
    if (h < 1) return `hace ${Math.max(1, Math.round(h * 60))} min`;
    if (h < 48) return `hace ${Math.round(h)} h`;
    return new Date(iso).toLocaleDateString('es-ES', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' });
  };
  const isLate = (o: Order) => o.status === 'pendiente' && o.payment !== 'contrarreembolso' && Date.now() - Date.parse(o.created_at) > 24 * 36e5;
  const waLink = (p: string) => `https://wa.me/${p.replace(/\D/g, '').replace(/^(\d{9})$/, '34$1')}`;

  let pin = '';
  try { pin = sessionStorage.getItem('iso_staff_pin') || ''; } catch {}
  let orders: Order[] = [];
  let stock: Stock[] = [];
  let filter = 'cobrar';
  let query = '';

  function toast(msg: string, err = false) {
    const t = $('[data-toast]');
    t.textContent = msg; t.classList.toggle('err', err); t.hidden = false;
    clearTimeout((t as any)._t); (t as any)._t = setTimeout(() => (t.hidden = true), 3500);
  }

  async function api(method: 'GET' | 'POST', body?: object) {
    const res = await fetch(API, {
      method,
      headers: { 'x-staff-passcode': pin, ...(body ? { 'Content-Type': 'application/json' } : {}) },
      body: body ? JSON.stringify(body) : undefined,
    });
    const data = await res.json().catch(() => ({}));
    if (res.status === 401) { logout(); throw new Error('PIN incorrecto'); }
    if (!res.ok) throw new Error(data.error || `Error ${res.status}`);
    return data;
  }

  async function load() {
    const data = await api('GET');
    orders = data.orders; stock = data.stock;
    render();
  }

  function logout() {
    pin = '';
    try { sessionStorage.removeItem('iso_staff_pin'); } catch {}
    $('[data-app]').hidden = true; $('[data-when-in]').hidden = true; $('[data-login]').hidden = false;
  }

  function renderStats() {
    const live = orders.filter((o) => o.status !== 'cancelado');
    const cobrar = live.filter(FILTERS[0][2]);
    const enviar = live.filter(FILTERS[1][2]);
    const cobrado = live.filter((o) => ['pagado', 'enviado', 'entregado'].includes(o.status));
    const late = cobrar.filter(isLate).length;
    const tile = (n: number | string, label: string, sub = '', hot = false) =>
      `<div class="pd-stat${hot ? ' hot' : ''}"><span>${label}</span><b>${n}</b>${sub ? `<small>${sub}</small>` : ''}</div>`;
    $('[data-stats]').innerHTML =
      tile(cobrar.length, 'Por cobrar', `${eur(cobrar.reduce((s, o) => s + o.total_cents, 0))}${late ? ` · ${late} +24 h` : ''}`, cobrar.length > 0) +
      tile(enviar.length, 'Por enviar', '', enviar.length > 0) +
      tile(cobrado.length, 'Cobrados', eur(cobrado.reduce((s, o) => s + o.total_cents, 0))) +
      tile(live.length, 'Pedidos', `${live.reduce((s, o) => s + o.items.reduce((a, i) => a + i.qty, 0), 0)} prendas`);
  }

  function renderTally() {
    const live = orders.filter((o) => o.status !== 'cancelado');
    const rows = new Map<string, { name: string; sizes: Record<string, number>; paid: number }>();
    for (const s of stock) rows.set(s.product_id, { name: s.name, sizes: {}, paid: 0 });
    for (const o of live) for (const it of o.items) {
      if (!it.presale) continue;
      const r = rows.get(it.product_id) ?? { name: it.name, sizes: {}, paid: 0 };
      r.sizes[it.size] = (r.sizes[it.size] || 0) + it.qty;
      if (o.status !== 'pendiente') r.paid += it.qty;
      rows.set(it.product_id, r);
    }
    if (!rows.size) { $('[data-tally]').innerHTML = '<p class="pd-empty">Aún no hay ventas de preventa.</p>'; return; }
    const st = new Map(stock.map((s) => [s.product_id, s]));
    const totals: Record<string, number> = {};
    const body = [...rows.entries()].map(([id, r]) => {
      const tot = SIZES.reduce((a, z) => a + (r.sizes[z] || 0), 0);
      SIZES.forEach((z) => (totals[z] = (totals[z] || 0) + (r.sizes[z] || 0)));
      const s = st.get(id);
      return `<tr><td>${esc(r.name)}</td>${SIZES.map((z) => `<td class="${r.sizes[z] ? '' : 'zero'}">${r.sizes[z] || 0}</td>`).join('')}
        <td class="tot">${tot}</td><td>${r.paid}</td><td>${s ? `${s.stock}/${s.initial}` : '—'}</td></tr>`;
    }).join('');
    const all = SIZES.reduce((a, z) => a + totals[z], 0);
    $('[data-tally]').innerHTML = `<div class="pd-tally-wrap"><table>
      <thead><tr><th>Modelo</th>${SIZES.map((z) => `<th>${z}</th>`).join('')}<th>Total</th><th>Pagadas</th><th>Quedan</th></tr></thead>
      <tbody>${body}<tr><td><b>Total</b></td>${SIZES.map((z) => `<td>${totals[z]}</td>`).join('')}<td class="tot">${all}</td><td></td><td></td></tr></tbody>
    </table></div>`;
  }

  function renderChips() {
    $('[data-chips]').innerHTML = FILTERS.map(([k, label, fn]) =>
      `<button type="button" class="pd-chip" data-filter="${k}" aria-pressed="${filter === k}">${label}<i>${orders.filter(fn).length}</i></button>`).join('');
  }

  function actions(o: Order) {
    const b = (label: string, status: string, cls = '') => `<button type="button" class="pd-btn ${cls}" data-act="${status}" data-code="${o.code}">${label}</button>`;
    if (o.status === 'cancelado' || o.status === 'entregado') return '';
    const out: string[] = [];
    if (o.status === 'pendiente' && o.payment !== 'contrarreembolso') out.push(b('Marcar pagado', 'pagado'), b('Recordar pago', 'recordatorio', 'ghost'));
    if (o.status === 'pagado' || (o.status === 'pendiente' && o.payment === 'contrarreembolso')) out.push(b('Marcar enviado', 'enviado'));
    if (o.status === 'enviado') out.push(b('Marcar entregado', 'entregado', 'ghost'));
    if (o.status !== 'enviado') out.push(b('Cancelar', 'cancelado', 'danger'));
    return `<div class="pd-actions">${out.join('')}</div>`;
  }

  function card(o: Order) {
    const late = isLate(o);
    return `<article class="pd-card${late ? ' late' : ''}">
      <div class="pd-card-head">
        <span class="pd-code">${esc(o.code)}</span>
        <span class="pd-badge ${o.status}">${o.status}</span>
        ${late ? '<span class="pd-badge late">+24 h sin pagar</span>' : ''}
        ${o.has_presale ? '<span class="pd-badge pre">Preventa</span>' : ''}
        <span class="pd-total">${eur(o.total_cents)}</span>
        <span class="pd-meta">${ago(o.created_at)} · ${PAY[o.payment] || esc(o.payment)} · envío ${o.shipping_cents ? eur(o.shipping_cents) : 'gratis'}${o.reminder_sent_at ? ' · recordatorio enviado' : ''}</span>
      </div>
      <div class="pd-cols">
        <ul class="pd-items">${o.items.map((i) => `<li>${i.qty}× ${esc(i.name)} <em>· ${esc(i.size)}</em></li>`).join('')}</ul>
        <div class="pd-cust">
          <b>${esc(o.name)}</b><br>
          ${o.phone ? `<a href="${waLink(o.phone)}" target="_blank" rel="noopener">${esc(o.phone)} · WhatsApp</a><br>` : ''}
          <a href="mailto:${esc(o.email)}">${esc(o.email)}</a><br>
          ${esc(o.address)}, ${esc(o.postal_code)} ${esc(o.city)}
          <button type="button" class="copy" data-copy="${esc(`${o.name}\n${o.address}\n${o.postal_code} ${o.city}${o.phone ? `\n${o.phone}` : ''}`)}">copiar</button>
          ${o.notes ? `<div class="pd-notes">“${esc(o.notes)}”</div>` : ''}
          ${o.tracking ? `<div class="pd-track">Seguimiento: ${esc(o.tracking)}</div>` : ''}
        </div>
      </div>
      ${actions(o)}
    </article>`;
  }

  function renderList() {
    const fn = FILTERS.find((f) => f[0] === filter)![2];
    const q = query.trim().toLowerCase();
    const list = orders.filter(fn).filter((o) => !q || [o.code, o.name, o.email, o.phone, o.city].some((v) => String(v ?? '').toLowerCase().includes(q)));
    // Por cobrar: los más antiguos primero (los que antes caducan)
    if (filter === 'cobrar' || filter === 'enviar') list.sort((a, b) => Date.parse(a.created_at) - Date.parse(b.created_at));
    $('[data-list]').innerHTML = list.length ? list.map(card).join('') : '<p class="pd-empty">No hay pedidos aquí.</p>';
  }

  function render() { renderStats(); renderTally(); renderChips(); renderList(); }

  async function act(code: string, status: string, btn: HTMLButtonElement) {
    const o = orders.find((x) => x.code === code)!;
    let tracking: string | undefined;
    if (status === 'pagado' && !confirm(`¿Has recibido ${eur(o.total_cents)} de ${o.name} (${code})?\nSe le manda el correo de pago recibido.`)) return;
    if (status === 'cancelado' && !confirm(`¿Cancelar ${code}?\nLas unidades de preventa vuelven al stock y se le manda un correo.`)) return;
    if (status === 'recordatorio' && !confirm(`¿Mandar a ${o.email} un recordatorio de pago?`)) return;
    if (status === 'enviado') {
      const t = prompt(`${code} enviado.\nNúmero o enlace de seguimiento (opcional):`, o.tracking || '');
      if (t === null) return;
      tracking = t;
    }
    btn.disabled = true;
    try {
      const r = await api('POST', { code, status, tracking });
      const i = orders.findIndex((x) => x.code === code);
      if (r.order) orders[i] = r.order;
      if (status === 'cancelado') {
        const d = await api('GET'); orders = d.orders; stock = d.stock;
      }
      render();
      toast(r.email === 'enviado' ? `${code}: hecho · correo enviado` : r.email === 'error' ? `${code}: hecho, pero el correo ha fallado` : `${code}: hecho`, r.email === 'error');
    } catch (e) {
      btn.disabled = false;
      toast(e instanceof Error ? e.message : 'Error', true);
    }
  }

  // ---- eventos ----
  $('[data-login]').addEventListener('submit', async (e) => {
    e.preventDefault();
    const input = $<HTMLInputElement>('#pd-pin');
    const err = $('[data-login-err]');
    pin = input.value.trim();
    err.hidden = true;
    try {
      await load();
      try { sessionStorage.setItem('iso_staff_pin', pin); } catch {}
      enter();
    } catch (x) {
      err.textContent = x instanceof Error ? x.message : 'Error'; err.hidden = false;
    }
  });

  function enter() {
    $('[data-login]').hidden = true; $('[data-app]').hidden = false; $('[data-when-in]').hidden = false;
  }

  $('[data-logout]').addEventListener('click', logout);
  $('[data-refresh]').addEventListener('click', () => load().then(() => toast('Actualizado')).catch((e) => toast(e.message, true)));
  $('[data-search]').addEventListener('input', (e) => { query = (e.target as HTMLInputElement).value; renderList(); });
  document.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    const chip = t.closest<HTMLButtonElement>('[data-filter]');
    if (chip) { filter = chip.dataset.filter!; renderChips(); renderList(); return; }
    const a = t.closest<HTMLButtonElement>('[data-act]');
    if (a) { act(a.dataset.code!, a.dataset.act!, a); return; }
    const c = t.closest<HTMLButtonElement>('[data-copy]');
    if (c) navigator.clipboard?.writeText(c.dataset.copy!).then(() => toast('Dirección copiada')).catch(() => {});
  });

  if (pin) load().then(enter).catch(() => logout());
  // Se actualiza solo cada minuto mientras está abierto
  setInterval(() => { if (pin && !document.hidden) load().catch(() => {}); }, 60000);
</script>
