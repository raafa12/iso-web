---
import Layout from '../layouts/Layout.astro';
---

<Layout title="ISO — Pedidos" description="Panel de pedidos" noindex={true}>
  <main class="pd">
    <header class="pd-top">
      <a href="/" class="pd-logo"><img src="/logocami-nav.png" alt="ISO" width="88" /></a>
      <h1>Pedidos</h1>
      <div class="pd-top-actions" hidden data-when-in>
        <button type="button" class="pd-icon" data-refresh title="Actualizar">↻</button>
        <button type="button" class="pd-icon" data-logout title="Salir">Salir</button>
      </div>
    </header>

    <!-- PIN -->
    <form class="pd-login" data-login>
      <label for="pd-pin">PIN de staff</label>
      <input id="pd-pin" type="password" autocomplete="current-password" required />
      <button type="submit" class="pd-btn">Entrar</button>
      <p class="pd-err" data-login-err hidden></p>
    </form>

    <section data-app hidden>
      <!-- 1) Lo primero: los últimos pedidos -->
      <div class="pd-todo" data-todo></div>

      <div class="pd-bar">
        <div class="pd-chips" data-chips></div>
        <input type="search" class="pd-search" placeholder="Buscar nombre, código, email, teléfono…" data-search />
      </div>

      <div class="pd-list" data-list></div>
      <button type="button" class="pd-more" data-more hidden>Ver más pedidos</button>

      <!-- 2) Lo demás -->
      <h2 class="pd-h2">Resumen</h2>
      <div class="pd-stats" data-stats></div>

      <details class="pd-tally">
        <summary>Preventa · unidades por talla</summary>
        <div data-tally></div>
      </details>

      <details class="pd-help">
        <summary>¿Qué significa cada estado?</summary>
        <ul>
          <li><i class="dot charge"></i><b>Comprobar Bizum / PayPal</b> · mira en el banco o en PayPal si ha llegado el dinero y dale a <em>Ya ha pagado</em>.</li>
          <li><i class="dot wait"></i><b>Pago sin terminar</b> · abrió el pago con tarjeta y no lo acabó. Se cancela solo a las 2 h. No hay que hacer nada.</li>
          <li><i class="dot ship"></i><b>Toca enviar</b> · está pagado. Prepáralo, envíalo y dale a <em>Enviado</em>.</li>
          <li><i class="dot sent"></i><b>Enviado</b> · cuando lo reciba, dale a <em>Entregado</em>.</li>
          <li><i class="dot done"></i><b>Entregado</b> · terminado.</li>
          <li><i class="dot cancel"></i><b>Cancelado</b> · el stock de preventa ya ha vuelto. Lo puedes borrar.</li>
        </ul>
        <p>Si un pedido con tarjeta se cancela después de cobrarlo, devuelve el dinero desde Stripe (botón <em>Ver en Stripe</em>).</p>
      </details>
    </section>

    <div class="pd-toast" data-toast hidden></div>
  </main>
</Layout>

<style is:global>
  .pd { min-height: 100vh; background: var(--bg); color: var(--white); padding: 0 var(--pad) 4rem; max-width: 860px; margin: 0 auto; font-family: var(--font-body); }
  .pd [hidden] { display: none !important; }
  .pd-top { display: flex; align-items: center; gap: 1rem; padding: 1.1rem 0; border-bottom: 1px solid var(--border-light); margin-bottom: 1.25rem; position: sticky; top: 0; background: var(--bg); z-index: 5; }
  .pd-logo img { display: block; height: auto; }
  .pd-top h1 { font-family: var(--font-display); font-weight: 900; font-style: italic; text-transform: uppercase; font-size: 1.6rem; letter-spacing: 0.02em; flex: 1; }
  .pd-top-actions { display: flex; gap: 0.5rem; }
  .pd-icon { background: none; border: 1px solid var(--border-light); color: var(--white-dim); padding: 0.45rem 0.8rem; font: 600 0.85rem var(--font-body); cursor: pointer; }
  .pd-icon:hover { color: var(--white); border-color: var(--white-dim); }

  .pd-login { max-width: 320px; margin: 18vh auto 0; display: grid; gap: 0.75rem; }
  .pd-login label { font-family: var(--font-display); font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; font-size: 0.8rem; color: var(--white-dim); }
  .pd-login input, .pd-search { background: var(--surface2); border: 1px solid var(--border-light); color: var(--white); padding: 0.8rem 1rem; font: 500 1rem var(--font-body); width: 100%; }
  .pd-btn { background: var(--accent); color: #071820; border: 0; padding: 0.8rem 1.1rem; font: 900 italic 0.9rem var(--font-display); letter-spacing: 0.1em; text-transform: uppercase; cursor: pointer; text-decoration: none; display: inline-block; }
  .pd-btn:disabled { opacity: 0.5; cursor: wait; }
  .pd-btn.ghost { background: none; color: var(--white-dim); border: 1px solid var(--border-light); }
  .pd-btn.ghost:hover { color: var(--white); border-color: var(--white-dim); }
  .pd-btn.danger { background: none; color: #ff7a7a; border: 1px solid #4a2222; }
  .pd-err { color: #ff7a7a; font-size: 0.9rem; }

  /* Colores de cada estado */
  .pd { --c-charge: #f0b35a; --c-wait: #8a857d; --c-ship: var(--accent); --c-sent: #9be39b; --c-done: #6f6b65; --c-cancel: #ff7a7a; }
  .dot { display: inline-block; width: 0.6rem; height: 0.6rem; border-radius: 50%; flex: none; }
  .charge { --c: var(--c-charge); } .wait { --c: var(--c-wait); } .ship { --c: var(--c-ship); }
  .sent { --c: var(--c-sent); } .done { --c: var(--c-done); } .cancel { --c: var(--c-cancel); }
  .dot { background: var(--c); }

  /* Aviso de lo que hay que hacer */
  .pd-todo { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1rem; }
  .pd-todo button { display: flex; align-items: center; gap: 0.5rem; background: var(--surface2); border: 1px solid var(--border-light); color: var(--white); padding: 0.7rem 0.95rem; font: 600 0.95rem var(--font-body); cursor: pointer; }
  .pd-todo button b { font-family: var(--font-display); font-style: italic; font-size: 1.15rem; color: var(--c); }
  .pd-todo .ok { color: var(--muted-light); font-size: 0.95rem; padding: 0.4rem 0; }

  .pd-bar { display: grid; gap: 0.6rem; margin-bottom: 1rem; }
  .pd-chips { display: flex; gap: 0.4rem; overflow-x: auto; scrollbar-width: none; }
  .pd-chip { flex: none; background: none; border: 1px solid var(--border-light); color: var(--white-dim); padding: 0.45rem 0.8rem; font: 600 0.85rem var(--font-body); cursor: pointer; }
  .pd-chip[aria-pressed="true"] { background: var(--white); color: var(--bg); border-color: var(--white); }
  .pd-chip i { font-style: normal; opacity: 0.6; margin-left: 0.3rem; }

  /* Lista */
  .pd-list { display: grid; }
  .pd-day { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted-light); padding: 1.1rem 0 0.5rem; }
  .pd-day:first-child { padding-top: 0; }
  .pd-empty { color: var(--muted-light); padding: 2rem 0; text-align: center; }
  .pd-row { background: var(--surface2); border: 1px solid var(--border); border-left: 4px solid var(--c); margin-bottom: 0.5rem; }
  .pd-row.is-cancel { opacity: 0.55; }
  .pd-row.is-cancel[open] { opacity: 1; }
  .pd-row > summary { list-style: none; cursor: pointer; display: grid; grid-template-columns: 1fr auto; gap: 0.15rem 0.8rem; padding: 0.85rem 1rem; }
  .pd-row > summary::-webkit-details-marker { display: none; }
  .pd-name { font-weight: 700; font-size: 1.05rem; display: flex; align-items: center; gap: 0.45rem; min-width: 0; }
  .pd-name span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .pd-new { flex: none; background: var(--accent); color: #071820; font-size: 0.62rem; font-weight: 800; letter-spacing: 0.1em; padding: 0.15rem 0.4rem; }
  .pd-amount { font-family: var(--font-display); font-weight: 900; font-style: italic; font-size: 1.2rem; text-align: right; }
  .pd-what { color: var(--white-dim); font-size: 0.88rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0; }
  .pd-step { justify-self: end; display: flex; align-items: center; gap: 0.4rem; font-size: 0.78rem; font-weight: 700; color: var(--c); white-space: nowrap; }
  .pd-sub { grid-column: 1 / -1; color: var(--muted-light); font-size: 0.78rem; }

  .pd-detail { padding: 0 1rem 1rem; border-top: 1px solid var(--border); }
  .pd-cols { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; padding-top: 0.9rem; }
  .pd-cols h3 { font-size: 0.7rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted-light); margin-bottom: 0.4rem; font-weight: 700; }
  .pd-items { list-style: none; display: grid; gap: 0.3rem; font-size: 0.95rem; }
  .pd-items em { font-style: normal; color: var(--muted-light); }
  .pd-items .ship { color: var(--muted-light); font-size: 0.85rem; }
  .pd-cust { font-size: 0.92rem; line-height: 1.55; color: var(--white-dim); }
  .pd-cust a { color: var(--accent); text-decoration: none; }
  .pd-notes { margin-top: 0.5rem; color: var(--white); font-size: 0.9rem; background: var(--surface); padding: 0.5rem 0.7rem; border-left: 2px solid var(--c-charge); }
  .pd-track { font-size: 0.85rem; color: var(--white-dim); margin-top: 0.4rem; word-break: break-all; }
  .pd-hist { margin-top: 0.8rem; font-size: 0.8rem; color: var(--muted-light); line-height: 1.6; }
  .pd-actions { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1rem; }
  .pd-actions .pd-btn { font-size: 0.82rem; padding: 0.7rem 0.95rem; }
  .pd-more { display: block; width: 100%; margin-top: 0.4rem; background: none; border: 1px dashed var(--border-light); color: var(--white-dim); padding: 0.8rem; font: 600 0.9rem var(--font-body); cursor: pointer; }

  /* Resumen */
  .pd-h2 { font-family: var(--font-display); font-weight: 900; font-style: italic; text-transform: uppercase; font-size: 1.1rem; letter-spacing: 0.04em; margin: 2.5rem 0 0.8rem; color: var(--white-dim); }
  .pd-stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.6rem; margin-bottom: 1rem; }
  .pd-stat { background: var(--surface2); border: 1px solid var(--border); padding: 0.9rem 1rem; }
  .pd-stat b { display: block; font-family: var(--font-display); font-weight: 900; font-style: italic; font-size: 1.7rem; line-height: 1.1; }
  .pd-stat span { font-size: 0.72rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted-light); }
  .pd-stat small { display: block; color: var(--white-dim); font-size: 0.82rem; margin-top: 0.2rem; }

  .pd-tally, .pd-help { background: var(--surface); border: 1px solid var(--border); margin-bottom: 0.75rem; }
  .pd-tally summary, .pd-help summary { cursor: pointer; padding: 0.9rem 1rem; font-family: var(--font-display); font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; font-size: 0.82rem; color: var(--white-dim); }
  .pd-tally table { width: 100%; border-collapse: collapse; font-variant-numeric: tabular-nums; }
  .pd-tally th, .pd-tally td { padding: 0.55rem 0.8rem; text-align: center; border-top: 1px solid var(--border); font-size: 0.9rem; }
  .pd-tally th:first-child, .pd-tally td:first-child { text-align: left; }
  .pd-tally th { color: var(--muted-light); font-weight: 500; font-size: 0.75rem; letter-spacing: 0.1em; text-transform: uppercase; }
  .pd-tally td.tot { font-weight: 600; color: var(--accent); }
  .pd-tally .zero { color: var(--muted); }
  .pd-tally-wrap { overflow-x: auto; }
  .pd-help ul { list-style: none; display: grid; gap: 0.6rem; padding: 0 1rem; font-size: 0.9rem; color: var(--white-dim); line-height: 1.45; }
  .pd-help li { display: flex; gap: 0.6rem; align-items: baseline; }
  .pd-help b { color: var(--white); }
  .pd-help em { font-style: normal; color: var(--accent); }
  .pd-help p { padding: 0.8rem 1rem 1rem; font-size: 0.85rem; color: var(--muted-light); }

  .pd-toast { position: fixed; left: 50%; bottom: 1.25rem; transform: translateX(-50%); background: var(--white); color: var(--bg); padding: 0.8rem 1.1rem; font-weight: 600; font-size: 0.9rem; z-index: 20; max-width: calc(100% - 2rem); box-shadow: 0 8px 30px rgba(0,0,0,.5); }
  .pd-toast.err { background: #ff7a7a; }

  @media (max-width: 700px) {
    .pd-stats { grid-template-columns: repeat(2, 1fr); }
    .pd-cols { grid-template-columns: 1fr; }
    .pd-actions .pd-btn { flex: 1 1 auto; text-align: center; }
    .pd-tally th, .pd-tally td { padding: 0.5rem 0.35rem; font-size: 0.8rem; }
    .pd-tally th { font-size: 0.62rem; letter-spacing: 0.04em; }
    .pd-tally td:first-child { min-width: 7.5rem; }
  }
</style>

<script>
  type Item = { product_id: string; name: string; size: string; qty: number; price_cents: number; presale: boolean };
  type Order = {
    code: string; created_at: string; name: string; email: string; phone: string | null; address: string; city: string;
    postal_code: string; notes: string | null; payment: string; items: Item[]; has_presale: boolean; shipping_cents: number;
    total_cents: number; status: string; tracking?: string | null; paid_at?: string | null; shipped_at?: string | null;
    reminder_sent_at?: string | null; stripe_payment_intent?: string | null;
  };
  type Stock = { product_id: string; name: string; initial: number; stock: number };

  const API = '/api/admin/pedidos';
  const SIZES = ['S', 'M', 'L', 'XL'];
  const PAGE = 25;
  const PAY: Record<string, string> = { tarjeta: 'Tarjeta / Apple Pay', bizum: 'Bizum', paypal: 'PayPal', contrarreembolso: 'Contrarreembolso' };

  // Qué toca hacer con cada pedido, en palabras normales
  type Step = { k: 'charge' | 'wait' | 'ship' | 'sent' | 'done' | 'cancel'; label: string };
  function step(o: Order): Step {
    if (o.status === 'cancelado') return { k: 'cancel', label: 'Cancelado' };
    if (o.status === 'entregado') return { k: 'done', label: 'Entregado' };
    if (o.status === 'enviado') return { k: 'sent', label: 'Enviado' };
    if (o.status === 'pagado' || o.payment === 'contrarreembolso') return { k: 'ship', label: 'Toca enviar' };
    if (o.payment === 'tarjeta') return { k: 'wait', label: 'Pago sin terminar' };
    return { k: 'charge', label: `Comprobar ${PAY[o.payment] || o.payment}` };
  }

  const FILTERS: [string, string, (o: Order) => boolean][] = [
    ['todos', 'Todos', () => true],
    ['cobrar', 'Por cobrar', (o) => step(o).k === 'charge'],
    ['enviar', 'Por enviar', (o) => step(o).k === 'ship'],
    ['enviados', 'Enviados', (o) => ['sent', 'done'].includes(step(o).k)],
    ['sinpagar', 'Sin terminar', (o) => step(o).k === 'wait'],
    ['cancelados', 'Cancelados', (o) => o.status === 'cancelado'],
  ];

  const $ = <T extends HTMLElement>(s: string) => document.querySelector(s) as T;
  const esc = (s: unknown) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
  const eur = (c: number) => (c / 100).toLocaleString('es-ES', { style: 'currency', currency: 'EUR', minimumFractionDigits: c % 100 ? 2 : 0 });
  const hour = (iso: string) => new Date(iso).toLocaleTimeString('es-ES', { hour: '2-digit', minute: '2-digit' });
  const when = (iso: string) => new Date(iso).toLocaleString('es-ES', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' });
  const ago = (iso: string) => {
    const m = (Date.now() - Date.parse(iso)) / 6e4;
    if (m < 60) return `hace ${Math.max(1, Math.round(m))} min`;
    if (m < 60 * 24) return `hace ${Math.round(m / 60)} h`;
    return `hace ${Math.round(m / 1440)} d`;
  };
  const dayKey = (iso: string) => new Date(iso).toDateString();
  const dayLabel = (iso: string) => {
    const d = new Date(iso); const t = new Date();
    const diff = Math.round((new Date(t.toDateString()).getTime() - new Date(d.toDateString()).getTime()) / 864e5);
    if (diff === 0) return 'Hoy';
    if (diff === 1) return 'Ayer';
    return d.toLocaleDateString('es-ES', { weekday: 'long', day: 'numeric', month: 'long' });
  };
  const short = (n: string) => n.replace(/^ISO\s+/i, '').replace(/^Classic\s+/i, 'Classic ').replace(/\s*·\s*/g, ' · ');
  const isLate = (o: Order) => step(o).k === 'charge' && Date.now() - Date.parse(o.created_at) > 24 * 36e5;
  const waLink = (p: string) => `https://wa.me/${p.replace(/\D/g, '').replace(/^(\d{9})$/, '34$1')}`;

  let pin = '';
  try { pin = sessionStorage.getItem('iso_staff_pin') || ''; } catch {}
  // Pedidos nuevos desde la última vez que abriste el panel
  let lastSeen = Date.now();
  try { lastSeen = Number(localStorage.getItem('iso_pd_seen')) || 0; } catch {}
  let orders: Order[] = [];
  let stock: Stock[] = [];
  let filter = 'todos';
  let query = '';
  let shown = PAGE;
  const open = new Set<string>();

  function toast(msg: string, err = false) {
    const t = $('[data-toast]');
    t.textContent = msg; t.classList.toggle('err', err); t.hidden = false;
    clearTimeout((t as any)._t); (t as any)._t = setTimeout(() => (t.hidden = true), 3500);
  }

  async function api(method: 'GET' | 'POST', body?: object) {
    const res = await fetch(API, {
      method,
      headers: { 'x-staff-passcode': pin, ...(body ? { 'Content-Type': 'application/json' } : {}) },
      body: body ? JSON.stringify(body) : undefined,
    });
    const data = await res.json().catch(() => ({}));
    if (res.status === 401) { logout(); throw new Error('PIN incorrecto'); }
    if (!res.ok) throw new Error(data.error || `Error ${res.status}`);
    return data;
  }

  async function load() {
    const data = await api('GET');
    orders = data.orders; stock = data.stock;
    render();
  }

  function logout() {
    pin = '';
    try { sessionStorage.removeItem('iso_staff_pin'); } catch {}
    $('[data-app]').hidden = true; $('[data-when-in]').hidden = true; $('[data-login]').hidden = false;
  }

  // ---- Arriba: lo que hay que hacer ----
  function renderTodo() {
    const n = (k: string) => orders.filter((o) => step(o).k === k).length;
    const cobrar = n('charge'); const enviar = n('ship');
    const late = orders.filter(isLate).length;
    const nuevos = orders.filter((o) => Date.parse(o.created_at) > lastSeen).length;
    const btn = (k: string, filterKey: string, num: number, label: string) =>
      `<button type="button" class="${k}" data-filter="${filterKey}"><i class="dot"></i><b>${num}</b>${label}</button>`;
    const parts: string[] = [];
    if (nuevos) parts.push(`<button type="button" class="ship" data-filter="todos"><b>${nuevos}</b>${nuevos === 1 ? 'nuevo' : 'nuevos'} desde la última vez</button>`);
    if (cobrar) parts.push(btn('charge', 'cobrar', cobrar, `por cobrar${late ? ` · ${late} de hace +24 h` : ''}`));
    if (enviar) parts.push(btn('ship', 'enviar', enviar, 'por enviar'));
    $('[data-todo]').innerHTML = parts.length ? parts.join('') : '<p class="ok">✓ Todo al día. No hay nada por cobrar ni por enviar.</p>';
  }

  function renderChips() {
    $('[data-chips]').innerHTML = FILTERS.map(([k, label, fn]) =>
      `<button type="button" class="pd-chip" data-filter="${k}" aria-pressed="${filter === k}">${label}<i>${orders.filter(fn).length}</i></button>`).join('');
  }

  function actions(o: Order) {
    const b = (label: string, status: string, cls = '') => `<button type="button" class="pd-btn ${cls}" data-act="${status}" data-code="${o.code}">${label}</button>`;
    const s = step(o).k;
    const out: string[] = [];
    if (s === 'charge') out.push(b('Ya ha pagado', 'pagado'), b('Recordarle el pago', 'recordatorio', 'ghost'));
    if (s === 'wait') out.push(b('Ya ha pagado', 'pagado', 'ghost'));
    if (s === 'ship') out.push(b('Enviado', 'enviado'));
    if (s === 'sent') out.push(b('Entregado', 'entregado'));
    if (o.stripe_payment_intent) out.push(`<a class="pd-btn ghost" href="https://dashboard.stripe.com/payments/${esc(o.stripe_payment_intent)}" target="_blank" rel="noopener">Ver en Stripe</a>`);
    if (!['sent', 'done', 'cancel'].includes(s)) out.push(b('Cancelar', 'cancelado', 'danger'));
    if (s === 'cancel') out.push(b('Borrar', 'borrar', 'danger'));
    return out.length ? `<div class="pd-actions">${out.join('')}</div>` : '';
  }

  function row(o: Order) {
    const s = step(o);
    const isNew = Date.parse(o.created_at) > lastSeen;
    const qty = o.items.reduce((a, i) => a + i.qty, 0);
    const what = o.items.map((i) => `${i.qty > 1 ? `${i.qty}× ` : ''}${short(i.name)} (${i.size})`).join(', ');
    const hist = [
      `Pedido: ${when(o.created_at)}`,
      o.paid_at && `Pagado: ${when(o.paid_at)}`,
      o.reminder_sent_at && `Recordatorio: ${when(o.reminder_sent_at)}`,
      o.shipped_at && `Enviado: ${when(o.shipped_at)}`,
    ].filter(Boolean).join(' · ');
    return `<details class="pd-row ${s.k}${s.k === 'cancel' ? ' is-cancel' : ''}" data-code="${o.code}"${open.has(o.code) ? ' open' : ''}>
      <summary>
        <span class="pd-name">${isNew ? '<em class="pd-new">NUEVO</em>' : ''}<span>${esc(o.name)}</span></span>
        <span class="pd-amount">${eur(o.total_cents)}</span>
        <span class="pd-what">${esc(what)}</span>
        <span class="pd-step"><i class="dot"></i>${s.label}</span>
        <span class="pd-sub">${hour(o.created_at)} · ${ago(o.created_at)} · ${esc(o.code)} · ${PAY[o.payment] || esc(o.payment)}${o.has_presale ? ' · preventa' : ''}${isLate(o) ? ' · <b style="color:var(--c-charge)">+24 h sin pagar</b>' : ''}</span>
      </summary>
      <div class="pd-detail">
        <div class="pd-cols">
          <div>
            <h3>${qty} ${qty === 1 ? 'prenda' : 'prendas'}</h3>
            <ul class="pd-items">
              ${o.items.map((i) => `<li>${i.qty}× ${esc(short(i.name))} <em>· talla ${esc(i.size)}</em></li>`).join('')}
              <li class="ship">Envío ${o.shipping_cents ? eur(o.shipping_cents) : 'gratis'}</li>
            </ul>
          </div>
          <div class="pd-cust">
            <h3>Enviar a</h3>
            ${esc(o.name)}<br>
            ${esc(o.address)}<br>${esc(o.postal_code)} ${esc(o.city)}<br>
            ${o.phone ? `<a href="${waLink(o.phone)}" target="_blank" rel="noopener">${esc(o.phone)} · WhatsApp</a><br>` : ''}
            <a href="mailto:${esc(o.email)}">${esc(o.email)}</a><br>
            <button type="button" class="pd-btn ghost" style="margin-top:.5rem;padding:.45rem .7rem;font-size:.72rem" data-copy="${esc(`${o.name}\n${o.address}\n${o.postal_code} ${o.city}${o.phone ? `\n${o.phone}` : ''}`)}">Copiar dirección</button>
            ${o.notes ? `<div class="pd-notes">“${esc(o.notes)}”</div>` : ''}
            ${o.tracking ? `<div class="pd-track">Seguimiento: ${esc(o.tracking)}</div>` : ''}
          </div>
        </div>
        <div class="pd-hist">${hist}</div>
        ${actions(o)}
      </div>
    </details>`;
  }

  function renderList() {
    const fn = FILTERS.find((f) => f[0] === filter)![2];
    const q = query.trim().toLowerCase();
    const list = orders
      .filter(fn)
      .filter((o) => !q || [o.code, o.name, o.email, o.phone, o.city, o.postal_code].some((v) => String(v ?? '').toLowerCase().includes(q)))
      .sort((a, b) => Date.parse(b.created_at) - Date.parse(a.created_at)); // los últimos primero
    let html = ''; let day = '';
    for (const o of list.slice(0, shown)) {
      const k = dayKey(o.created_at);
      if (k !== day) { day = k; html += `<div class="pd-day">${dayLabel(o.created_at)}</div>`; }
      html += row(o);
    }
    $('[data-list]').innerHTML = html || `<p class="pd-empty">${orders.length ? 'No hay pedidos aquí.' : 'Todavía no hay pedidos.'}</p>`;
    const more = $('[data-more]');
    more.hidden = list.length <= shown;
    more.textContent = `Ver más pedidos (${list.length - shown})`;
  }

  // ---- Abajo: resumen ----
  function renderStats() {
    const live = orders.filter((o) => o.status !== 'cancelado');
    const cobrado = live.filter((o) => ['pagado', 'enviado', 'entregado'].includes(o.status));
    const today = cobrado.filter((o) => dayKey(o.paid_at || o.created_at) === new Date().toDateString());
    const prendas = cobrado.reduce((s, o) => s + o.items.reduce((a, i) => a + i.qty, 0), 0);
    const tile = (label: string, n: string | number, sub = '') =>
      `<div class="pd-stat"><span>${label}</span><b>${n}</b>${sub ? `<small>${sub}</small>` : ''}</div>`;
    $('[data-stats]').innerHTML =
      tile('Cobrado', eur(cobrado.reduce((s, o) => s + o.total_cents, 0)), `${cobrado.length} pedidos`) +
      tile('Hoy', eur(today.reduce((s, o) => s + o.total_cents, 0)), `${today.length} pedidos`) +
      tile('Prendas vendidas', prendas) +
      tile('Ticket medio', cobrado.length ? eur(Math.round(cobrado.reduce((s, o) => s + o.total_cents, 0) / cobrado.length)) : '—');
  }

  function renderTally() {
    const live = orders.filter((o) => o.status !== 'cancelado');
    const rows = new Map<string, { name: string; sizes: Record<string, number>; paid: number }>();
    for (const s of stock) rows.set(s.product_id, { name: s.name, sizes: {}, paid: 0 });
    for (const o of live) for (const it of o.items) {
      if (!it.presale) continue;
      const r = rows.get(it.product_id) ?? { name: it.name, sizes: {}, paid: 0 };
      r.sizes[it.size] = (r.sizes[it.size] || 0) + it.qty;
      if (o.status !== 'pendiente') r.paid += it.qty;
      rows.set(it.product_id, r);
    }
    if (!rows.size) { $('[data-tally]').innerHTML = '<p class="pd-empty">Aún no hay ventas de preventa.</p>'; return; }
    const st = new Map(stock.map((s) => [s.product_id, s]));
    const totals: Record<string, number> = {};
    const body = [...rows.entries()].map(([id, r]) => {
      const tot = SIZES.reduce((a, z) => a + (r.sizes[z] || 0), 0);
      SIZES.forEach((z) => (totals[z] = (totals[z] || 0) + (r.sizes[z] || 0)));
      const s = st.get(id);
      return `<tr><td>${esc(r.name)}</td>${SIZES.map((z) => `<td class="${r.sizes[z] ? '' : 'zero'}">${r.sizes[z] || 0}</td>`).join('')}
        <td class="tot">${tot}</td><td>${r.paid}</td><td>${s ? `${s.stock}/${s.initial}` : '—'}</td></tr>`;
    }).join('');
    const all = SIZES.reduce((a, z) => a + totals[z], 0);
    $('[data-tally]').innerHTML = `<div class="pd-tally-wrap"><table>
      <thead><tr><th>Modelo</th>${SIZES.map((z) => `<th>${z}</th>`).join('')}<th>Total</th><th>Pagadas</th><th>Quedan</th></tr></thead>
      <tbody>${body}<tr><td><b>Total</b></td>${SIZES.map((z) => `<td>${totals[z]}</td>`).join('')}<td class="tot">${all}</td><td></td><td></td></tr></tbody>
    </table></div>`;
  }

  function render() { renderTodo(); renderChips(); renderList(); renderStats(); renderTally(); }

  async function act(code: string, status: string, btn: HTMLButtonElement) {
    const o = orders.find((x) => x.code === code)!;
    let tracking: string | undefined;
    if (status === 'pagado' && !confirm(`¿Te han llegado ${eur(o.total_cents)} de ${o.name}?\nSe le manda el correo de pago recibido.`)) return;
    if (status === 'cancelado' && !confirm(`¿Cancelar el pedido de ${o.name} (${code})?\nLas unidades de preventa vuelven al stock y se le manda un correo.${o.status === 'pagado' && o.payment === 'tarjeta' ? '\n\nOjo: ya está cobrado. Devuélvele el dinero en Stripe.' : ''}`)) return;
    if (status === 'recordatorio' && !confirm(`¿Mandar a ${o.email} un recordatorio de pago?`)) return;
    if (status === 'borrar' && !confirm(`¿Borrar para siempre el pedido de ${o.name} (${code})?\nNo se puede deshacer.`)) return;
    if (status === 'enviado') {
      const t = prompt(`Pedido de ${o.name} enviado.\nNúmero o enlace de seguimiento (opcional):`, o.tracking || '');
      if (t === null) return;
      tracking = t;
    }
    btn.disabled = true;
    try {
      if (status === 'borrar') {
        await api('POST', { code, action: 'borrar' });
        orders = orders.filter((x) => x.code !== code);
        open.delete(code);
        render();
        toast(`${code} borrado`);
        return;
      }
      const r = await api('POST', { code, status, tracking });
      const i = orders.findIndex((x) => x.code === code);
      if (r.order) orders[i] = r.order;
      if (status === 'cancelado') {
        const d = await api('GET'); orders = d.orders; stock = d.stock;
      }
      render();
      toast(r.email === 'enviado' ? `Hecho · correo enviado a ${o.name}` : r.email === 'error' ? 'Hecho, pero el correo ha fallado' : 'Hecho', r.email === 'error');
    } catch (e) {
      btn.disabled = false;
      toast(e instanceof Error ? e.message : 'Error', true);
    }
  }

  // ---- eventos ----
  $('[data-login]').addEventListener('submit', async (e) => {
    e.preventDefault();
    const input = $<HTMLInputElement>('#pd-pin');
    const err = $('[data-login-err]');
    pin = input.value.trim();
    err.hidden = true;
    try {
      await load();
      try { sessionStorage.setItem('iso_staff_pin', pin); } catch {}
      enter();
    } catch (x) {
      err.textContent = x instanceof Error ? x.message : 'Error'; err.hidden = false;
    }
  });

  function enter() {
    $('[data-login]').hidden = true; $('[data-app]').hidden = false; $('[data-when-in]').hidden = false;
    // La próxima vez, "nuevo" = lo que llegue a partir de ahora
    try { localStorage.setItem('iso_pd_seen', String(Date.now())); } catch {}
  }

  $('[data-logout]').addEventListener('click', logout);
  $('[data-refresh]').addEventListener('click', () => load().then(() => toast('Actualizado')).catch((e) => toast(e.message, true)));
  $('[data-search]').addEventListener('input', (e) => { query = (e.target as HTMLInputElement).value; shown = PAGE; renderList(); });
  $('[data-more]').addEventListener('click', () => { shown += PAGE; renderList(); });
  // Recordar qué pedidos están abiertos (para que no se cierren al actualizar)
  document.addEventListener('toggle', (e) => {
    const d = e.target as HTMLDetailsElement;
    if (!d.classList?.contains('pd-row')) return;
    d.open ? open.add(d.dataset.code!) : open.delete(d.dataset.code!);
  }, true);
  document.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    const chip = t.closest<HTMLButtonElement>('[data-filter]');
    if (chip) {
      filter = chip.dataset.filter!; shown = PAGE; renderChips(); renderList();
      if (chip.closest('[data-todo]')) $('[data-chips]').scrollIntoView({ behavior: 'smooth', block: 'start' });
      return;
    }
    const a = t.closest<HTMLButtonElement>('[data-act]');
    if (a) { act(a.dataset.code!, a.dataset.act!, a); return; }
    const c = t.closest<HTMLButtonElement>('[data-copy]');
    if (c) navigator.clipboard?.writeText(c.dataset.copy!).then(() => toast('Dirección copiada')).catch(() => {});
  });

  if (pin) load().then(enter).catch(() => logout());
  // Se actualiza solo cada minuto mientras está abierto
  setInterval(() => { if (pin && !document.hidden) load().catch(() => {}); }, 60000);
</script>
