---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import HeroISO from '../components/HeroISO.astro';
import TournamentRecap from '../components/TournamentRecap.astro';
import About from '../components/About.astro';
import RackReact from '../components/RackReact.tsx';
import { ISO_CLASSICS } from '../data/isolation-drop';
// Orden en el perchero: camiseta negra, sudadera gris, camiseta blanca, camiseta gris, sudadera negra
const RACK_ORDER = [0, 4, 1, 2, 3].map((i) => ISO_CLASSICS[i]);
import Footer from '../components/Footer.astro';
---

<Layout>
  <Navbar />
  <main>
    <HeroISO />
    <div id="perchero">
      <RackReact client:visible products={RACK_ORDER} title="" />
    </div>
    <TournamentRecap />
    <About />
  </main>
  <Footer />
</Layout>