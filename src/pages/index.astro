---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import HeroISO from '../components/HeroISO.astro';
import TournamentRecap from '../components/TournamentRecap.astro';
import About from '../components/About.astro';
import RackReact from '../components/RackReact.tsx';
import { ISO_CLASSICS } from '../data/isolation-drop';
import Footer from '../components/Footer.astro';
---

<Layout>
  <Navbar />
  <main>
    <HeroISO />
    <TournamentRecap />
    <div id="perchero">
      <RackReact client:visible products={ISO_CLASSICS} title="El perchero" />
    </div>
    <About />
  </main>
  <Footer />
</Layout>