---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import RackReact from '../components/RackReact.tsx';
import { ISO_CLASSICS } from '../data/isolation-drop';
import Footer from '../components/Footer.astro';
---

<Layout
  title="ISO — Colección"
  description="Camisetas y sudaderas ISO con el logo clásico. Envío gratis en Santander."
  image="/rack/classic-tee-black-front.webp"
>
  <Navbar />
  <main class="collection-main">
    <RackReact client:load products={ISO_CLASSICS} title="Colección" />
  </main>
  <Footer />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Product",
    "name": "ISO Classic Tee",
    "description": "Camiseta oversize con el logo de ISO en el pecho.",
    "image": "https://isowear.es/rack/classic-tee-black-front.webp",
    "brand": { "@type": "Brand", "name": "ISO" },
    "offers": {
      "@type": "Offer",
      "url": "https://isowear.es/collection",
      "priceCurrency": "EUR",
      "price": "19.99",
      "availability": "https://schema.org/InStock"
    }
  })} />
</Layout>

<style>
  .collection-main {
    padding-top: var(--nav-h);
  }
</style>
