---
import Layout from '../layouts/Layout.astro';
---

<Layout title="ISO — Validar entrada" description="Panel de validación de invitaciones">
  <main class="scan-page">
    <div class="gate" id="gate">
      <p class="eyebrow">Staff · Puerta</p>
      <h1>Acceso restringido</h1>
      <p class="gate-desc">Introduce el código de acceso del staff</p>
      <form id="gate-form">
        <input type="password" id="gate-code" placeholder="Código de acceso" autocomplete="off" inputmode="text" />
        <button type="submit">Entrar</button>
      </form>
      <p class="gate-error" id="gate-error"></p>
    </div>

    <div class="app" id="app" hidden>
      <div class="scan-header">
        <p class="eyebrow">Staff · Puerta</p>
        <h1>Validar entrada</h1>
      </div>

      <div class="stats-panel" id="stats-panel">
        <div class="stat">
          <span class="stat-value" id="stat-inside">–</span>
          <span class="stat-label">Dentro</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat">
          <span class="stat-value" id="stat-remaining">–</span>
          <span class="stat-label">Quedan</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat">
          <span class="stat-value" id="stat-total">–</span>
          <span class="stat-label">Aforo total</span>
        </div>
      </div>

      <div id="reader"></div>

      <div id="result" class="result idle">
        <p class="result-main">Apunta al QR de la invitación</p>
      </div>

      <details class="manual-entry">
        <summary>Introducir código a mano</summary>
        <form id="manual-form">
          <input type="text" id="manual-code" placeholder="Código de la invitación" autocomplete="off" />
          <button type="submit">Validar</button>
        </form>
      </details>
    </div>
  </main>
</Layout>

<style>
  .scan-page {
    min-height: 100dvh;
    background: var(--bg);
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 2rem 1.25rem 3rem;
    gap: 1.5rem;
  }

  .gate {
    width: 100%;
    max-width: 360px;
    margin: auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }
  .gate-desc {
    font-size: 0.85rem;
    color: var(--muted-light);
    margin-bottom: 0.5rem;
  }
  #gate-form {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  #gate-code {
    background: var(--surface);
    border: 1px solid var(--border-light);
    color: var(--white);
    padding: 0.9rem 1rem;
    font-family: var(--font-body);
    font-size: 1rem;
    text-align: center;
    letter-spacing: 0.05em;
  }
  #gate-form button {
    background: var(--accent);
    color: var(--accent-dark);
    font-weight: 700;
    padding: 0.9rem 1.1rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .gate-error {
    color: #e37e7e;
    font-size: 0.8rem;
    min-height: 1.2em;
  }

  .app {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  .scan-header { text-align: center; }
  .eyebrow {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.4rem;
  }
  h1 {
    font-family: var(--font-display);
    font-weight: 900;
    font-style: italic;
    font-size: 1.8rem;
    text-transform: uppercase;
  }

  .stats-panel {
    width: 100%;
    max-width: 420px;
    display: flex;
    align-items: center;
    justify-content: space-around;
    background: var(--surface);
    border: 1px solid var(--border-light);
    padding: 0.9rem 0.5rem;
  }
  .stat { display: flex; flex-direction: column; align-items: center; gap: 0.15rem; }
  .stat-value {
    font-family: var(--font-display);
    font-weight: 900;
    font-style: italic;
    font-size: 1.5rem;
    color: var(--white);
  }
  .stat-value.warn { color: #e3b04b; }
  .stat-value.critical { color: #e37e7e; }
  .stat-label {
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted-light);
  }
  .stat-divider { width: 1px; height: 2rem; background: var(--border-light); }

  #reader {
    width: 100%;
    max-width: 420px;
    border: 1px solid var(--border-light);
    overflow: hidden;
  }

  .result {
    width: 100%;
    max-width: 420px;
    padding: 1.5rem;
    text-align: center;
    border: 2px solid var(--border-light);
    transition: border-color 0.15s, background 0.15s;
  }
  .result-main {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.3rem;
    text-transform: uppercase;
  }
  .result-sub {
    font-size: 0.85rem;
    color: var(--muted-light);
    margin-top: 0.4rem;
  }
  .result.idle { border-color: var(--border-light); }
  .result.valid { border-color: #22c55e; background: rgba(34, 197, 94, 0.14); }
  .result.valid .result-main { color: #22c55e; }
  .result.invalid { border-color: #e37e7e; background: rgba(227, 126, 126, 0.12); }
  .result.invalid .result-main { color: #e37e7e; }

  .manual-entry {
    width: 100%;
    max-width: 420px;
    color: var(--muted-light);
    font-size: 0.85rem;
  }
  .manual-entry summary { cursor: pointer; }
  #manual-form {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.75rem;
  }
  #manual-code {
    flex: 1;
    background: var(--surface);
    border: 1px solid var(--border-light);
    color: var(--white);
    padding: 0.7rem 0.9rem;
    font-family: var(--font-body);
  }
  #manual-form button {
    background: var(--accent);
    color: var(--accent-dark);
    font-weight: 700;
    padding: 0.7rem 1.1rem;
  }
</style>

<script>
  // @ts-nocheck
  import { Html5Qrcode } from 'html5-qrcode';

  const gateEl = document.getElementById('gate');
  const appEl = document.getElementById('app');
  const gateForm = document.getElementById('gate-form');
  const gateInput = document.getElementById('gate-code');
  const gateError = document.getElementById('gate-error');

  const resultEl = document.getElementById('result');
  const manualForm = document.getElementById('manual-form');
  const manualInput = document.getElementById('manual-code');
  const statInside = document.getElementById('stat-inside');
  const statRemaining = document.getElementById('stat-remaining');
  const statTotal = document.getElementById('stat-total');

  let busy = false;
  let lastCode = '';
  let lastCodeTime = 0;
  let scannerStarted = false;
  const scanner = new Html5Qrcode('reader');

  const STORAGE_KEY = 'iso_staff_passcode';

  function callValidar(code, passcode) {
    return fetch('/api/validar', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'x-staff-passcode': passcode },
      body: JSON.stringify({ code }),
    });
  }

  async function tryUnlock(passcode, { silent = false } = {}) {
    try {
      const res = await callValidar('__stats_only__', passcode);
      if (res.status === 401) {
        if (!silent) gateError.textContent = 'Código incorrecto';
        localStorage.removeItem(STORAGE_KEY);
        return false;
      }
      const data = await res.json();
      localStorage.setItem(STORAGE_KEY, passcode);
      gateEl.style.display = 'none';
      appEl.hidden = false;
      updateStats(data.stats);
      startScannerOnce();
      return true;
    } catch {
      if (!silent) gateError.textContent = 'Error de red, inténtalo de nuevo';
      return false;
    }
  }

  gateForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    gateError.textContent = '';
    const passcode = gateInput.value.trim();
    if (passcode) tryUnlock(passcode);
  });

  // Si ya se desbloqueó antes en este dispositivo, entra directo
  const savedPasscode = localStorage.getItem(STORAGE_KEY);
  if (savedPasscode) tryUnlock(savedPasscode, { silent: true });

  function updateStats(stats) {
    if (!stats || stats.used == null || stats.total == null) return;
    const remaining = stats.total - stats.used;
    statInside.textContent = stats.used;
    statRemaining.textContent = remaining;
    statTotal.textContent = stats.total;

    statRemaining.className = 'stat-value';
    if (remaining <= 10) statRemaining.className = 'stat-value critical';
    else if (remaining <= 30) statRemaining.className = 'stat-value warn';
  }
  let audioCtx;
  function getAudioCtx() {
    if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
    if (audioCtx.state === 'suspended') audioCtx.resume();
    return audioCtx;
  }

  function playTone(ctx, freq, startTime, duration, type = 'sine', peakGain = 0.18) {
    const osc = ctx.createOscillator();
    const gain = ctx.createGain();
    osc.type = type;
    osc.frequency.value = freq;
    osc.connect(gain);
    gain.connect(ctx.destination);

    gain.gain.setValueAtTime(0, startTime);
    gain.gain.linearRampToValueAtTime(peakGain, startTime + 0.015);
    gain.gain.exponentialRampToValueAtTime(0.001, startTime + duration);

    osc.start(startTime);
    osc.stop(startTime + duration + 0.02);
  }

  function playSuccessSound() {
    try {
      const ctx = getAudioCtx();
      const now = ctx.currentTime;
      // Ding ascendente de dos notas — alegre y corto
      playTone(ctx, 880, now, 0.13, 'sine', 0.2);
      playTone(ctx, 1318.5, now + 0.09, 0.22, 'sine', 0.2);
    } catch {}
  }

  function playErrorSound() {
    try {
      const ctx = getAudioCtx();
      const now = ctx.currentTime;
      // Doble zumbido grave — claramente "mal"
      playTone(ctx, 180, now, 0.16, 'square', 0.12);
      playTone(ctx, 160, now + 0.19, 0.22, 'square', 0.12);
    } catch {}
  }

  function beep(ok) {
    if (ok) playSuccessSound();
    else playErrorSound();
    if (navigator.vibrate) navigator.vibrate(ok ? 80 : [80, 60, 80]);
  }

  function showResult(state, main, sub) {
    resultEl.className = `result ${state}`;
    resultEl.innerHTML = `<p class="result-main">${main}</p>${sub ? `<p class="result-sub">${sub}</p>` : ''}`;
  }

  async function validarCodigo(code) {
    if (!code || busy) return;

    // Evita doble disparo si la cámara lee el mismo QR varias veces seguidas
    const now = Date.now();
    if (code === lastCode && now - lastCodeTime < 3000) return;
    lastCode = code;
    lastCodeTime = now;

    busy = true;
    showResult('idle', 'Comprobando...');

    try {
      const passcode = localStorage.getItem(STORAGE_KEY) || '';
      const res = await callValidar(code, passcode);

      if (res.status === 401) {
        showResult('invalid', '✕ Sesión caducada', 'Vuelve a introducir el código de staff');
        localStorage.removeItem(STORAGE_KEY);
        appEl.hidden = true;
        gateEl.style.display = '';
        return;
      }

      const data = await res.json();

      if (data.valid) {
        showResult('valid', `✓ Invitación #${data.invite_number}`, data.name || 'Acceso permitido');
        beep(true);
      } else if (data.reason === 'ya_usada') {
        const hora = data.used_at
          ? new Date(data.used_at).toLocaleTimeString('es-ES', { hour: '2-digit', minute: '2-digit' })
          : null;
        showResult(
          'invalid',
          '✕ Ya usada',
          hora ? `Invitación #${data.invite_number} · entró a las ${hora}` : `Invitación #${data.invite_number}`
        );
        beep(false);
      } else {
        showResult('invalid', '✕ Código no válido', 'Esta invitación no existe');
        beep(false);
      }
      updateStats(data.stats);
    } catch (err) {
      showResult('invalid', '✕ Error de red', 'Reintenta en un momento');
      beep(false);
    } finally {
      setTimeout(() => { busy = false; }, 900);
    }
  }

  manualForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    const code = manualInput.value.trim();
    manualInput.value = '';
    validarCodigo(code);
  });

  function startScannerOnce() {
    if (scannerStarted) return;
    scannerStarted = true;
    scanner
      .start(
        { facingMode: 'environment' },
        { fps: 10, qrbox: { width: 250, height: 250 } },
        (decodedText) => validarCodigo(decodedText)
      )
      .catch(() => {
        showResult('invalid', 'No se pudo abrir la cámara', 'Usa el código manual de abajo');
      });
  }
</script>
