---
---

<section class="event-cd">
  <div class="bg-grain" aria-hidden="true"></div>

  <div class="event-inner">
    <p class="eyebrow">
      <span class="line" aria-hidden="true"></span>
      Torneo 1v1 · Cantabria
    </p>

    <h2 class="event-title">
      <span class="outline-text">El evento</span><br />
      <span class="filled-text">del año.</span>
    </h2>

    <p class="event-desc">
      Sábado 1 de agosto · 17:00 — el primer torneo 1v1 de ISO para encontrar
      al mejor jugador de Cantabria.
    </p>

    <div class="countdown" id="event-countdown" aria-label="Tiempo restante hasta el evento">
      <div class="cd-unit">
        <span class="cd-num" id="ecd-days">00</span>
        <span class="cd-label">Días</span>
      </div>
      <span class="cd-sep" aria-hidden="true">:</span>
      <div class="cd-unit">
        <span class="cd-num" id="ecd-hours">00</span>
        <span class="cd-label">Horas</span>
      </div>
      <span class="cd-sep" aria-hidden="true">:</span>
      <div class="cd-unit">
        <span class="cd-num" id="ecd-min">00</span>
        <span class="cd-label">Min</span>
      </div>
      <span class="cd-sep" aria-hidden="true">:</span>
      <div class="cd-unit">
        <span class="cd-num" id="ecd-sec">00</span>
        <span class="cd-label">Seg</span>
      </div>
    </div>

    <p id="event-live-msg" class="event-live-msg" hidden>Estamos en ello ahora mismo 🏀</p>
  </div>
</section>

<style>
  .event-cd {
    position: relative;
    padding: clamp(3.5rem, 8vw, 6rem) var(--pad);
    background: var(--surface);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    overflow: hidden;
  }

  .bg-grain {
    position: absolute;
    inset: 0;
    z-index: 0;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.04'/%3E%3C/svg%3E");
    pointer-events: none;
    opacity: 0.6;
  }

  .event-inner {
    position: relative;
    z-index: 1;
    max-width: var(--max-w);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 1.25rem;
  }
  .line {
    display: inline-block;
    width: 1.75rem;
    height: 1px;
    background: var(--accent);
  }

  .event-title {
    font-family: var(--font-display);
    font-weight: 900;
    font-style: italic;
    font-size: clamp(2.75rem, 7vw, 5rem);
    line-height: 0.95;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    margin-bottom: 1.25rem;
  }
  .outline-text {
    color: transparent;
    -webkit-text-stroke: 1.5px var(--white);
  }
  .filled-text {
    color: var(--white);
  }

  .event-desc {
    font-size: 0.95rem;
    color: var(--muted-light);
    line-height: 1.6;
    max-width: 40ch;
    margin-bottom: 2.5rem;
  }

  /* Countdown — mismo lenguaje visual que el resto del sitio */
  .countdown {
    display: flex;
    align-items: flex-end;
    gap: 0.6rem;
  }

  .countdown[hidden] {
    display: none;
  }

  .cd-unit {
    display: flex;
    flex-direction: column;
    align-items: center;
    background: var(--bg);
    border: 1px solid var(--border-light);
    padding: 0.9rem 1.6rem;
    min-width: 96px;
  }

  .cd-num {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(2.4rem, 5vw, 3.4rem);
    color: var(--accent);
    letter-spacing: -0.02em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .cd-label {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted-light);
    margin-top: 0.4rem;
  }

  .cd-sep {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(2.2rem, 4.5vw, 3rem);
    color: var(--muted);
    padding-bottom: 0.75rem;
    line-height: 1;
  }

  .event-live-msg {
    font-family: var(--font-display);
    font-weight: 700;
    font-style: italic;
    font-size: 1.5rem;
    color: var(--accent);
    text-transform: uppercase;
  }

  /* ========== RESPONSIVE ========== */
  @media (max-width: 480px) {
    .countdown {
      gap: 0.35rem;
      width: 100%;
      justify-content: center;
    }

    .cd-unit {
      min-width: 0;
      flex: 1;
      max-width: 90px;
      padding: 0.6rem 0.4rem;
    }

    .cd-num {
      font-size: clamp(1.6rem, 7vw, 2.2rem);
    }

    .cd-label {
      font-size: 0.55rem;
      letter-spacing: 0.06em;
    }

    .cd-sep {
      font-size: clamp(1.6rem, 7vw, 2.2rem);
      padding-bottom: 0.5rem;
    }
  }
</style>

<script>
  function startEventCountdown() {
    const countdown = document.getElementById('event-countdown');
    if (!countdown) return;

    // Sábado 1 de agosto de 2026, 17:00 hora local
    const end = new Date(2026, 7, 1, 17, 0, 0, 0);

    const daysEl = document.getElementById('ecd-days');
    const hoursEl = document.getElementById('ecd-hours');
    const minEl = document.getElementById('ecd-min');
    const secEl = document.getElementById('ecd-sec');
    const liveMsg = document.getElementById('event-live-msg');

    function update() {
      const now = new Date();
      const diff = end.getTime() - now.getTime();

      if (diff <= 0) {
        countdown.hidden = true;
        if (liveMsg) liveMsg.hidden = false;
        return;
      }

      const totalSeconds = Math.floor(diff / 1000);
      const d = Math.floor(totalSeconds / 86400);
      const h = Math.floor(totalSeconds / 3600) % 24;
      const m = Math.floor(totalSeconds / 60) % 60;
      const s = totalSeconds % 60;

      const pad = (n: number) => String(n).padStart(2, '0');

      if (daysEl) daysEl.textContent = pad(d);
      if (hoursEl) hoursEl.textContent = pad(h);
      if (minEl) minEl.textContent = pad(m);
      if (secEl) secEl.textContent = pad(s);
    }

    update();
    setInterval(update, 1000);
  }

  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    startEventCountdown();
  } else {
    document.addEventListener('DOMContentLoaded', startEventCountdown);
  }
</script>