---
const product = {
  id: 2,
  name: "ISO Tee Core",
  category: "Camiseta",
  price: "€24,99",
  tag: "Bestseller",
  sizes: ["S","M","L"]
};
---

<section class="products" id="collection">
  <div class="section-header">
    <div class="header-left">
      <p class="section-eyebrow">
        <span class="line"></span>
        Essentials
      </p>
      <h2 class="section-title">La Colección</h2>
    </div>
  </div>

  <div class="products-grid">
    <article class="product-card">
      <div class="card-image">
        <img src="/camiseta1.png" alt={product.name} loading="lazy" />
        <span class="card-tag">{product.tag}</span>
      </div>

      <div class="card-info">
        <div class="card-top">
          <div>
            <p class="card-category">{product.category}</p>
            <h3 class="card-name">{product.name}</h3>
          </div>
          <span class="card-price">{product.price}</span>
        </div>

        <div class="card-sizes">
          {product.sizes.map(s => <span class="size">{s}</span>)}
        </div>

        <button class="card-btn">Añadir al carrito</button>
      </div>
    </article>
  </div>
</section>

<style>
  .products {
    padding: 6rem 3rem;
    border-top: 1px solid var(--border);
  }

  .section-header {
    margin-bottom: 3rem;
  }

  .section-eyebrow {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.75rem;
  }

  .line {
    width: 2rem;
    height: 1px;
    background: var(--accent);
  }

  .section-title {
    font-family: var(--font-display);
    font-weight: 900;
    font-style: italic;
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    text-transform: uppercase;
    color: var(--white);
  }

  /* 👇 centramos una sola card */
  .products-grid {
    display: flex;
    justify-content: center;
  }

  .product-card {
    max-width: 320px;
    width: 100%;
    background: var(--surface);
    display: flex;
    flex-direction: column;
    transition: background 0.2s;
  }

  .product-card:hover {
    background: var(--surface2);
  }

  .card-image {
    position: relative;
    aspect-ratio: 3/4;
    background: var(--bg);
    overflow: hidden;
  }

  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 1rem;
    transition: transform 0.35s ease;
  }

  .product-card:hover .card-image img {
    transform: scale(1.05);
  }

  .card-tag {
    position: absolute;
    top: 1rem;
    left: 1rem;
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--bg);
    background: var(--accent);
    padding: 0.3rem 0.6rem;
  }

  .card-info {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    border-top: 1px solid var(--border);
  }

  .card-top {
    display: flex;
    justify-content: space-between;
  }

  .card-category {
    font-size: 0.6rem;
    letter-spacing: 0.18em;
    color: var(--muted);
  }

  .card-name {
    font-family: var(--font-display);
    font-size: 1rem;
    text-transform: uppercase;
    color: var(--white);
  }

  .card-price {
    font-family: var(--font-display);
    font-weight: 900;
    color: var(--accent);
  }

  .card-sizes {
    display: flex;
    gap: 0.4rem;
  }

  .size {
    font-size: 0.6rem;
    border: 1px solid var(--border);
    padding: 0.2rem 0.45rem;
    cursor: pointer;
  }

  .size:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .card-btn {
    width: 100%;
    background: transparent;
    border: 1px solid var(--border);
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    padding: 0.75rem;
    transition: all 0.2s;
  }

  .card-btn:hover {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--bg);
  }
</style>