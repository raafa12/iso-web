---
const products = [
  {
    id: "iso-icon-tee",
    name: "ISO Icon Tee",
    category: "Camiseta",
    price: "€24,99",
    priceNum: 2499, // céntimos para Stripe
    tag: "Bestseller",
    sizes: ["XS","S","M","L","XL"],
    description: "100% algodón heavyweight. Silueta oversize. Bordado en pecho."
  }
];
---

<section class="products" id="collection">
  <div class="section-head">
    <div class="head-left">
      
      <h2 class="section-title">La Colección</h2>
    </div>
  </div>

  <div class="products-grid">
    {products.map((p) => (
      <article class="product-card" data-id={p.id}>
        <!-- Image -->
        <div class="card-image">
          <img
            src="/camiseta1.png"
            alt={p.name}
            loading="lazy"
            width="400"
            height="500"
          />
          <span class="card-tag">{p.tag}</span>
          <div class="card-overlay">
            <p class="overlay-desc">{p.description}</p>
          </div>
        </div>

        <!-- Info -->
        <div class="card-body">
          <div class="card-header">
            <div>
              <p class="card-cat">{p.category}</p>
              <h3 class="card-name">{p.name}</h3>
            </div>
            <span class="card-price">{p.price}</span>
          </div>

          <!-- Size selector -->
          <div class="size-selector" role="group" aria-label="Elige tu talla">
            <p class="size-label">Talla</p>
            <div class="sizes">
              {p.sizes.map((s, i) => (
                <button
                  class={`size-btn ${i === 2 ? 'active' : ''}`}
                  data-size={s}
                  aria-pressed={i === 2 ? "true" : "false"}
                >
                  {s}
                </button>
              ))}
            </div>
            <a href="#" class="size-guide-link">Guía de tallas →</a>
          </div>

          <!-- Buy options -->
          <div class="buy-options">
            <!-- Stripe checkout -->
            <button
              class="btn-buy btn-stripe"
              data-product={p.id}
              data-price={p.priceNum}
              aria-label={`Comprar ${p.name} por ${p.price}`}
            >
              Comprar — {p.price}
            </button>

            <!-- WhatsApp -->
            <a
              href={`https://wa.me/34600000000?text=${encodeURIComponent(`Hola! Quiero comprar: ${p.name}. Talla: M. ¿Está disponible?`)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-buy btn-whatsapp"
              aria-label="Pedir por WhatsApp"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
                <path d="M12 0C5.373 0 0 5.373 0 12c0 2.123.554 4.116 1.522 5.845L.057 23.57a.5.5 0 0 0 .609.61l5.79-1.518A11.94 11.94 0 0 0 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 22c-1.877 0-3.647-.48-5.19-1.323l-.37-.217-3.838 1.006 1.024-3.74-.237-.386A9.944 9.944 0 0 1 2 12c0-5.514 4.486-10 10-10s10 4.486 10 10-4.486 10-10 10z"/>
              </svg>
              Pedir por WhatsApp
            </a>
          </div>

          <!-- Trust signals -->
          <div class="trust">
            <span class="trust-item">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12l5 5L20 7"/></svg>
              Envío gratis en cantabria
            </span>
            <span class="trust-item">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg>
              Devoluciones gratis
            </span>
          </div>
        </div>
      </article>
    ))}
  </div>

  <div class="ticker" aria-hidden="true">
    <div class="ticker-track">
      {Array(12).fill(null).map(() => (
        <span>ISO Drop 001 — Edición Limitada — 100 Unidades — </span>
      ))}
    </div>
  </div>
</section>

<style>
  .products {
    padding: clamp(3rem, 6vw, 6rem) var(--pad);
    border-top: 1px solid var(--border);
  }

  .section-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
    flex-wrap: wrap;
    gap: 1rem;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.5rem;
  }

  .line {
    display: inline-block;
    width: 1.75rem;
    height: 1px;
    background: var(--accent);
  }

  .section-title {
    font-family: var(--font-display);
    font-weight: 900;
    font-style: italic;
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    text-transform: uppercase;
    color: var(--white);
    letter-spacing: -0.02em;
    line-height: 0.9;
  }

  .head-note {
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted-light);
    border: 1px solid var(--border-light);
    padding: 0.4rem 0.8rem;
    align-self: flex-end;
  }

  /* ---- GRID — single card centered on big screens ---- */
  .products-grid {
    display: flex;
    justify-content: center;
  }

  /* ---- CARD ---- */
  .product-card {
    width: 100%;
    max-width: 480px;
    background: var(--surface);
    border: 1px solid var(--border);
    transition: border-color 0.25s;
  }
  .product-card:hover {
    border-color: var(--border-light);
  }

  /* Image */
  .card-image {
    position: relative;
    aspect-ratio: 4/5;
    background: var(--bg);
    overflow: hidden;
  }

  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 1.5rem;
    transition: transform 0.45s ease;
  }
  .product-card:hover .card-image img {
    transform: scale(1.05);
  }

  .card-tag {
    position: absolute;
    top: 1rem;
    left: 1rem;
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--bg);
    background: var(--accent);
    padding: 0.28rem 0.6rem;
    z-index: 1;
  }

  .card-overlay {
    position: absolute;
    inset: 0;
    background: rgba(7, 7, 7, 0.85);
    display: flex;
    align-items: flex-end;
    padding: 1.5rem;
    opacity: 0;
    transition: opacity 0.3s;
  }
  .product-card:hover .card-overlay {
    opacity: 1;
  }

  .overlay-desc {
    font-size: 0.85rem;
    font-weight: 300;
    color: var(--white);
    line-height: 1.65;
  }

  /* Body */
  .card-body {
    padding: 1.5rem;
    border-top: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
  }

  .card-cat {
    font-size: 0.58rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 0.2rem;
  }

  .card-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.25rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--white);
    line-height: 1;
  }

  .card-price {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 1.75rem;
    color: var(--accent);
    letter-spacing: -0.02em;
    flex-shrink: 0;
  }

  /* Size selector */
  .size-selector {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .size-label {
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted-light);
  }

  .sizes {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .size-btn {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted-light);
    border: 1px solid var(--border);
    transition: all 0.15s;
    touch-action: manipulation;
  }

  .size-btn:hover {
    border-color: var(--white);
    color: var(--white);
  }

  .size-btn.active {
    border-color: var(--accent);
    color: var(--accent);
    background: var(--accent-glow);
  }

  .size-btn[aria-pressed="true"] {
    border-color: var(--accent);
    color: var(--accent);
    background: var(--accent-glow);
  }

  .size-guide-link {
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted-light);
    border-bottom: 1px solid var(--border);
    padding-bottom: 1px;
    width: fit-content;
    transition: color 0.2s, border-color 0.2s;
  }
  .size-guide-link:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  /* Buy options */
  .buy-options {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .btn-buy {
    width: 100%;
    padding: 1rem 1.5rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.9rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    transition: all 0.2s;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    touch-action: manipulation;
  }

  .btn-stripe {
    background: var(--accent);
    color: var(--accent-dark);
    border: 1px solid var(--accent);
  }
  .btn-stripe:hover {
    background: var(--accent-dim);
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(126, 200, 227, 0.18);
  }
  .btn-stripe:active {
    transform: translateY(0);
  }

  .btn-whatsapp {
    background: transparent;
    color: var(--muted-light);
    border: 1px solid var(--border);
    font-size: 0.8rem;
    text-decoration: none;
  }
  .btn-whatsapp:hover {
    border-color: #25D366;
    color: #25D366;
  }

  /* Trust signals */
  .trust {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    padding-top: 0.75rem;
    border-top: 1px solid var(--border);
  }

  .trust-item {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.6rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted-light);
  }

  .trust-item svg {
    color: var(--accent);
    flex-shrink: 0;
  }

  .ticker {
    position: relative;
    border-top: 1px solid var(--border);
    overflow: hidden;
    padding: 0.35rem 0;
    background: var(--surface);
    margin-top: clamp(2rem, 4vw, 3.5rem);
  }

  .ticker-track {
    display: flex;
    white-space: nowrap;
    animation: ticker 28s linear infinite;
    will-change: transform;
  }

  .ticker-track span {
    font-family: var(--font-display);
    font-weight: 700;
    font-style: italic;
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted-light);
    flex-shrink: 0;
    padding: 0 1rem;
  }

  @keyframes ticker {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  /* ========== RESPONSIVE ========== */
  @media (max-width: 600px) {
    .products {
      padding: 2.5rem var(--pad);
    }

    .product-card {
      max-width: 100%;
    }

    .card-body {
      padding: 1.25rem;
    }

    .trust {
      gap: 0.75rem;
    }

    .trust-item {
      font-size: 0.55rem;
    }
  }
</style>

<script>
  // Size selector — interactive
  document.querySelectorAll('.size-selector').forEach(selector => {
    const btns = selector.querySelectorAll<HTMLButtonElement>('.size-btn');

    btns.forEach(btn => {
      btn.addEventListener('click', () => {
        btns.forEach(b => {
          b.classList.remove('active');
          b.setAttribute('aria-pressed', 'false');
        });
        btn.classList.add('active');
        btn.setAttribute('aria-pressed', 'true');
      });
    });
  });

  // Stripe buy button — conectar con tu backend/Stripe
  document.querySelectorAll<HTMLButtonElement>('.btn-stripe').forEach(btn => {
    btn.addEventListener('click', async () => {
      const card = btn.closest<HTMLElement>('.product-card');
      const activeSize = card?.querySelector<HTMLButtonElement>('.size-btn.active');
      const size = activeSize?.dataset.size || 'M';
      const productId = card?.dataset.id || '';

      // Feedback visual
      btn.textContent = 'Redirigiendo...';
      btn.disabled = true;

      try {
        // OPCIÓN A — Stripe Checkout (necesitas endpoint en tu backend)
        // const res = await fetch('/api/checkout', {
        //   method: 'POST',
        //   headers: { 'Content-Type': 'application/json' },
        //   body: JSON.stringify({ productId, size })
        // });
        // const { url } = await res.json();
        // window.location.href = url;

        // OPCIÓN B — Demo: abrir WhatsApp como fallback hasta tener Stripe
        const msg = `Hola! Quiero comprar: ISO Icon Tee. Talla: ${size}. ¿Está disponible?`;
        const waUrl = `https://wa.me/34600000000?text=${encodeURIComponent(msg)}`;
        window.open(waUrl, '_blank', 'noopener,noreferrer');

      } catch (err) {
        console.error('Checkout error:', err);
        btn.textContent = 'Error — Inténtalo de nuevo';
      } finally {
        setTimeout(() => {
          const price = card?.querySelector('.card-price')?.textContent || '';
          btn.textContent = `Comprar — ${price}`;
          btn.disabled = false;
        }, 2000);
      }
    });
  });

  // WhatsApp — actualizar talla en el enlace al cambiar
  document.querySelectorAll('.product-card').forEach(card => {
    const waBtn = card.querySelector<HTMLAnchorElement>('.btn-whatsapp');
    const sizeBtns = card.querySelectorAll<HTMLButtonElement>('.size-btn');
    const productName = card.querySelector('.card-name')?.textContent || 'producto';

    sizeBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const size = btn.dataset.size || 'M';
        if (waBtn) {
          const msg = `Hola! Quiero comprar: ${productName}. Talla: ${size}. ¿Está disponible?`;
          waBtn.href = `https://wa.me/34600000000?text=${encodeURIComponent(msg)}`;
        }
      });
    });
  });
</script>
