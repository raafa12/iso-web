---
const products = [
  {
    id: "iso-icon-tee",
    name: "ISO Icon Tee",
    category: "Camiseta",
    price: "€24,99",
    priceNum: 2499, // céntimos para Stripe
    tag: "Bestseller",
    sizes: ["XS","S","M","L","XL"],
    description: "100% algodón heavyweight. Silueta oversize. Bordado en pecho."
  }
];
---

<section class="products" id="collection">
  <div class="section-head">
    <div class="head-left">
      
      <h2 class="section-title">La Colección</h2>
    </div>
  </div>

  <div class="products-grid">
    {products.map((p) => (
      <article class="product-card" data-id={p.id}>
        <!-- Image -->
        <div class="card-image">
          <img
            src="/camiseta1.png"
            alt={p.name}
            loading="lazy"
            width="400"
            height="500"
          />
          <span class="card-tag">{p.tag}</span>
          <div class="card-overlay">
            <p class="overlay-desc">{p.description}</p>
          </div>
        </div>

        <!-- Info -->
        <div class="card-body">
          <div class="card-header">
            <div>
              <p class="card-cat">{p.category}</p>
              <h3 class="card-name">{p.name}</h3>
            </div>
            <span class="card-price">{p.price}</span>
          </div>

          <!-- Size selector -->
          <div class="size-selector" role="group" aria-label="Elige tu talla">
            <p class="size-label">Talla</p>
            <div class="sizes">
              {p.sizes.map((s, i) => (
                <button
                  class={`size-btn ${i === 2 ? 'active' : ''}`}
                  data-size={s}
                  aria-pressed={i === 2 ? "true" : "false"}
                >
                  {s}
                </button>
              ))}
            </div>
            <button type="button" class="size-guide-link" data-size-guide-open>Guía de tallas →</button>
          </div>

          <!-- Buy options -->
          <div class="buy-options">
            <!-- Stripe checkout -->
            <button
              class="btn-buy btn-add-cart"
              data-product={p.id}
              data-price={p.priceNum}
              data-name={p.name}
              data-price-display={p.price}
              aria-label={`Añadir ${p.name} al carrito`}
            >
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="9" cy="21" r="1"/>
                <circle cx="20" cy="21" r="1"/>
                <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
              </svg>
              <span class="buy-label">Añadir al carrito</span>
            </button>
          </div>

          <!-- Trust signals -->
          <div class="trust">
            <span class="trust-item">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12l5 5L20 7"/></svg>
              Envío gratis en cantabria
            </span>
            <span class="trust-item">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg>
              Devoluciones gratis
            </span>
          </div>
        </div>
      </article>
    ))}
  </div>

  <div class="ticker" aria-hidden="true">
  </div>
</section>

<!-- Size guide modal -->
<div id="size-guide-overlay" class="size-guide-overlay" hidden>
  <div class="size-guide-modal">
    <button type="button" id="size-guide-close" class="size-guide-close" aria-label="Cerrar guía de tallas">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
    </button>
    <h3>Guía de tallas</h3>
    <img src="/tallas.png" alt="Tabla de tallas ISO: ancho y largo en cm para XS, S, M, L, XL y 2XL" />
  </div>
</div>

<style>
 

  .section-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
    flex-wrap: wrap;
    gap: 1rem;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.5rem;
  }

  .line {
    display: inline-block;
    width: 1.75rem;
    height: 1px;
    background: var(--accent);
  }

  .section-title {
    font-family: var(--font-display);
    font-weight: 900;
    font-style: italic;
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    text-transform: uppercase;
    color: var(--white);
    letter-spacing: -0.02em;
    line-height: 0.9;
  }

  .head-note {
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted-light);
    border: 1px solid var(--border-light);
    padding: 0.4rem 0.8rem;
    align-self: flex-end;
  }

  /* ---- GRID — single card centered on big screens ---- */
  .products-grid {
    display: flex;
    justify-content: center;
  }

  /* ---- CARD ---- */
  .product-card {
    width: 100%;
    max-width: 480px;
    background: var(--surface);
    border: 1px solid var(--border);
    transition: border-color 0.25s;
  }
  .product-card:hover {
    border-color: var(--border-light);
  }

  /* Image */
  .card-image {
    position: relative;
    aspect-ratio: 4/5;
    background: var(--bg);
    overflow: hidden;
  }

  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 1.5rem;
    transition: transform 0.45s ease;
  }
  .product-card:hover .card-image img {
    transform: scale(1.05);
  }

  .card-tag {
    position: absolute;
    top: 1rem;
    left: 1rem;
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--bg);
    background: var(--accent);
    padding: 0.28rem 0.6rem;
    z-index: 1;
  }

  .card-overlay {
    position: absolute;
    inset: 0;
    background: rgba(7, 7, 7, 0.85);
    display: flex;
    align-items: flex-end;
    padding: 1.5rem;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s;
  }
  .product-card:hover .card-overlay {
    opacity: 1;
  }

  .overlay-desc {
    font-size: 0.85rem;
    font-weight: 300;
    color: var(--white);
    line-height: 1.65;
  }

  /* Body */
  .card-body {
    padding: 1.5rem;
    border-top: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
  }

  .card-cat {
    font-size: 0.58rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 0.2rem;
  }

  .card-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.25rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--white);
    line-height: 1;
  }

  .card-price {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 1.75rem;
    color: var(--accent);
    letter-spacing: -0.02em;
    flex-shrink: 0;
  }

  /* Size selector */
  .size-selector {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .size-label {
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted-light);
  }

  .sizes {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .size-btn {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted-light);
    border: 1px solid var(--border);
    transition: all 0.15s;
    touch-action: manipulation;
  }

  .size-btn:hover {
    border-color: var(--white);
    color: var(--white);
  }

  .size-btn.active {
    border-color: var(--accent);
    color: var(--accent);
    background: var(--accent-glow);
  }

  .size-btn[aria-pressed="true"] {
    border-color: var(--accent);
    color: var(--accent);
    background: var(--accent-glow);
  }

  .size-guide-link {
    background: none;
    font-family: inherit;
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted-light);
    border: none;
    border-bottom: 1px solid var(--border);
    padding-bottom: 1px;
    width: fit-content;
    cursor: pointer;
    transition: color 0.2s, border-color 0.2s;
  }
  .size-guide-link:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  /* Buy options */
  .buy-options {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .btn-buy {
    width: 100%;
    padding: 1rem 1.5rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.9rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    transition: all 0.2s;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    touch-action: manipulation;
  }

  .btn-add-cart {
    background: var(--accent);
    color: var(--accent-dark);
    border: 1px solid var(--accent);
  }
  .btn-add-cart:hover {
    background: var(--accent-dim);
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(126, 200, 227, 0.18);
  }
  .btn-add-cart:active {
    transform: translateY(0);
  }

  /* Trust signals */
  .trust {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    padding-top: 0.75rem;
    border-top: 1px solid var(--border);
  }

  .trust-item {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.6rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted-light);
  }

  .trust-item svg {
    color: var(--accent);
    flex-shrink: 0;
  }

  .ticker {
    position: relative;
    border-top: 1px solid var(--border);
    overflow: hidden;
    padding: 0.35rem 0;
    background: var(--surface);
    margin-top: clamp(2rem, 4vw, 3.5rem);
  }

  .ticker-track {
    display: flex;
    white-space: nowrap;
    animation: ticker 28s linear infinite;
    will-change: transform;
  }

  .ticker-track span {
    font-family: var(--font-display);
    font-weight: 700;
    font-style: italic;
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted-light);
    flex-shrink: 0;
    padding: 0 1rem;
  }

  @keyframes ticker {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  /* Size guide modal */
  .size-guide-overlay {
    position: fixed;
    inset: 0;
    z-index: 300;
    background: rgba(0, 0, 0, 0.7);
    backdrop-filter: blur(3px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    opacity: 0;
    transition: opacity 0.2s;
  }

  .size-guide-overlay.open {
    opacity: 1;
  }

  .size-guide-modal {
    position: relative;
    background: var(--surface);
    border: 1px solid var(--border);
    padding: 2rem;
    max-width: 640px;
    width: 100%;
    max-height: 85vh;
    overflow-y: auto;
  }

  .size-guide-modal h3 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.1rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--white);
    margin-bottom: 1.25rem;
  }

  .size-guide-modal img {
    width: 100%;
    height: auto;
    background: #fff;
  }

  .size-guide-close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    color: var(--muted-light);
    padding: 0.25rem;
    transition: color 0.2s;
  }
  .size-guide-close:hover {
    color: var(--white);
  }

  /* ========== RESPONSIVE ========== */
  @media (max-width: 600px) {
    .products {
      padding: 2.5rem var(--pad);
    }

    .product-card {
      max-width: 100%;
    }

    .card-body {
      padding: 1.25rem;
    }

    .trust {
      gap: 0.75rem;
    }

    .trust-item {
      font-size: 0.55rem;
    }
  }
</style>

<script>
  declare global {
    interface Window {
      ISOCart?: {
        add: (item: { id: string; name: string; size: string; price: number; priceDisplay: string; image: string }) => void;
        open: () => void;
      };
    }
  }

  // Size selector — interactive
  document.querySelectorAll('.size-selector').forEach(selector => {
    const btns = selector.querySelectorAll<HTMLButtonElement>('.size-btn');

    btns.forEach(btn => {
      btn.addEventListener('click', () => {
        btns.forEach(b => {
          b.classList.remove('active');
          b.setAttribute('aria-pressed', 'false');
        });
        btn.classList.add('active');
        btn.setAttribute('aria-pressed', 'true');
      });
    });
  });

  // Añadir al carrito
  document.querySelectorAll<HTMLButtonElement>('.btn-add-cart').forEach(btn => {
    btn.addEventListener('click', () => {
      const card = btn.closest<HTMLElement>('.product-card');
      const activeSize = card?.querySelector<HTMLButtonElement>('.size-btn.active');
      const size = activeSize?.dataset.size || 'M';

      const id = btn.dataset.product || '';
      const price = Number(btn.dataset.price || 0);
      const name = btn.dataset.name || 'Producto';
      const priceDisplay = btn.dataset.priceDisplay || '';
      const image = card?.querySelector('img')?.getAttribute('src') || '';

      window.ISOCart?.add({ id, name, size, price, priceDisplay, image });

      // Feedback visual
      const label = btn.querySelector<HTMLElement>('.buy-label');
      if (label) label.textContent = 'Añadido ✓';
      btn.disabled = true;

      setTimeout(() => {
        if (label) label.textContent = 'Añadir al carrito';
        btn.disabled = false;
      }, 1200);

      // Abrir el carrito para confirmar visualmente
      window.ISOCart?.open();
    });
  });

  // Guía de tallas — modal
  const sizeGuideOverlay = document.getElementById('size-guide-overlay');
  const sizeGuideClose = document.getElementById('size-guide-close');

  function openSizeGuide() {
    if (!sizeGuideOverlay) return;
    sizeGuideOverlay.hidden = false;
    requestAnimationFrame(() => sizeGuideOverlay.classList.add('open'));
    document.body.style.overflow = 'hidden';
  }

  function closeSizeGuide() {
    if (!sizeGuideOverlay) return;
    sizeGuideOverlay.classList.remove('open');
    document.body.style.overflow = '';
    setTimeout(() => {
      sizeGuideOverlay.hidden = true;
    }, 200);
  }

  document.querySelectorAll('[data-size-guide-open]').forEach(btn => {
    btn.addEventListener('click', openSizeGuide);
  });
  sizeGuideClose?.addEventListener('click', closeSizeGuide);
  sizeGuideOverlay?.addEventListener('click', (e) => {
    if (e.target === sizeGuideOverlay) closeSizeGuide();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeSizeGuide();
  });
</script>
