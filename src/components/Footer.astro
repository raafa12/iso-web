      </a>
    </div>
    <p class="copyright">© 2026 ISO. Todos los derechos reservados.</p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border);
    background: var(--surface);
  }

  .footer-bottom {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-direction: column;
    gap: 1.25rem;
    padding: clamp(2rem, 4vw, 2.75rem) var(--pad);
  }

  .footer-socials {
    display: flex;
    gap: 1rem;
  }

  .footer-socials a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    border: 1px solid var(--border);
    padding: 0.55rem 0.95rem;
    transition: all 0.2s;
  }

  .footer-socials a svg {
    flex-shrink: 0;
  }
  .footer-socials a:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .copyright {
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    color: var(--muted);
    text-align: center;
  }

  /* ========== RESPONSIVE ========== */
  @media (max-width: 600px) {
    .footer-socials {
      flex-wrap: wrap;
      justify-content: center;
    }
  }
</style>
