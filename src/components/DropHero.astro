---
---

<!-- DROP HERO — Protagonismo total al hero -->
<section class="drop-hero" id="drops">
  <!-- Background grain texture -->
  <div class="bg-grain" aria-hidden="true"></div>

  <!-- Main content -->
  <div class="drop-content">
    <div class="drop-text">
      

      <h1 class="drop-title">
        <span class="outline-text">Call </span><br />
        <span class="outline-text">for an</span><br />
        <img src="/logo-mark.png" alt="ISO" class="drop-title-logo" />
      </h1>

      <p class="drop-desc">
        
      </p>

      <!-- Countdown -->
      <div class="countdown" id="countdown" aria-label="Cuenta atrás del drop">
        <div class="cd-unit">
          <span class="cd-num" id="cd-days">00</span>
          <span class="cd-label">Días</span>
        </div>
        <span class="cd-sep" aria-hidden="true">:</span>
        <div class="cd-unit">
          <span class="cd-num" id="cd-hours">00</span>
          <span class="cd-label">Horas</span>
        </div>
        <span class="cd-sep" aria-hidden="true">:</span>
        <div class="cd-unit">
          <span class="cd-num" id="cd-min">00</span>
          <span class="cd-label">Min</span>
        </div>
        <span class="cd-sep" aria-hidden="true">:</span>
        <div class="cd-unit">
          <span class="cd-num" id="cd-sec">00</span>
          <span class="cd-label">Seg</span>
        </div>
      </div>

      <div class="drop-ctas">
        <a href="#about" class="cta-ghost">¿Qué es ISO?</a>
      </div>
    </div>
  </div>
</section>

<style>
  .drop-hero {
    position: relative;
    /* Fallback for browsers without dvh support */
    min-height: 100vh;
    height: 100vh;
    /* dvh tracks the *current* browser chrome (address bar, toolbars),
       so the section always fills exactly what's visible on mobile —
       100svh alone left a gap that revealed the next section on load. */
    min-height: 100dvh;
    height: 100dvh;
    display: flex;
    flex-direction: column;
    padding-top: calc(var(--nav-h) + 3rem);
    padding-bottom: 3rem;
    overflow: hidden;
    box-sizing: border-box;
    background: var(--bg);
  }

  /* Grain overlay */
  .bg-grain {
    position: absolute;
    inset: 0;
    z-index: 0;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.04'/%3E%3C/svg%3E");
    pointer-events: none;
    opacity: 0.6;
  }


  /* ---- MAIN CONTENT ---- */
  .drop-content {
    position: relative;
    z-index: 1;
    flex: 1;
    display: grid;
    align-items: stretch;
    grid-template-columns: 1fr;
    gap: clamp(0.9rem, 1.5vw, 1.4rem);
    max-width: var(--max-w);
    width: 100%;
    margin: 0 auto;
    padding: 0;
  }

  /* ---- LEFT / TEXT ---- */
  .drop-text {
    padding: clamp(0.7rem, 1.5vw, 1.2rem) var(--pad);
    padding-right: clamp(0.6rem, 1vw, 0.9rem);
    display: flex;
    flex-direction: column;
    justify-content: center;
    flex: 1;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 1.5rem;
  }
  .line {
    display: inline-block;
    width: 2rem;
    height: 1px;
    background: var(--accent);
    flex-shrink: 0;
  }

  .drop-title {
    font-family: var(--font-display);
    font-weight: 900;
    font-style: italic;
    font-size: clamp(4.5rem, 10vw, 9rem);
    line-height: 1;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    margin-bottom: 0.7rem;
  }
  .outline-text {
    color: transparent;
    -webkit-text-stroke: 1.5px var(--white);
  }
  .filled-text {
    color: var(--white);
  }

  .drop-title-logo {
    display: block;
    height: 0.62em;
    width: auto;
    margin-top: 0.32em;
    margin-left: -0.06em;
  }

  .drop-desc {
    font-size: clamp(0.78rem, 1.2vw, 0.92rem);
    font-weight: 300;
    color: var(--muted-light);
    line-height: 1.5;
    max-width: 320px;
    margin-bottom: 0.9rem;
  }

  /* ---- COUNTDOWN ---- */
  .countdown {
    display: flex;
    align-items: flex-end;
    gap: 0.6rem;
    margin-bottom: 0.9rem;
  }

  .cd-unit {
    display: flex;
    flex-direction: column;
    align-items: center;
    background: var(--surface);
    border: 1px solid var(--border-light);
    padding: 0.9rem 1.6rem;
    min-width: 96px;
  }

  .cd-num {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(2.8rem, 6vw, 4rem);
    color: var(--accent);
    letter-spacing: -0.02em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .cd-label {
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted-light);
    margin-top: 0.4rem;
  }

  .cd-sep {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(3rem, 6vw, 5rem);
    color: var(--muted);
    padding-bottom: 0.75rem;
    line-height: 1;
  }

  /* ---- CTAs ---- */
  .drop-ctas {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    flex-wrap: wrap;
  }

  .cta-primary {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.9rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent-dark);
    background: var(--accent);
    padding: 0.8rem 1.6rem;
    transition: background 0.2s, transform 0.15s, box-shadow 0.2s;
    display: inline-block;
    white-space: nowrap;
  }
  .cta-primary:hover {
    background: var(--accent-dim);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(126, 200, 227, 0.2);
  }

  .cta-ghost {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted-light);
    border-bottom: 1px solid var(--muted);
    padding-bottom: 2px;
    transition: color 0.2s, border-color 0.2s;
    white-space: nowrap;
  }
  .cta-ghost:hover { color: var(--accent); border-color: var(--accent); }

  /* ========== RESPONSIVE ========== */
  @media (max-width: 900px) {
    .drop-content {
      grid-template-columns: 1fr;
    }

    .drop-text {
      border-right: none;
      border-bottom: 1px solid var(--border);
      padding: 3rem var(--pad) 2.5rem;
    }

    .countdown {
      gap: 0.4rem;
    }

    .cd-unit {
      min-width: 60px;
      padding: 0.6rem 0.9rem;
    }
  }

  @media (max-width: 480px) {
    .drop-title {
      font-size: clamp(3.5rem, 16vw, 6rem);
    }

    .countdown {
      gap: 0.25rem;
    }

    .cd-unit {
      min-width: 0;
      flex: 1;
      padding: 0.5rem 0.4rem;
    }

    .cd-num {
      font-size: clamp(1.4rem, 7vw, 2rem);
    }

    .cd-label {
      font-size: 0.55rem;
      letter-spacing: 0.06em;
    }

    .cd-sep {
      font-size: clamp(1.4rem, 7vw, 2rem);
      padding-bottom: 0.4rem;
    }

    .drop-ctas {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }

    .cta-primary {
      width: 100%;
      text-align: center;
    }
  }
</style>

<script>
  // Countdown timer — hasta el 1 de agosto
  function startCountdown() {
    const countdown = document.getElementById('countdown');
    if (!countdown) return;

    const end = new Date();
    const year = end.getMonth() <= 6 ? end.getFullYear() : end.getFullYear() + 1;
    end.setFullYear(year, 7, 1, 0, 0, 0, 0);

    const daysEl = document.getElementById('cd-days');
    const hoursEl = document.getElementById('cd-hours');
    const minEl = document.getElementById('cd-min');
    const secEl = document.getElementById('cd-sec');

    function update() {
      const now = new Date();
      const diff = Math.max(0, end.getTime() - now.getTime());

      const totalSeconds = Math.floor(diff / 1000);
      const d = Math.floor(totalSeconds / 86400);
      const h = Math.floor(totalSeconds / 3600) % 24;
      const m = Math.floor(totalSeconds / 60) % 60;
      const s = totalSeconds % 60;

      const pad = (n) => String(n).padStart(2, '0');

      if (daysEl) daysEl.textContent = pad(d);
      if (hoursEl) hoursEl.textContent = pad(h);
      if (minEl) minEl.textContent = pad(m);
      if (secEl) secEl.textContent = pad(s);
    }

    update();
    setInterval(update, 1000);
  }

  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    startCountdown();
  } else {
    document.addEventListener('DOMContentLoaded', startCountdown);
  }
</script>
