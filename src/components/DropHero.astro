---
const drop = {
  id: "drop-002",
  name: "Próximo Drop",
  tag: "Pronto",
  sizes: ["S","M","L","XL"],
};
---

<!-- DROP HERO — Protagonismo total al drop -->
<section class="drop-hero" id="drops">
  <!-- Background grain texture -->
  <div class="bg-grain" aria-hidden="true"></div>

  <!-- Top eyebrow bar -->
  <div class="drop-bar">
    <span class="bar-pill">LIVE</span>
    <span class="bar-text">Drop 001 —</span>
    <span class="bar-units">Solo 100 unidades</span>
  </div>

  <!-- Main content -->
  <div class="drop-content">
    <div class="drop-text">
      

      <h1 class="drop-title">
        <span class="outline-text">Call </span><br />
        <span class="outline-text">for an</span><br />
        <span class="filled-text">ISO.</span>
      </h1>

      <p class="drop-desc">
        
      </p>

      <!-- Countdown -->
      <div class="countdown" id="countdown" aria-label="Cuenta atrás del drop">
        <div class="cd-unit">
          <span class="cd-num" id="cd-days">00</span>
          <span class="cd-label">Días</span>
        </div>
        <span class="cd-sep" aria-hidden="true">:</span>
        <div class="cd-unit">
          <span class="cd-num" id="cd-hours">00</span>
          <span class="cd-label">Horas</span>
        </div>
        <span class="cd-sep" aria-hidden="true">:</span>
        <div class="cd-unit">
          <span class="cd-num" id="cd-min">00</span>
          <span class="cd-label">Min</span>
        </div>
        <span class="cd-sep" aria-hidden="true">:</span>
        <div class="cd-unit">
          <span class="cd-num" id="cd-sec">00</span>
          <span class="cd-label">Seg</span>
        </div>
      </div>

      <div class="drop-ctas">
        <a href="#about" class="cta-ghost">¿Qué es ISO?</a>
      </div>
    </div>

    <!-- Product image panel -->
    <div class="drop-upcoming products" id="collection">
      <div class="section-head">
        <div class="head-left">
          <p class="eyebrow">
            <span class="line" aria-hidden="true"></span>
            Drop 001
          </p>
          <h2 class="section-title">Próximamente</h2>
        </div>
      </div>

      <div class="products-grid">
        <article class="product-card mystery">
          <!-- Image — oculta con signo de interrogación -->
          <div class="card-image">
            <div class="mystery-cover">
              <span class="mystery-q" aria-hidden="true">?</span>
              <span class="mystery-label">Próximo drop</span>
            </div>
            <span class="card-tag">{drop.tag}</span>
          </div>

          <!-- Info -->
          <div class="card-body">
            <div class="card-header">
              <div>
                <p class="card-cat">Drop 002</p>
                <h3 class="card-name">???</h3>
              </div>
              <span class="card-price">???</span>
            </div>

            <!-- Size selector desactivado -->
            <div class="size-selector" role="group" aria-label="Tallas próximamente">
              <p class="size-label">Talla</p>
              <div class="sizes">
                {drop.sizes.map(s => (
                  <span class="size-btn locked" aria-disabled="true">{s}</span>
                ))}
              </div>
            </div>

            <!-- Notificación de aviso -->
            <div class="notify-block">
              <p class="notify-text">Avísame cuando salga</p>
              <div class="notify-form">
                <label for="notify-email" class="sr-only">Tu email</label>
                <input
                  type="email"
                  id="notify-email"
                  placeholder="tu@email.com"
                  autocomplete="email"
                />
                <button type="button" id="notify-btn">→</button>
              </div>
              <p class="notify-feedback" id="notify-feedback" aria-live="polite"></p>
            </div>

          </div>
        </article>
      </div>
    </div>
  </div>

</section>

<div class="ticker" aria-hidden="true">
  <div class="ticker-track">
    {Array(12).fill(null).map(() => (
      <span>ISO Drop 001 — Edición Limitada — 100 Unidades — </span>
    ))}
  </div>
</div>

<style>
  .drop-hero {
    position: relative;
    min-height: 35svh;
    display: flex;
    flex-direction: column;
    padding-top: calc(var(--nav-h) + 3rem);
    overflow: visible;
    background: var(--bg);
  }

  /* Grain overlay */
  .bg-grain {
    position: absolute;
    inset: 0;
    z-index: 0;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.04'/%3E%3C/svg%3E");
    pointer-events: none;
    opacity: 0.6;
  }

  /* ---- DROP BAR ---- */
  .drop-bar {
    position: fixed;
    top: var(--nav-h);
    left: 0;
    right: 0;
    z-index: 150;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.35rem var(--pad);
    border-bottom: 1px solid var(--border);
    background: var(--surface);
    flex-wrap: wrap;
    row-gap: 0.16rem;
  }

  .bar-pill {
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--bg);
    background: var(--accent);
    padding: 0.2rem 0.55rem;
    animation: pulse-pill 2s ease-in-out infinite;
  }

  @keyframes pulse-pill {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.7; }
  }

  .bar-text {
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--white-dim);
    flex: 1;
  }

  .bar-units {
    font-size: 0.62rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }

  /* ---- MAIN CONTENT ---- */
  .drop-content {
    position: relative;
    z-index: 1;
    flex: 1;
    display: grid;
    align-items: stretch;
    grid-template-columns: minmax(260px, 0.9fr) minmax(320px, 1.1fr);
    gap: clamp(0.9rem, 1.5vw, 1.4rem);
    max-width: var(--max-w);
    width: 100%;
    margin: 0 auto;
    padding: 0;
  }

  /* ---- LEFT / TEXT ---- */
  .drop-text {
    padding: clamp(0.7rem, 1.5vw, 1.2rem) var(--pad);
    padding-right: clamp(0.6rem, 1vw, 0.9rem);
    display: flex;
    flex-direction: column;
    justify-content: center;
    border-right: 1px solid var(--border);
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 1.5rem;
  }
  .line {
    display: inline-block;
    width: 2rem;
    height: 1px;
    background: var(--accent);
    flex-shrink: 0;
  }

  .drop-title {
    font-family: var(--font-display);
    font-weight: 900;
    font-style: italic;
    font-size: clamp(3.5rem, 7.5vw, 7rem);
    line-height: 1;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    margin-bottom: 0.7rem;
  }
  .outline-text {
    color: transparent;
    -webkit-text-stroke: 1.5px var(--white);
  }
  .filled-text {
    color: var(--white);
  }

  .drop-desc {
    font-size: clamp(0.78rem, 1.2vw, 0.92rem);
    font-weight: 300;
    color: var(--muted-light);
    line-height: 1.5;
    max-width: 320px;
    margin-bottom: 0.9rem;
  }

  /* ---- COUNTDOWN ---- */
  .countdown {
    display: flex;
    align-items: flex-end;
    gap: 0.3rem;
    margin-bottom: 0.9rem;
  }

  .cd-unit {
    display: flex;
    flex-direction: column;
    align-items: center;
    background: var(--surface);
    border: 1px solid var(--border-light);
    padding: 0.45rem 0.9rem;
    min-width: 52px;
  }

  .cd-num {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(1.4rem, 3vw, 2rem);
    color: var(--accent);
    letter-spacing: -0.02em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .cd-label {
    font-size: 0.55rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted-light);
    margin-top: 0.25rem;
  }

  .cd-sep {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 2rem;
    color: var(--muted);
    padding-bottom: 0.75rem;
    line-height: 1;
  }

  /* ---- CTAs ---- */
  .drop-ctas {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    flex-wrap: wrap;
  }

  .cta-primary {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.9rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent-dark);
    background: var(--accent);
    padding: 0.8rem 1.6rem;
    transition: background 0.2s, transform 0.15s, box-shadow 0.2s;
    display: inline-block;
    white-space: nowrap;
  }
  .cta-primary:hover {
    background: var(--accent-dim);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(126, 200, 227, 0.2);
  }

  .cta-ghost {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted-light);
    border-bottom: 1px solid var(--muted);
    padding-bottom: 2px;
    transition: color 0.2s, border-color 0.2s;
    white-space: nowrap;
  }
  .cta-ghost:hover { color: var(--accent); border-color: var(--accent); }

  /* ---- RIGHT / PRODUCT ---- */
  .drop-upcoming {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(0.8rem, 1.5vw, 1.2rem) var(--pad);
    background: var(--surface);
    border-left: 1px solid var(--border);
  }

  .product-frame {
    position: relative;
    width: 100%;
    max-width: 360px;
    border: 1px solid var(--border-light);
    background: var(--bg);
    overflow: visible;
  }

  .product-img-wrap {
    position: relative;
    aspect-ratio: 3/4;
    overflow: hidden;
    background: var(--surface2);
  }

  .product-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 1.5rem;
    transition: transform 0.5s ease;
  }
  .product-frame:hover .product-img {
    transform: scale(1.04);
  }

  .product-placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    pointer-events: none;
  }

  .ph-logo {
    font-family: var(--font-display);
    font-weight: 900;
    font-style: italic;
    font-size: 4rem;
    color: var(--surface3);
    letter-spacing: -0.02em;
  }

  .ph-label {
    font-size: 0.6rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .product-tag {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.9rem 1.1rem;
    border-top: 1px solid var(--border);
    background: var(--surface);
  }

  .tag-left {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .tag-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--white);
  }

  .tag-ref {
    font-size: 0.58rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted-light);
  }

  .tag-price {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 1.4rem;
    color: var(--accent);
    letter-spacing: -0.02em;
  }

  .stock-badge {
    position: absolute;
    top: 1rem;
    left: 1rem;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--bg);
    background: var(--accent);
    padding: 0.3rem 0.7rem;
  }

  .stock-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--bg);
    flex-shrink: 0;
    animation: dot-pulse 1.5s ease-in-out infinite;
  }

  @keyframes dot-pulse {
    0%, 100% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.4); opacity: 0.6; }
  }

  /* Floating stats */
  .float-stat {
    position: absolute;
    background: var(--bg);
    border: 1px solid var(--border-light);
    padding: 0.75rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    pointer-events: none;
  }

  .stat-n {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 1.5rem;
    color: var(--accent);
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .stat-l {
    font-size: 0.55rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted-light);
  }

  .stat-1 {
    bottom: 5rem;
    left: -3.5rem;
  }

  .stat-2 {
    top: 4rem;
    right: -3.5rem;
  }

  /* ---- TICKER ---- */
  .ticker {
    position: relative;
    z-index: 1;
    border-top: 1px solid var(--border);
    overflow: hidden;
    padding: 0.35rem 0;
    background: var(--surface);
    flex-shrink: 0;
  }

  .ticker-track {
    display: flex;
    white-space: nowrap;
    animation: ticker 28s linear infinite;
    will-change: transform;
  }

  .ticker-track span {
    font-family: var(--font-display);
    font-weight: 700;
    font-style: italic;
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted-light);
    flex-shrink: 0;
    padding: 0 1rem;
  }

  @keyframes ticker {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  .products {
    padding: clamp(3rem, 6vw, 6rem) var(--pad);
    border-top: 1px solid var(--border);
  }

  .drop-upcoming.products {
    padding: clamp(0.8rem, 1.5vw, 1.2rem) var(--pad);
    border-top: none;
  }

  .section-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: clamp(1rem, 2vw, 1.5rem);
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .head-left {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.3rem;
  }

  .line {
    display: inline-block;
    width: 1.75rem;
    height: 1px;
    background: var(--accent);
  }

  .section-title {
    font-family: var(--font-display);
    font-weight: 900;
    font-style: italic;
    font-size: clamp(1.8rem, 3vw, 2.6rem);
    text-transform: uppercase;
    color: var(--white);
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .head-note {
    font-size: 0.62rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted-light);
    border: 1px solid var(--border-light);
    padding: 0.3rem 0.65rem;
    align-self: flex-end;
  }

  .products-grid {
    display: flex;
    justify-content: center;
  }

  .product-card {
    width: 100%;
    max-width: 360px;
    background: var(--surface);
    border: 1px solid var(--border);
  }

  .card-image {
    position: relative;
    aspect-ratio: 4/5;
    background: var(--bg);
    overflow: hidden;
  }

  .card-tag {
    position: absolute;
    top: 1rem;
    left: 1rem;
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--bg);
    background: var(--accent);
    padding: 0.28rem 0.6rem;
    z-index: 2;
    animation: tag-pulse 2.5s ease-in-out infinite;
  }

  @keyframes tag-pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.6; }
  }

  .mystery-cover {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    background: var(--surface);
    background-image:
      linear-gradient(var(--border) 1px, transparent 1px),
      linear-gradient(90deg, var(--border) 1px, transparent 1px);
    background-size: 48px 48px;
  }

  .mystery-q {
    font-family: var(--font-display);
    font-weight: 900;
    font-style: italic;
    font-size: clamp(6rem, 18vw, 12rem);
    color: transparent;
    -webkit-text-stroke: 2px var(--border-light);
    line-height: 1;
    animation: mystery-flicker 4s ease-in-out infinite;
    user-select: none;
  }

  .mystery-label {
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .card-body {
    padding: 0.9rem;
    border-top: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
  }

  .card-cat {
    font-size: 0.58rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 0.2rem;
  }

  .card-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.25rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--muted-light);
    line-height: 1;
  }

  .card-price {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 1.75rem;
    color: var(--muted-light);
    letter-spacing: 0.1em;
    flex-shrink: 0;
  }

  .size-selector {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .size-label {
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted-light);
  }

  .sizes {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .size-btn {
    width: 34px;
    height: 34px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border: 1px solid var(--border);
  }

  .size-btn.locked {
    color: var(--muted);
    cursor: not-allowed;
    opacity: 0.4;
    user-select: none;
  }

  .notify-block {
    background: var(--surface2);
    border: 1px solid var(--border-light);
    padding: 0.85rem;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .notify-text {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--white-dim);
  }

  .notify-form {
    display: flex;
    border: 1px solid var(--border);
    overflow: hidden;
  }

  .notify-form input {
    flex: 1;
    min-width: 0;
    background: transparent;
    border: none;
    outline: none;
    padding: 0.75rem 1rem;
    font-family: var(--font-body);
    font-size: 0.82rem;
    color: var(--white);
  }

  .notify-form input::placeholder { color: var(--muted); }

  .notify-form button {
    background: var(--accent);
    color: var(--bg);
    border: none;
    padding: 0.75rem 1.1rem;
    font-size: 1rem;
    font-weight: 700;
    transition: background 0.2s;
    flex-shrink: 0;
  }

  .notify-form button:hover { background: var(--accent-dim); }

  .notify-feedback {
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    color: var(--accent);
    min-height: 1em;
  }

  .trust {
    display: flex;
    gap: 1.25rem;
    flex-wrap: wrap;
    padding-top: 0.75rem;
    border-top: 1px solid var(--border);
  }

  .trust-item {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.6rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted-light);
  }

  .trust-item svg {
    color: var(--accent);
    flex-shrink: 0;
  }

  /* ========== RESPONSIVE ========== */
  @media (max-width: 900px) {
    .drop-content {
      grid-template-columns: 1fr;
    }

    .drop-text {
      border-right: none;
      border-bottom: 1px solid var(--border);
      padding: 3rem var(--pad) 2.5rem;
    }

    .drop-upcoming {
      padding: 2.5rem var(--pad);
      background: var(--surface);
      border-left: none;
      border-top: 1px solid var(--border);
    }

    .product-frame {
      max-width: 280px;
    }

    .float-stat {
      display: none;
    }

    .countdown {
      gap: 0.4rem;
    }

    .cd-unit {
      min-width: 60px;
      padding: 0.6rem 0.9rem;
    }
  }

  @media (max-width: 480px) {
    .drop-title {
      font-size: clamp(4.5rem, 20vw, 7.5rem);
    }

    .product-frame {
      max-width: 240px;
    }

    .drop-ctas {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }

    .cta-primary {
      width: 100%;
      text-align: center;
    }
  }
</style>

<script>
  // Countdown timer — hasta el 1 de agosto
  function startCountdown() {
    const countdown = document.getElementById('countdown');
    if (!countdown) return;

    const end = new Date();
    const year = end.getMonth() <= 6 ? end.getFullYear() : end.getFullYear() + 1;
    end.setFullYear(year, 7, 1, 0, 0, 0, 0);

    const daysEl = document.getElementById('cd-days');
    const hoursEl = document.getElementById('cd-hours');
    const minEl = document.getElementById('cd-min');
    const secEl = document.getElementById('cd-sec');

    function update() {
      const now = new Date();
      const diff = Math.max(0, end.getTime() - now.getTime());

      const totalSeconds = Math.floor(diff / 1000);
      const d = Math.floor(totalSeconds / 86400);
      const h = Math.floor(totalSeconds / 3600) % 24;
      const m = Math.floor(totalSeconds / 60) % 60;
      const s = totalSeconds % 60;

      const pad = (n) => String(n).padStart(2, '0');

      if (daysEl) daysEl.textContent = pad(d);
      if (hoursEl) hoursEl.textContent = pad(h);
      if (minEl) minEl.textContent = pad(m);
      if (secEl) secEl.textContent = pad(s);
    }

    update();
    setInterval(update, 1000);
  }

  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    startCountdown();
  } else {
    document.addEventListener('DOMContentLoaded', startCountdown);
  }
</script>
