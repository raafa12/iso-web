---
---

<!-- DROP HERO — Protagonismo total al hero -->
<section class="drop-hero" id="drops">
  <!-- Background grain texture -->
  <div class="bg-grain" aria-hidden="true"></div>

  <!-- Main content -->
  <div class="drop-content">
    <div class="drop-text">
      <h1 class="drop-title">
        <span class="outline-text">Call </span><br />
        <span class="outline-text">for an</span><br />
        <img src="/logocami-nav.png" alt="ISO" class="drop-title-logo" />
      </h1>

      <div class="drop-ctas">
        <a href="/collection" class="cta-primary">Ver colección →</a>
      </div>
    </div>
  </div>
</section>

<style>
  .drop-hero {
    position: relative;
    /* Fallback for browsers without dvh support */
    min-height: 100vh;
    height: 100vh;
    /* dvh tracks the *current* browser chrome (address bar, toolbars),
       so the section always fills exactly what's visible on mobile —
       100svh alone left a gap that revealed the next section on load. */
    min-height: 100dvh;
    height: 100dvh;
    display: flex;
    flex-direction: column;
    padding-top: var(--nav-h);
    padding-bottom: 0;
    overflow: hidden;
    box-sizing: border-box;
    background: var(--bg);
  }

  /* Grain overlay */
  .bg-grain {
    position: absolute;
    inset: 0;
    z-index: 0;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.04'/%3E%3C/svg%3E");
    pointer-events: none;
    opacity: 0.6;
  }


  /* ---- MAIN CONTENT ---- */
  .drop-content {
    position: relative;
    z-index: 1;
    flex: 1;
    display: grid;
    align-items: stretch;
    grid-template-columns: 1fr;
    gap: clamp(0.9rem, 1.5vw, 1.4rem);
    max-width: var(--max-w);
    width: 100%;
    margin: 0 auto;
    padding: 2rem 0;
    box-sizing: border-box;
  }

  /* ---- LEFT / TEXT ---- */
  .drop-text {
    padding: clamp(0.7rem, 1.5vw, 1.2rem) var(--pad);
    padding-right: clamp(0.6rem, 1vw, 0.9rem);
    display: flex;
    flex-direction: column;
    justify-content: center;
    flex: 1;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 1.5rem;
  }
  .line {
    display: inline-block;
    width: 2rem;
    height: 1px;
    background: var(--accent);
    flex-shrink: 0;
  }

  .drop-title {
    font-family: var(--font-display);
    font-weight: 900;
    font-style: italic;
    font-size: clamp(4.5rem, 10vw, 9rem);
    line-height: 1;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    margin-bottom: 0.7rem;
  }
  .outline-text {
    color: transparent;
    -webkit-text-stroke: 1.5px var(--white);
  }
  .filled-text {
    color: var(--white);
  }

  .drop-title-logo {
    display: block;
    height: 0.62em;
    width: auto;
    margin-top: 0.32em;
    margin-left: -0.06em;
  }

  .drop-desc {
    font-size: clamp(0.78rem, 1.2vw, 0.92rem);
    font-weight: 300;
    color: var(--muted-light);
    line-height: 1.5;
    max-width: 320px;
    margin-bottom: 0.9rem;
  }

  /* ---- CTAs ---- */
  .drop-ctas {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
    margin-top: 1.2rem;
  }

  .cta-primary {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.9rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent-dark);
    background: var(--accent);
    padding: 0.8rem 1.6rem;
    transition: background 0.2s, transform 0.15s, box-shadow 0.2s;
    display: inline-block;
    white-space: nowrap;
  }
  .cta-primary:hover {
    background: var(--accent-dim);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(126, 200, 227, 0.2);
  }

  .cta-ghost {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted-light);
    border-bottom: 1px solid var(--muted);
    padding-bottom: 2px;
    transition: color 0.2s, border-color 0.2s;
    white-space: nowrap;
  }
  .cta-ghost:hover { color: var(--accent); border-color: var(--accent); }

  /* ========== RESPONSIVE ========== */
  @media (max-width: 900px) {
    .drop-content {
      grid-template-columns: 1fr;
    }

    .drop-text {
      border-right: none;
      padding: 2.5rem var(--pad);
    }
  }

  @media (max-width: 480px) {
    .drop-title {
      font-size: clamp(3.5rem, 16vw, 6rem);
    }

    .drop-ctas {
      flex-direction: column;
      align-items: stretch;
      gap: 1rem;
    }

    .cta-primary {
      width: 100%;
      text-align: center;
    }

    .cta-ghost {
      white-space: normal;
      text-align: center;
      border-bottom: none;
      text-decoration: underline;
      text-underline-offset: 3px;
    }
  }
</style>